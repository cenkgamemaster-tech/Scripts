	farmLocationStayActive = true
	setWorldFarmStatus(("Going to farm location (%ds stay)..."):format(staySec))
	if not setCharacterAtPosition(pos, true, 0) then
		setWorldFarmStatus("Farm location teleport failed")
		local ok = farmWait(FARM_NO_TARGET_WAIT_SEC, runId, "world")
		farmLocationStayActive = false
		return ok
	end
	if not farmWait(WORLD_TELEPORT_SETTLE_SEC, runId, "world") then
		farmLocationStayActive = false
		return false
	end

	for sec = staySec, 1, -1 do
		if not shouldFarmContinue(runId, "world") then
			farmLocationStayActive = false
			return false
		end
		setWorldFarmStatus(("Farm location (%s left) – waiting before worlds"):format(formatFarmStayTimeLeft(sec)))
		if sec == staySec or sec % FARM_LOCATION_HOLD_INTERVAL == 0 then
			setCharacterAtPosition(pos, true, 0)
		end
		if not farmWait(1, runId, "world") then
			farmLocationStayActive = false
			return false
		end
	end

	farmLocationStayActive = false
	setWorldFarmStatus("Farm location stay complete – starting world cycle")
	return true
end

