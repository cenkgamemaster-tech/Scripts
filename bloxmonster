		tpBtn.Parent = row

		local tpCorner = Instance.new("UICorner")
		tpCorner.CornerRadius = UDim.new(0, 4)
		tpCorner.Parent = tpBtn

		local modelRef = pet.model
		tpBtn.MouseButton1Click:Connect(function()
			if modelRef and modelRef.Parent then
				teleportToPet(modelRef)
			end
		end)
	end
end

refreshList = function(rescan)
	if rescan == false and #lastAllPets > 0 then
		local filtered = applyNameFilters(lastAllPets)
		populateList(filtered, #lastAllPets)
		return
	end
	local ok, pets = pcall(getWorldPets)
	if ok then
		lastAllPets = pets
		local filtered = applyNameFilters(pets)
		populateList(filtered, #pets)
	else
		lastAllPets = {}
		populateList({}, 0)
		warn("[BloxMonster] Scan error:", pets)
	end
end

local function stopAutoFarm()
	autoFarmRunning = false
	farmStatusLabel.Text = "Farm idle"
	farmStartBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 55)
end

local function startAutoFarm()
	if autoFarmRunning then
		return
	end
	if #nameFilters == 0 then
		farmStatusLabel.Text = "Add pets first (e.g. Orbitfin@1)"
		return
	end
	autoFarmRunning = true
	farmStartBtn.BackgroundColor3 = Color3.fromRGB(60, 140, 70)
	farmStatusLabel.Text = "Farm starting..."
	if autoFarmThread then
		task.cancel(autoFarmThread)
	end
	autoFarmThread = task.spawn(function()
		local lastFarmPriority = 0
		while autoFarmRunning do
			local pets = scanWorldPets()
			populateList(applyNameFilters(pets), #pets)

			local targets = applyNameFilters(pets)
			local target, targetP = pickNextFarmTarget(targets, lastFarmPriority)
			if not target then
				lastFarmPriority = 0
				farmStatusLabel.Text = "Waiting for pets..."
				task.wait(FARM_NO_TARGET_WAIT_SEC)
			else
				local model = target.model
				local prio = targetP or getPetFilterPriority(target.name)
				farmStatusLabel.Text = ("TP P%s: %s"):format(tostring(prio), target.name)
				teleportToPet(model)

				for sec = FARM_WAIT_SEC, 1, -1 do
					if not autoFarmRunning then
						break
					end
					farmStatusLabel.Text = ("P%s: %s – %ds"):format(tostring(prio), target.name, sec)
					task.wait(1)
				end

				lastFarmPriority = prio
				farmStatusLabel.Text = "Refreshing list..."
				pets = scanWorldPets()
				populateList(applyNameFilters(pets), #pets)
			end
		end
	end)
end

