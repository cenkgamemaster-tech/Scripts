local function runFarmLocationPhase(runId)
	if not farmLocationEnabled then
		return true
	end
	local pos = getFarmLocationPosition()
	if not pos then
		setFarmStatus("Farm location not set – skipping")
		return true
	end

	setFarmStatus("Going to farm location...")
	if not setCharacterAtPosition(pos, true, 0) then
		setFarmStatus("Farm location teleport failed")
		return farmWait(FARM_NO_TARGET_WAIT_SEC, runId)
	end
	if not farmWait(WORLD_TELEPORT_SETTLE_SEC, runId) then
		return false
	end

	local endTime = nowSeconds() + getFarmStaySec()
	while shouldFarmContinue(runId) and nowSeconds() < endTime do
		local left = math.ceil(endTime - nowSeconds())
		setFarmStatus(("Farm location (%s left)"):format(formatFarmStayTimeLeft(left)))
		if not farmWait(1, runId) then
			return false
		end
	end
	return shouldFarmContinue(runId)
end

