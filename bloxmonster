-- Optional: limit scan to this path (e.g. "Workspace.Map"). nil = entire Workspace.
local WORKSPACE_PREFIX = nil

-- Attribute names that suggest a model is a wild pet / monster.
local PET_ATTR_KEYS = {
	"PetId", "PetName", "MonsterName", "Monster", "MonsterId", "NpcId", "NPCId",
	"Rarity", "Tier", "Mutation", "Shiny", "Level", "Wild", "IsWild", "Catchable",
}

-- BillboardGui label names to read for display.
local BILLBOARD_LABELS = { "Name", "PetName", "MonsterName", "Rarity", "Tier", "Level", "Mutation", "Shiny" }

local RARITY_ORDER = {
	Secret = 1, Mythic = 2, Legendary = 3, Epic = 4, Rare = 5,
	Uncommon = 6, Common = 7, A = 8, B = 9, C = 10, D = 11, S = 12,
}

local function getScanRoot()
	if not WORKSPACE_PREFIX or WORKSPACE_PREFIX == "" then
		return Workspace
	end
	local node = Workspace
	for part in string.gmatch(WORKSPACE_PREFIX, "[^.]+") do
		if part ~= "Workspace" then
			local nextNode = node and node:FindFirstChild(part)
			if not nextNode then
				break
			end
			node = nextNode
		end
	end
	return node or Workspace
end

local function isUnderPath(inst, prefix)
	if not prefix or prefix == "" then
		return true
	end
	local ok, fullName = pcall(function() return inst:GetFullName() end)
	if not ok or not fullName then
		return false
	end
	return fullName == prefix or string.sub(fullName, 1, #prefix + 1) == prefix .. "."
end

local function isPlayerCharacter(model)
	if not model or model.ClassName ~= "Model" then
		return false
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character == model then
			return true
		end
	end
	return false
end

local function isEquippedPet(model)
	local ok, fullName = pcall(function() return model:GetFullName() end)
	if not ok or not fullName then
		return false
	end
	if fullName:find("Players%.", 1, true) then
		return true
	end
	local lower = fullName:lower()
	if lower:find("equipped") or lower:find("follower") or lower:find("followpet")
		or lower:find("playerpet") or lower:find("mypet") or lower:find("backpack") then
		return true
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if lower:find(plr.Name:lower(), 1, true) and lower:find("pet", 1, true) then
			return true
		end
	end
	return false
end

local function getAttr(inst, key)
	if not inst or not inst.GetAttribute then
		return nil
	end
	local ok, val = pcall(function() return inst:GetAttribute(key) end)
	return ok and val or nil
end

local function getFirstMatchingAttr(inst, keys)
	for _, key in ipairs(keys) do
		local val = getAttr(inst, key)
		if val ~= nil and tostring(val) ~= "" then
			return tostring(val), key
		end
	end
	if inst.GetDescendants then
		for _, desc in ipairs(inst:GetDescendants()) do
			for _, key in ipairs(keys) do
				local val = getAttr(desc, key)
				if val ~= nil and tostring(val) ~= "" then
					return tostring(val), key .. "@" .. (desc.Name or "?")
				end
			end
		end
	end
	return nil, nil
end

local function getBillboardLabel(model, labelName)
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BillboardGui") then
			local lbl = desc:FindFirstChild(labelName, true)
			if lbl and (lbl:IsA("TextLabel") or lbl:IsA("TextButton")) and lbl.Text and lbl.Text ~= "" then
				return lbl.Text
			end
		end
	end
	return nil
end

local function getBillboardInfo(model)
	local info = {}
	for _, labelName in ipairs(BILLBOARD_LABELS) do
		local text = getBillboardLabel(model, labelName)
		if text then
			info[labelName] = text
		end
	end
	return info
end

local function hasBillboardGui(model)
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BillboardGui") then
			return true
		end
	end
	return false
end

local function hasCatchPrompt(model)
	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("ProximityPrompt") then
			local action = (desc.ActionText or ""):lower()
			local obj = (desc.ObjectText or ""):lower()
			if action:find("catch", 1, true) or action:find("battle", 1, true)
				or action:find("fight", 1, true) or obj:find("catch", 1, true) then
				return true
			end
		end
	end
	return false
end

local function countPetSignals(model)
	local score = 0
	if model:FindFirstChildOfClass("Humanoid") then
		score = score + 1
	end
	if hasBillboardGui(model) then
		score = score + 2
	end
	if hasCatchPrompt(model) then
		score = score + 2
	end
	for _, key in ipairs(PET_ATTR_KEYS) do
		if getAttr(model, key) ~= nil then
			score = score + 1
			break
		end
	end
	return score
end

local function looksLikeWildPet(model)
	if not model or model.ClassName ~= "Model" then
		return false
	end
	if isPlayerCharacter(model) or isEquippedPet(model) then
		return false
	end
	if not isUnderPath(model, WORKSPACE_PREFIX) then
		return false
	end
	return countPetSignals(model) >= 2
end

local function getModelPosition(model)
	local ok, pivot = pcall(function() return model:GetPivot() end)
	if ok and pivot then
		return pivot.Position
	end
	if model.PrimaryPart then
		return model.PrimaryPart.Position
	end
	local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso")
	if hrp then
		return hrp.Position
	end
	return nil
end

local function getDistanceToPlayer(model)
	local char = LocalPlayer.Character
	if not char then
		return nil
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	local pos = getModelPosition(model)
	if not root or not pos then
		return nil
	end
	return (root.Position - pos).Magnitude
end

local function buildPetEntry(model)
	local bb = getBillboardInfo(model)
	local petName = bb.PetName or bb.MonsterName or bb.Name
		or select(1, getFirstMatchingAttr(model, { "PetName", "MonsterName", "Monster", "Name" }))
		or model.Name

	local rarity = bb.Rarity or select(1, getFirstMatchingAttr(model, { "Rarity", "Tier" }))
	local tier = bb.Tier or getAttr(model, "Tier")
	local level = bb.Level or getAttr(model, "Level")
	local mutation = bb.Mutation or getAttr(model, "Mutation")
	local shiny = bb.Shiny or getAttr(model, "Shiny")

	local rarityKey = rarity and tostring(rarity):gsub("^%s+", ""):gsub("%s+$", "") or ""
	local sortKey = RARITY_ORDER[rarityKey] or RARITY_ORDER[tostring(tier or "")] or 99

	return {
		model = model,
		name = tostring(petName),
		rarity = rarity and tostring(rarity) or "—",
		tier = tier and tostring(tier) or "—",
		level = level and tostring(level) or "—",
		mutation = mutation and tostring(mutation) or "—",
		shiny = shiny and tostring(shiny) or "—",
		distance = getDistanceToPlayer(model),
		path = (function()
			local okPath, fullName = pcall(function() return model:GetFullName() end)
			return (okPath and fullName) or model.Name
		end)(),
		sortKey = sortKey,
	}
end

local function getWorldPets()
	local root = getScanRoot()
	local found = {}
	local seen = {}

	local function consider(model)
		if seen[model] then
			return
		end
		if not looksLikeWildPet(model) then
			return
		end
		seen[model] = true
		local ok, entry = pcall(buildPetEntry, model)
		if ok and entry then
			table.insert(found, entry)
		end
	end

	if root then
		for _, desc in ipairs(root:GetDescendants()) do
			if desc.ClassName == "Model" then
				consider(desc)
			end
		end
	end

	table.sort(found, function(a, b)
		if a.sortKey ~= b.sortKey then
			return a.sortKey < b.sortKey
		end
		local da, db = a.distance or math.huge, b.distance or math.huge
		if da ~= db then
			return da < db
		end
		return a.name < b.name
	end)

	return found
end

-- Pet filters: { name = string, priority = number } (1 = highest teleport priority).
local nameFilters = {}
local autoFarmRunning = false
local lastAllPets = {}
local scanWorldPets

local function normalizeFilterName(text)
	return tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local FULLWIDTH_DIGITS = {
	["０"] = "0", ["１"] = "1", ["２"] = "2", ["３"] = "3", ["４"] = "4",
	["５"] = "5", ["６"] = "6", ["７"] = "7", ["８"] = "8", ["９"] = "9",
}

local function normalizeFilterRaw(text)
	text = tostring(text or "")
	text = text:gsub("\r", ""):gsub("\n", ",")
	text = text:gsub("＠", "@"):gsub("，", ","):gsub("；", ";")
	for fw, digit in pairs(FULLWIDTH_DIGITS) do
		text = text:gsub(fw, digit)
	end
	return text
end

local function splitFilterParts(raw)
	raw = normalizeFilterRaw(raw)
	local parts = {}
	for part in string.gmatch(raw, "[^,;]+") do
		table.insert(parts, part)
	end
	return parts
end

local function getFilterName(entry)
	if type(entry) == "table" then
		return entry.name or ""
	end
	return tostring(entry or "")
end

local function getFilterPriority(entry)
	if type(entry) == "table" and entry.priority then
		return entry.priority
	end
	return 999
end

local function parseFilterEntry(chunk)
	chunk = normalizeFilterName(normalizeFilterRaw(chunk))
	if chunk == "" then
		return nil
	end
	local atPos = chunk:find("@", 1, true)
	if not atPos then
		return nil
	end
	local name = normalizeFilterName(chunk:sub(1, atPos - 1))
	local prioStr = normalizeFilterName(chunk:sub(atPos + 1))
	if name == "" or prioStr == "" then
		return nil
	end
	local prio = tonumber(prioStr)
	if not prio or prio < 1 then
		return nil
	end
	return name, math.floor(prio)
end

local function findFilterIndexByName(name)
	local lower = name:lower()
	for idx, entry in ipairs(nameFilters) do
		if getFilterName(entry):lower() == lower then
			return idx
		end
	end
	return nil
end

local function getPetFilterPriority(petName)
	if #nameFilters == 0 then
		return 999
	end
	local best = math.huge
	local lowerName = tostring(petName or ""):lower()
	for _, entry in ipairs(nameFilters) do
		local fname = getFilterName(entry)
		if lowerName:find(fname:lower(), 1, true) then
			local p = getFilterPriority(entry)
			if p < best then
				best = p
			end
		end
	end
	return best
end

local function petMatchesFilters(petName)
	if #nameFilters == 0 then
		return true
	end
	return getPetFilterPriority(petName) < math.huge
end

local function applyNameFilters(pets)
	if #nameFilters == 0 then
		return pets
	end
	local out = {}
	for _, pet in ipairs(pets) do
		if petMatchesFilters(pet.name) then
			table.insert(out, pet)
		end
	end
	table.sort(out, function(a, b)
		local pa, pb = getPetFilterPriority(a.name), getPetFilterPriority(b.name)
		if pa ~= pb then
			return pa < pb
		end
		if a.sortKey ~= b.sortKey then
			return a.sortKey < b.sortKey
		end
		return (a.distance or math.huge) < (b.distance or math.huge)
	end)
	return out
end

-- Pick next pet: prefer priority > skipBelowPriority, then wrap to P1.
local function pickNextFarmTarget(pets, skipBelowPriority)
	local function isValid(pet)
		return pet.model and pet.model.Parent
	end

	local best, bestP = nil, math.huge
	for _, pet in ipairs(pets) do
		if isValid(pet) then
			local p = getPetFilterPriority(pet.name)
			if p > (skipBelowPriority or 0) and p < bestP then
				bestP = p
				best = pet
			end
		end
	end
	if best then
		return best, bestP
	end

	bestP = math.huge
	for _, pet in ipairs(pets) do
		if isValid(pet) then
			local p = getPetFilterPriority(pet.name)
			if p < bestP then
				bestP = p
				best = pet
			end
		end
	end
	return best, bestP
end

scanWorldPets = function()
	local ok, pets = pcall(getWorldPets)
	if ok and pets then
		lastAllPets = pets
		return pets
	end
	lastAllPets = {}
	return {}
end

local function makeDraggable(frame, dragHandles)
	local dragging = false
	local dragStart, startPos
	local function startDrag(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = true
			dragStart = inp.Position
			startPos = frame.Position
		end
	end
	for _, handle in ipairs(dragHandles) do
		handle.InputBegan:Connect(startDrag)
	end
	UserInputService.InputChanged:Connect(function(inp)
		if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
			local delta = inp.Position - dragStart
			frame.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	UserInputService.InputEnded:Connect(function(inp)
		if inp.UserInputType == Enum.UserInputType.MouseButton1 then
			dragging = false
		end
	end)
end

local function teleportToPet(model)
	local char = LocalPlayer.Character
	if not char then
		return
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	local pos = getModelPosition(model)
	if not root or not pos then
		return
	end
	root.CFrame = CFrame.new(pos + Vector3.new(0, 0, 6))
end

