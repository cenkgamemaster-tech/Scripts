tickFarmLists = function(runId, world, filters, scanMode, mode)
	mode = mode or (world and "world" or "pet")
	if runId and not shouldFarmContinue(runId, mode) then
		return false
	end
	scanMode = scanMode or "light"
	if (worldHuntRunning or autoFarmRunning) and scanMode == "auto" then
		scanMode = "light"
	end
	local pets = getCachedWorldPets(scanMode)
	local filtersForWorld = filters or (world and worldPetFilters[world.id]) or {}
	local filteredPets = applyNameFilters(pets, nameFilters)
	local visiblePets = {}
	local filteredWorld = {}
	if world then
		visiblePets = getWorldVisiblePets(world, filtersForWorld, pets)
		filteredWorld = applyNameFilters(visiblePets, filtersForWorld)
	end

	if scanMode == "full" or scanMode == "auto" then
		populateList(filteredPets, #pets)
		if world then
			populateWorldList(filteredWorld, #visiblePets, #pets)
		end
		lastLightPetsCount = #filteredPets
		lastLightWorldCount = world and #filteredWorld or lastLightWorldCount
	else
		if #filteredPets ~= lastLightPetsCount then
			populateList(filteredPets, #pets)
			lastLightPetsCount = #filteredPets
		end
		if world and #filteredWorld ~= lastLightWorldCount then
			populateWorldList(filteredWorld, #filteredWorld, #pets)
			lastLightWorldCount = #filteredWorld
		end
	end
	return runId == nil or shouldFarmContinue(runId, mode)
end

farmWaitWithListRefresh = function(waitSec, runId, onTick, world, filters, onEachSecond, keepWaiting, mode)
	mode = mode or (world and "world" or "pet")
	local nextRefreshIn = 0
	for sec = waitSec, 1, -1 do
		if keepWaiting and not keepWaiting() then
			return false
		end
		if runId and not shouldFarmContinue(runId, mode) then
			return false
		end
		if onEachSecond and onEachSecond(sec) then
			return "interrupt"
		end
		if onTick then
			onTick(sec)
		end
		if nextRefreshIn <= 0 then
			tickFarmLists(runId, world, filters, "light", mode)
			nextRefreshIn = FARM_LIST_REFRESH_SEC
		end
		nextRefreshIn = nextRefreshIn - 1
		if not farmWait(1, runId, mode) then
			return false
		end
	end
	return true
end

refreshWorldList = function(rescan, worldConfig)
	local ok, err = pcall(function()
		worldConfig = worldConfig or getSelectedWorldConfig()
		if not worldConfig then
			populateWorldList({}, 0, 0)
