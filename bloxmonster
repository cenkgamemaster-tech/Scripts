	local ok, text, count = pcall(function()
		if type(scanAllRemotesText) ~= "function" then
			error("scanAllRemotesText missing – reload bloxmonster v1.12.2")
		end
		return scanAllRemotesText()
	end)
	if not ok then
		text = "Scan error:\n" .. tostring(text)
		count = 0
		warn("[BloxMonster Contest]", text)
	elseif not text or text == "" then
		text = "Scan returned empty."
		count = 0
	end
	if typeof(_G) == "table" then
		_G.BloxMonsterLastContestScan = text
	end
	openContestScanWindow(text)
	printRemotesToConsole(text)
	if UI.dungeonScanContent then
		UI.dungeonScanContent.Text = text
		dungeonLogLines = {}
		for line in string.gmatch(text, "[^\n]+") do
			table.insert(dungeonLogLines, line)
		end
	end
	local copied = copyText(text)
	UI.dungeonStatusLabel.Text = copied
		and ("Done: %d DungeonService remote(s) – copied + F9 console."):format(count or 0)
		or ("Done: %d DungeonService remote(s) – see popup + F9."):format(count or 0)
	UI.dungeonScanBtn.Text = "Remotes"
	print("[BloxMonster Contest remotes]\n" .. text)
end

	UI.dungeonScanBtn.MouseButton1Click:Connect(function()
		runContestRemotesDump()
	end)

	UI.dungeonScanCopyBtn.MouseButton1Click:Connect(function()
		local text = contestScanRawText
		if (not text or text == "") and UI.dungeonScanContent then
			text = UI.dungeonScanContent.Text or ""
		end
		if text == "" or text:find("Dungeon log") == 1 then
			runContestRemotesDump()
			return
		end
		local copied = copyText(text)
		UI.dungeonStatusLabel.Text = copied and "Copied!" or "Use F9 console output."
	end)

	UI.farmStartBtn.MouseButton1Click:Connect(startAutoFarm)
	UI.farmStopBtn.MouseButton1Click:Connect(stopAutoFarm)

	UI.closeBtn.MouseButton1Click:Connect(function()
		stopAutoRefresh()
		stopAllFarm()
		stopContestDungeon()
		stopAutoFuse()
		UI.screen:Destroy()
	end)

	UI.autoRefreshBtn.MouseButton1Click:Connect(function()
		if autoRefreshRunning then
			stopAutoRefresh()
			return
		end
		autoRefreshRunning = true
		UI.autoRefreshBtn.Text = "Auto refresh: ON"
		UI.autoRefreshBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 70)
		if autoRefreshThread then
			task.cancel(autoRefreshThread)
		end
		autoRefreshThread = task.spawn(function()
			while autoRefreshRunning do
				if not autoFarmRunning and not worldHuntRunning and not contestRunning and not farmLocationStayActive then
					if activeTab == "worlds" then
						refreshWorldList()
					elseif activeTab == "pets" then
						refreshList()
					end
				end
				task.wait(AUTO_REFRESH_SEC)
			end
		end)
	end)
end

local connectOk, connectErr = pcall(connectAllUIHandlers)
if not connectOk then
	warn("[BloxMonster] UI handler connect error:", connectErr)
	showLoadError(tostring(connectErr))
end

task.defer(function()
	local initOk, initErr = pcall(function()
		setActiveTab("pets")
		rebuildFilterChips()
		rebuildWorldFilterChips()
		refreshLocationRows()
		refreshList()
		updateFarmLocationEnableButton()
		highlightContestDifficultyButtons()
		updateContestMasterKeyBtn()
		updateContestPerkBtn()
		refreshConfigStatusLabel()
	end)
	if not initOk then
		warn("[BloxMonster] Init error:", initErr)
	end
	print(("[BloxMonster] v%s loaded"):format(VERSION))
	task.defer(getWorldRemotes)
end)

end -- app handlers part 2
