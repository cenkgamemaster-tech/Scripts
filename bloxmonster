local function shouldFarmContinue(runId)
	return autoFarmRunning and farmRunId == runId
end

local function farmWait(seconds, runId)
	local elapsed = 0
	while elapsed < seconds do
		if runId and not shouldFarmContinue(runId) then
			return false
		end
		if not runId and not autoFarmRunning then
			return false
		end
		local step = math.min(0.25, seconds - elapsed)
		task.wait(step)
		elapsed = elapsed + step
	end
	if runId then
		return shouldFarmContinue(runId)
	end
	return autoFarmRunning
end

