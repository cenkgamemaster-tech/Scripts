local function shouldFarmContinue(runId, mode)
	mode = mode or "pet"
	if mode == "world" then
		if runId then
			return worldHuntRunning and worldFarmRunId == runId
		end
		return worldHuntRunning
	end
	if runId then
		return autoFarmRunning and petFarmRunId == runId
	end
	return autoFarmRunning
end

local function farmWait(seconds, runId, mode)
	mode = mode or "pet"
	local elapsed = 0
	while elapsed < seconds do
		if runId and not shouldFarmContinue(runId, mode) then
			return false
		end
		if not runId then
			if mode == "world" then
				if not worldHuntRunning then
					return false
				end
			elseif not autoFarmRunning then
				return false
			end
		end
		local step = math.min(0.25, seconds - elapsed)
		task.wait(step)
		elapsed = elapsed + step
	end
	if runId then
		return shouldFarmContinue(runId, mode)
	end
	if mode == "world" then
		return worldHuntRunning
	end
	return autoFarmRunning
end

