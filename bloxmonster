local PET_ATTR_KEYS = {
	"PetId", "PetName", "MonsterName", "Monster", "MonsterId", "NpcId", "NPCId",
	"Rarity", "Tier", "Mutation", "Shiny", "Level", "Wild", "IsWild", "Catchable",
