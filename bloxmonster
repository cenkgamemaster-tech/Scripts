local function collectBonusFarmFilters()
	local out = {}
	local seen = {}
	local function addFrom(filters)
		if not filters then
			return
		end
		for _, entry in ipairs(filters) do
			if getFilterPriority(entry) >= WORLD_CYCLE_BONUS_MIN_PRIORITY then
				local key = getFilterName(entry):lower()
				if not seen[key] then
					seen[key] = true
					table.insert(out, entry)
				end
			end
		end
	end
	for _, world in ipairs(WORLD_ZONES) do
		addFrom(worldPetFilters[world.id])
	end
	addFrom(nameFilters)
	return out
end

local function formatBonusTimeLeft(secondsLeft)
	return ("%dm %ds"):format(math.floor(secondsLeft / 60), secondsLeft % 60)
end

local function runPostCycleBonusFarm(runId)
	local bonusFilters = collectBonusFarmFilters()
	if #bonusFilters == 0 then
		return
	end

	local bonusEnd = wallClockSeconds() + WORLD_CYCLE_BONUS_SEC
	local lastBonusPriority = WORLD_CYCLE_BONUS_MIN_PRIORITY - 1

	while shouldFarmContinue(runId, "world") and wallClockSeconds() < bonusEnd do
		local timeLeft = math.ceil(bonusEnd - wallClockSeconds())
		setWorldFarmStatus(("Bonus P3+ (%s left) – scanning..."):format(formatBonusTimeLeft(timeLeft)))

		local pets = getCachedWorldPets("auto")
		if not shouldFarmContinue(runId, "world") then
			break
		end
		applyListsFromPets(pets, nil, nil)
		local targets = applyNameFilters(pets, bonusFilters)
		local target, targetP = pickNextFarmTarget(targets, lastBonusPriority, bonusFilters)

		if not target then
			setWorldFarmStatus(("Bonus P3+ (%s left) – no targets, waiting..."):format(formatBonusTimeLeft(timeLeft)))
			if not farmWait(FARM_NO_TARGET_WAIT_SEC, runId, "world") then
				break
			end
		else
			local prio = targetP or getPetFilterPriority(target.name, bonusFilters)
			setWorldFarmStatus(("Bonus P%s: %s (%s left)"):format(
				tostring(prio),
				target.name,
				formatBonusTimeLeft(timeLeft)
			))
			teleportToPet(target.model)
			tickFarmLists(runId, nil, nil, "auto", "world")

			farmWaitWithListRefresh(getFarmWaitSec(), runId, function(sec)
				timeLeft = math.ceil(bonusEnd - wallClockSeconds())
				setWorldFarmStatus(("Bonus P%s: %s – %ds (%s left)"):format(
					tostring(prio),
					target.name,
					sec,
					formatBonusTimeLeft(timeLeft)
				))
			end, nil, nil, nil, function()
				return shouldFarmContinue(runId, "world") and wallClockSeconds() < bonusEnd
			end, "world")

			if not shouldFarmContinue(runId, "world") then
				break
			end

			lastBonusPriority = prio
			getCachedWorldPets("auto")
			refreshList(false)
		end
	end
end

local function runWorldFarmLoop(runId)
	while shouldFarmContinue(runId, "world") do
		if not runFarmLocationPhase(runId) then
			break
		end
		if not shouldFarmContinue(runId, "world") then
			break
		end

		local worldsVisited = 0
		setWorldFarmStatus("Farm stay done – starting world cycle...")
		for _, world in ipairs(WORLD_ZONES) do
			if farmLocationStayActive or not shouldFarmContinue(runId, "world") then
				break
			end
			local filters = worldPetFilters[world.id]
			local highFilters = filtersBelowPriority(filters, WORLD_CYCLE_BONUS_MIN_PRIORITY)
			if #highFilters > 0 then
				worldsVisited = worldsVisited + 1
				selectedWorldId = world.id
				highlightWorldButtons()
				rebuildWorldFilterChips()

				setWorldFarmStatus("Going to " .. world.name .. "...")
				local tpOk, tpMethod = teleportToWorld(world)
				if not tpOk then
					setWorldFarmStatus("No travel to " .. world.name .. ", trying pets anyway...")
					if not farmWait(FARM_NO_TARGET_WAIT_SEC, runId, "world") then
						break
					end
				else
					setWorldFarmStatus(("At %s (%s)"):format(world.name, tostring(tpMethod)))
					if not farmWait(WORLD_TELEPORT_SETTLE_SEC, runId, "world") then
						break
					end
				end

				local lastWorldPriority = 0
				while shouldFarmContinue(runId, "world") do
					if not refreshWorldFarmList(world, "Refreshing list...", runId, "auto") then
						break
					end
					local targets = getWorldHuntTargets(world, highFilters)

					local target, targetP = pickNextFarmTarget(targets, lastWorldPriority, highFilters)
					if not target then
						setWorldFarmStatus(("No targets left in %s – next world"):format(world.name))
						break
					end

					local prio = targetP or getPetFilterPriority(target.name, highFilters)
					setWorldFarmStatus(("[%s] TP P%s: %s"):format(world.name, tostring(prio), target.name))
					teleportToPet(target.model)
					tickFarmLists(runId, world, highFilters, "auto", "world")

					if not farmWaitWithListRefresh(getFarmWaitSec(), runId, function(sec)
						setWorldFarmStatus(("[%s] P%s: %s – %ds"):format(world.name, tostring(prio), target.name, sec))
					end, world, highFilters, nil, nil, "world") then
						break
					end

					if not shouldFarmContinue(runId, "world") then
						break
					end

					lastWorldPriority = prio
					if not refreshWorldFarmList(world, "Refreshing list...", runId, "auto") then
						break
					end
				end
			end
		end
		if worldsVisited == 0 then
			setWorldFarmStatus("No P1-P2 pets on Worlds tab – add e.g. Rio@1 per world")
			if not farmWait(FARM_NO_TARGET_WAIT_SEC, runId, "world") then
				break
			end
		end
		if shouldFarmContinue(runId, "world") then
			runPostCycleBonusFarm(runId)
		end
	end
end

