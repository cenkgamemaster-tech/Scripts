		end

		local scanMode = "auto"
		if rescan == true then
			scanMode = "full"
		elseif rescan == false then
			scanMode = "light"
		end
		local pets = getCachedWorldPets(scanMode)
		local filters = getSelectedWorldFilters()
		local visiblePets = getWorldVisiblePets(worldConfig, filters, pets)
		local filtered = applyNameFilters(visiblePets, filters)
		populateWorldList(filtered, #visiblePets, #pets)
		lastLightWorldCount = #filtered
	end)
	if not ok then
		warn("[BloxMonster] World refresh error:", err)
	end
end

