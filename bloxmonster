		UI.farmWaitInput.Text = tostring(farmWaitSec)
		return false
	end
	farmWaitSec = val
	UI.farmWaitInput.Text = tostring(farmWaitSec)
	refreshConfigStatusLabel()
	return true
end

local function parseFarmStaySec(text)
