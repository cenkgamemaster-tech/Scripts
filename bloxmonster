refreshList = function(rescan)
	local ok, err = pcall(function()
		local scanMode = "auto"
		if rescan == true then
			scanMode = "full"
		elseif rescan == false then
			scanMode = "light"
		end
		local pets = getCachedWorldPets(scanMode)
		local filtered = applyNameFilters(pets)
		populateList(filtered, #pets)
	end)
	if not ok then
		warn("[BloxMonster] Refresh error:", err)
	end
end

local function applyListsFromPets(pets, worldConfig, worldFilters)
	local filteredPets = applyNameFilters(pets)
	populateList(filteredPets, #pets)
	if worldConfig then
		local visiblePets = getWorldVisiblePets(worldConfig, worldFilters, pets)
		local filteredWorld = applyNameFilters(visiblePets, worldFilters)
		populateWorldList(filteredWorld, #visiblePets, #pets)
	end
end

local function tickFarmLists(runId, world, filters, scanMode)
	if runId and not shouldFarmContinue(runId) then
		return false
	end
	scanMode = scanMode or "light"
	local pets = getCachedWorldPets(scanMode)
	local filtersForWorld = filters or (world and worldPetFilters[world.id]) or {}
	local filteredPets = applyNameFilters(pets, nameFilters)
	local visiblePets = {}
	local filteredWorld = {}
	if world then
		visiblePets = getWorldVisiblePets(world, filtersForWorld, pets)
		filteredWorld = applyNameFilters(visiblePets, filtersForWorld)
	end

	if scanMode == "full" or scanMode == "auto" then
		populateList(filteredPets, #pets)
		if world then
			populateWorldList(filteredWorld, #visiblePets, #pets)
		end
		lastLightPetsCount = #filteredPets
		lastLightWorldCount = world and #filteredWorld or lastLightWorldCount
	else
		if #filteredPets ~= lastLightPetsCount then
			populateList(filteredPets, #pets)
			lastLightPetsCount = #filteredPets
		end
		if world and #filteredWorld ~= lastLightWorldCount then
			populateWorldList(filteredWorld, #filteredWorld, #pets)
			lastLightWorldCount = #filteredWorld
		end
	end
	return runId == nil or shouldFarmContinue(runId)
end

local function farmWaitWithListRefresh(waitSec, runId, onTick, world, filters, onEachSecond, keepWaiting)
	local nextRefreshIn = 0
	for sec = waitSec, 1, -1 do
		if keepWaiting and not keepWaiting() then
			return false
		end
		if runId and not shouldFarmContinue(runId) then
			return false
		end
		if onEachSecond and onEachSecond(sec) then
			return "interrupt"
		end
		if onTick then
			onTick(sec)
		end
		if nextRefreshIn <= 0 then
			tickFarmLists(runId, world, filters, "light")
			nextRefreshIn = FARM_LIST_REFRESH_SEC
		end
		nextRefreshIn = nextRefreshIn - 1
		if not farmWait(1, runId) then
			return false
		end
	end
	return true
end

refreshWorldList = function(rescan, worldConfig)
	local ok, err = pcall(function()
		worldConfig = worldConfig or getSelectedWorldConfig()
		if not worldConfig then
			populateWorldList({}, 0, 0)
			return
		end

		local scanMode = "auto"
		if rescan == true then
			scanMode = "full"
		elseif rescan == false then
			scanMode = "light"
		end
		local pets = getCachedWorldPets(scanMode)
		local filters = getSelectedWorldFilters()
		local visiblePets = getWorldVisiblePets(worldConfig, filters, pets)
		local filtered = applyNameFilters(visiblePets, filters)
		populateWorldList(filtered, #visiblePets, #pets)
		lastLightWorldCount = #filtered
	end)
	if not ok then
		warn("[BloxMonster] World refresh error:", err)
	end
end

local function selectWorld(worldId, teleport)
	selectedWorldId = worldId
	highlightWorldButtons()
	rebuildWorldFilterChips()
	if teleport then
		local world = getWorldConfigById(worldId)
		if world then
			UI.worldHuntStatusLabel.Text = "Teleporting to " .. world.name .. "..."
			local ok, method = teleportToWorld(world)
			UI.worldHuntStatusLabel.Text = ok
				and ("At " .. world.name .. " (" .. tostring(method) .. ")")
				or ("Could not travel to " .. world.name)
			if ok then
				task.wait(WORLD_TELEPORT_SETTLE_SEC)
			end
		end
	end
	refreshWorldList(true)
end

onWorldButtonClick = selectWorld

local function getFarmWaitSec()
	return farmWaitSec
end

local function parseFarmWaitSec(text)
	local n = tonumber(text)
	if not n then
		return nil
	end
	return math.clamp(math.floor(n + 0.5), MIN_FARM_WAIT_SEC, MAX_FARM_WAIT_SEC)
end

local function applyFarmWaitFromInput()
	local val = parseFarmWaitSec(UI.farmWaitInput.Text)
	if not val then
		UI.configStatusLabel.Text = ("Enter %d–%d seconds"):format(MIN_FARM_WAIT_SEC, MAX_FARM_WAIT_SEC)
		UI.farmWaitInput.Text = tostring(farmWaitSec)
		return false
	end
	farmWaitSec = val
	UI.farmWaitInput.Text = tostring(farmWaitSec)
	UI.configStatusLabel.Text = ("Farm wait: %ds (applies on next hunt)"):format(farmWaitSec)
	return true
end

