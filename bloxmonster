local function tryBuildPetEntry(model, playerChars)
	if not model or model.ClassName ~= "Model" or playerChars[model] then
		return nil
	end
	if WORKSPACE_PREFIX and WORKSPACE_PREFIX ~= "" and not isUnderPath(model, WORKSPACE_PREFIX) then
		return nil
	end

	local okName, fullName = pcall(function() return model:GetFullName() end)
	if not okName or not fullName or isEquippedPetPath(fullName) then
		return nil
	end

	local score = model:FindFirstChildOfClass("Humanoid") and 1 or 0
	local bb = {}
	local hasBillboard = false
	local hasCatchPrompt = false

	for _, key in ipairs(PET_ATTR_KEYS) do
		if getAttr(model, key) ~= nil then
			score = score + 1
			break
		end
	end

	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("BillboardGui") then
			hasBillboard = true
		elseif desc:IsA("ProximityPrompt") then
			local action = (desc.ActionText or ""):lower()
			local obj = (desc.ObjectText or ""):lower()
			if action:find("catch", 1, true) or action:find("battle", 1, true)
				or action:find("fight", 1, true) or obj:find("catch", 1, true) then
				hasCatchPrompt = true
			end
		elseif (desc:IsA("TextLabel") or desc:IsA("TextButton")) and desc.Text and desc.Text ~= "" then
			if BILLBOARD_LABEL_SET[desc.Name] then
				bb[desc.Name] = desc.Text
			end
		elseif desc.GetAttribute then
			for _, key in ipairs(PET_ATTR_KEYS) do
				if getAttr(desc, key) ~= nil then
					score = score + 1
					break
				end
			end
		end
	end

	if hasBillboard then
		score = score + 2
	end
	if hasCatchPrompt then
		score = score + 2
	end
	if score < 2 then
		return nil
	end

	local petName = bb.PetName or bb.MonsterName or bb.Name or model.Name
	local rarity = bb.Rarity
	local tier = bb.Tier or getAttr(model, "Tier")
	local level = bb.Level or getAttr(model, "Level")
	local mutation = bb.Mutation or getAttr(model, "Mutation")
	local shiny = bb.Shiny or getAttr(model, "Shiny")
	local rarityKey = rarity and tostring(rarity):gsub("^%s+", ""):gsub("%s+$", "") or ""

	return {
		model = model,
		name = tostring(petName),
		rarity = rarity and tostring(rarity) or "—",
		tier = tier and tostring(tier) or "—",
		level = level and tostring(level) or "—",
		mutation = mutation and tostring(mutation) or "—",
		shiny = shiny and tostring(shiny) or "—",
		distance = getDistanceToPlayer(model),
		path = fullName,
		sortKey = RARITY_ORDER[rarityKey] or RARITY_ORDER[tostring(tier or "")] or 99,
	}
end

local function getWorldPets()
	local root = getScanRoot()
	local found = {}
	local seen = {}
	local playerChars = getPlayerCharacterSet()

	local function consider(model)
		if seen[model] then
			return
		end
		seen[model] = true
		local ok, entry = pcall(tryBuildPetEntry, model, playerChars)
		if ok and entry then
			table.insert(found, entry)
		end
	end

	if root then
		for _, desc in ipairs(root:GetDescendants()) do
			if desc.ClassName == "Model" then
				consider(desc)
			end
		end
	end

	table.sort(found, function(a, b)
		if a.sortKey ~= b.sortKey then
			return a.sortKey < b.sortKey
		end
		local da, db = a.distance or math.huge, b.distance or math.huge
		if da ~= db then
			return da < db
		end
		return a.name < b.name
	end)

	return found
end

