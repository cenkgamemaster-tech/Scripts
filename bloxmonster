end

local function startAutoFarm()
	if autoFarmRunning then
		return
	end
	if worldHuntRunning then
		UI.farmStatusLabel.Text = "Stop world hunt first"
		return
	end
	petFarmRunId = petFarmRunId + 1
	local myRunId = petFarmRunId
	autoFarmRunning = true
	UI.farmStartBtn.BackgroundColor3 = Color3.fromRGB(60, 140, 70)
	UI.farmStatusLabel.Text = "Farm starting..."
	if autoFarmThread then
		pcall(task.cancel, autoFarmThread)
	end
	autoFarmThread = task.spawn(function()
		local lastFarmPriority = 0
		local ok, err = pcall(function()
			maybeStartAutoFuseWithFarm()
			while shouldFarmContinue(myRunId, "pet") do
				local pets = getCachedWorldPets("auto")
				if not shouldFarmContinue(myRunId, "pet") then
					break
				end
				populateList(applyNameFilters(pets), #pets)

				local targets = applyNameFilters(pets)
				local target, targetP = pickNextFarmTarget(targets, lastFarmPriority)
				if not target then
					lastFarmPriority = 0
					UI.farmStatusLabel.Text = "Waiting for pets..."
					if not farmWait(FARM_NO_TARGET_WAIT_SEC, myRunId, "pet") then
						break
					end
				else
					local model = target.model
					local prio = targetP or getPetFilterPriority(target.name)
					UI.farmStatusLabel.Text = ("TP P%s: %s"):format(tostring(prio), target.name)
					teleportToPet(model)
					tickFarmLists(myRunId, nil, nil, "auto", "pet")

					if not farmWaitWithListRefresh(getFarmWaitSec(), myRunId, function(sec)
						UI.farmStatusLabel.Text = ("P%s: %s – %ds"):format(tostring(prio), target.name, sec)
					end, nil, nameFilters, nil, nil, "pet") then
						break
					end

					if not shouldFarmContinue(myRunId, "pet") then
						break
					end

					lastFarmPriority = prio
					UI.farmStatusLabel.Text = "Refreshing list..."
					pets = getCachedWorldPets("auto")
					populateList(applyNameFilters(pets), #pets)
				end
			end
		end)
		if not ok and not tostring(err):find("cancelled", 1, true) then
			warn("[BloxMonster] Farm error:", err)
		end
		if petFarmRunId == myRunId then
			autoFarmRunning = false
			UI.farmStartBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 55)
			UI.farmStatusLabel.Text = "Farm idle"
		end
	end)
end

