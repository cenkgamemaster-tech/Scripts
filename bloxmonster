}

local function resolveRemotePath(pathString)
	local node = game
	for part in string.gmatch(pathString, "[^.]+") do
		node = node and node:FindFirstChild(part)
		if not node then
			return nil
		end
	end
	if node and (node:IsA("RemoteEvent") or node:IsA("RemoteFunction")) then
		return node
	end
	return nil
end

local function remoteNameMatchesFuse(name)
	local lower = string.lower(name or "")
	for _, kw in ipairs(FUSE_REMOTE_KEYWORDS) do
		if lower:find(kw, 1, true) then
			return true
		end
	end
	return false
end

local function valueToLogString(value, depth)
	depth = depth or 0
	if depth > 3 then
		return "(nested)"
	end
	local t = typeof(value)
	if t == "table" then
		local parts = {}
		for i, v in ipairs(value) do
			table.insert(parts, valueToLogString(v, depth + 1))
		end
		if #parts == 0 then
			for k, v in pairs(value) do
				table.insert(parts, tostring(k) .. "=" .. valueToLogString(v, depth + 1))
			end
		end
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	return tostring(value)
end

collectFuseRelatedRemotes = function()
	local seen = {}
	local list = {}
	local function add(remote)
		local key = remote:GetFullName()
		if seen[key] then
			return
		end
		seen[key] = true
		table.insert(list, remote)
	end
	for _, path in ipairs(FUSE_REMOTE_CANDIDATES) do
		local remote = resolveRemotePath(path)
		if remote then
			add(remote)
		end
	end
	for _, inst in ipairs(ReplicatedStorage:GetDescendants()) do
		if (inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction")) and remoteNameMatchesFuse(inst.Name) then
			add(inst)
		end
	end
	table.sort(list, function(a, b)
		return a:GetFullName() < b:GetFullName()
	end)
	return list
end

scanPetServiceText = function()
	local lines = {
		"=== PetService (Knit) ===",
		"AddPet / UpdatePetData = server → client (pet table includes rank=E, uid, id=P7).",
		"Auto-fuse needs the client → server RankUp/Fuse remote (scan below).",
		"",
	}
	local petService = findPetServiceFolder()
	if not petService then
		table.insert(lines, "PetService not found under ReplicatedStorage.")
		return table.concat(lines, "\n"), 0
	end
	table.insert(lines, "Path: " .. petService:GetFullName())
	table.insert(lines, "")
	local count = 0
	local remotes = {}
	for _, child in ipairs(petService:GetDescendants()) do
		if child:IsA("RemoteEvent") or child:IsA("RemoteFunction") or child:IsA("UnreliableRemoteEvent") then
			table.insert(remotes, child)
		end
	end
	table.sort(remotes, function(a, b)
		return a:GetFullName() < b:GetFullName()
	end)
	for _, remote in ipairs(remotes) do
		count = count + 1
		local tag = ""
		local n = remote.Name:lower()
		if n == "updatepetdata" or n == "addpet" then
			tag = "  <-- server pushes pet data (rank, uid)"
		elseif n == "rankup" then
			tag = "  <-- AUTO-FUSE uses this (3 uids)"
		elseif n:find("rank", 1, true) or n:find("ascend", 1, true) or n:find("fuse", 1, true) or n:find("combine", 1, true) then
			tag = "  <-- rank-up / fuse related"
		end
		table.insert(lines, ("  %s (%s)%s"):format(remote:GetFullName(), remote.ClassName, tag))
	end
	table.insert(lines, "")
	table.insert(lines, ("Total: %d PetService remote(s)"):format(count))
	return table.concat(lines, "\n"), count
end

