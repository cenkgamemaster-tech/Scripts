local function robustTeleportToPosition(pos, exact)
	local char = LocalPlayer.Character
	if not char or not pos then
		return false
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end

	local target = CFrame.new(exact and pos or (pos + Vector3.new(0, 5, 0)))
	pcall(function()
		char:PivotTo(target)
	end)
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = target

	for _ = 1, 5 do
		task.wait(0.08)
		if not root.Parent then
			return false
		end
		root.CFrame = target
	end
	return true
end

local function teleportPlayerToPosition(pos)
	return robustTeleportToPosition(pos)
end

local function teleportToWorld(worldConfig)
	local filters = worldPetFilters[worldConfig.id]

	local savedPos = getSavedWorldPosition(worldConfig.id)
	if savedPos and robustTeleportToPosition(savedPos, true) then
		print(("[BloxMonster] Teleported to saved location for %s"):format(worldConfig.name))
		return true, "saved"
	end

	if tryFireWorldRemotes(worldConfig) then
		task.wait(WORLD_TELEPORT_SETTLE_SEC)
		return true, "remote"
	end

	if tryWorldProximityPrompts(worldConfig) then
		task.wait(WORLD_TELEPORT_SETTLE_SEC)
		return true, "portal"
	end

	local zoneFolder = findWorldZoneFolder(worldConfig)
	if zoneFolder then
		local pos = getFolderCenterPosition(zoneFolder)
		if pos and robustTeleportToPosition(pos) then
			print(("[BloxMonster] Teleported to zone %s"):format(zoneFolder:GetFullName()))
			return true, "zone"
		end
	end

	local pos, score = findWorldTeleportPosition(worldConfig)
	if pos and score >= 2 and robustTeleportToPosition(pos) then
		return true, "part"
	end

	if filters and #filters > 0 then
		local targets = getWorldHuntTargets(worldConfig, filters)
		if #targets > 0 and targets[1].model then
			teleportToPet(targets[1].model)
			print(("[BloxMonster] Teleported to pet %s (world travel fallback)"):format(targets[1].name))
			return true, "pet"
		end
	end

	return false, nil
end

