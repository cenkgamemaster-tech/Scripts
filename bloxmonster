	local hint = locationHardcodeLabels[FARM_LOCATION_ID]
	if not box then
		return
	end
	local loc = resolveFarmLocation()
	local isBaked = loc and farmLocationSession == nil
	if loc then
		box.Text = ("x = %.3f,  y = %.3f,  z = %.3f"):format(loc.x, loc.y, loc.z)
		box.TextColor3 = Color3.fromRGB(255, 245, 160)
		if hint then
			hint.Text = isBaked
				and ("hardcoded: " .. formatFarmLocationHardcodeEntry(loc))
				or ("session: " .. formatFarmLocationHardcodeEntry(loc))
		end
	else
		box.Text = "x = ?,  y = ?,  z = ?  (not set)"
		box.TextColor3 = Color3.fromRGB(140, 170, 150)
		if hint then
			hint.Text = "Save in-game, then Copy -> paste into FARM_SPAWN_LOCATION"
		end
	end
