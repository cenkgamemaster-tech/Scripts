end

local function stopAllFarm()
	farmRunId = farmRunId + 1
	autoFarmRunning = false
	worldHuntRunning = false
	UI.farmStatusLabel.Text = "Farm idle"
	UI.worldHuntStatusLabel.Text = "World hunt idle"
	UI.farmStartBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 55)
	UI.worldHuntStartBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 100)
	if autoFarmThread then
		pcall(task.cancel, autoFarmThread)
		autoFarmThread = nil
	end
	if worldHuntThread and worldHuntThread ~= autoFarmThread then
		pcall(task.cancel, worldHuntThread)
	end
	worldHuntThread = nil
end

local function stopWorldHunt()
	stopAllFarm()
end

local function refreshWorldFarmList(world, statusText, runId, scanMode)
	if runId and not shouldFarmContinue(runId) then
		return false
	end
	if statusText then
		setFarmStatus(statusText)
	end
	local pets = getCachedWorldPets(scanMode or "auto")
	if runId and not shouldFarmContinue(runId) then
		return false
	end
	local filters = worldPetFilters[world.id] or {}
	applyListsFromPets(pets, world, filters)
	return runId == nil or shouldFarmContinue(runId)
end

local function collectBonusFarmFilters()
	local out = {}
	local seen = {}
	local function addFrom(filters)
		if not filters then
			return
		end
		for _, entry in ipairs(filters) do
			if getFilterPriority(entry) >= WORLD_CYCLE_BONUS_MIN_PRIORITY then
				local key = getFilterName(entry):lower()
				if not seen[key] then
					seen[key] = true
					table.insert(out, entry)
				end
			end
		end
	end
	for _, world in ipairs(WORLD_ZONES) do
		addFrom(worldPetFilters[world.id])
	end
	addFrom(nameFilters)
	return out
end

local function formatBonusTimeLeft(secondsLeft)
	return ("%dm %ds"):format(math.floor(secondsLeft / 60), secondsLeft % 60)
end

local function runPostCycleBonusFarm(runId)
	local bonusFilters = collectBonusFarmFilters()
	if #bonusFilters == 0 then
		return
	end

	local bonusEnd = nowSeconds() + WORLD_CYCLE_BONUS_SEC
	local lastBonusPriority = WORLD_CYCLE_BONUS_MIN_PRIORITY - 1

	while shouldFarmContinue(runId) and nowSeconds() < bonusEnd do
		local timeLeft = math.ceil(bonusEnd - nowSeconds())
		setFarmStatus(("Bonus P3+ (%s left) – scanning..."):format(formatBonusTimeLeft(timeLeft)))

		local pets = getCachedWorldPets("auto")
		if not shouldFarmContinue(runId) then
			break
		end
		applyListsFromPets(pets, nil, nil)
		local targets = applyNameFilters(pets, bonusFilters)
		local target, targetP = pickNextFarmTarget(targets, lastBonusPriority, bonusFilters)

		if not target then
			setFarmStatus(("Bonus P3+ (%s left) – no targets, waiting..."):format(formatBonusTimeLeft(timeLeft)))
			if not farmWait(FARM_NO_TARGET_WAIT_SEC, runId) then
				break
			end
		else
			local prio = targetP or getPetFilterPriority(target.name, bonusFilters)
			setFarmStatus(("Bonus P%s: %s (%s left)"):format(
				tostring(prio),
				target.name,
				formatBonusTimeLeft(timeLeft)
			))
			teleportToPet(target.model)
			tickFarmLists(runId, nil, nil, "auto")

			farmWaitWithListRefresh(getFarmWaitSec(), runId, function(sec)
				timeLeft = math.ceil(bonusEnd - nowSeconds())
				setFarmStatus(("Bonus P%s: %s – %ds (%s left)"):format(
					tostring(prio),
					target.name,
					sec,
					formatBonusTimeLeft(timeLeft)
				))
			end, nil, nil, nil, function()
				return shouldFarmContinue(runId) and nowSeconds() < bonusEnd
			end)

			if not shouldFarmContinue(runId) then
				break
			end

			lastBonusPriority = prio
			getCachedWorldPets("auto")
			refreshList(false)
		end
	end
end

local function runWorldFarmLoop(runId)
	while shouldFarmContinue(runId) do
		for _, world in ipairs(WORLD_ZONES) do
			if not shouldFarmContinue(runId) then
				break
			end
			local filters = worldPetFilters[world.id]
			local highFilters = filtersBelowPriority(filters, WORLD_CYCLE_BONUS_MIN_PRIORITY)
			if #highFilters > 0 then
				selectedWorldId = world.id
				highlightWorldButtons()
				rebuildWorldFilterChips()

				setFarmStatus("Going to " .. world.name .. "...")
				local tpOk, tpMethod = teleportToWorld(world)
				if not tpOk then
					setFarmStatus("No travel to " .. world.name .. ", trying pets anyway...")
					if not farmWait(FARM_NO_TARGET_WAIT_SEC, runId) then
						break
					end
				else
					setFarmStatus(("At %s (%s)"):format(world.name, tostring(tpMethod)))
					if not farmWait(WORLD_TELEPORT_SETTLE_SEC, runId) then
						break
					end
				end

				local lastWorldPriority = 0
				while shouldFarmContinue(runId) do
					if not refreshWorldFarmList(world, "Refreshing list...", runId, "full") then
						break
					end
					local targets = getWorldHuntTargets(world, highFilters)

					local target, targetP = pickNextFarmTarget(targets, lastWorldPriority, highFilters)
					if not target then
						break
					end

					local prio = targetP or getPetFilterPriority(target.name, highFilters)
					setFarmStatus(("[%s] TP P%s: %s"):format(world.name, tostring(prio), target.name))
					teleportToPet(target.model)
					tickFarmLists(runId, world, highFilters, "auto")

					if not farmWaitWithListRefresh(getFarmWaitSec(), runId, function(sec)
						setFarmStatus(("[%s] P%s: %s – %ds"):format(world.name, tostring(prio), target.name, sec))
					end, world, highFilters) then
						break
					end

					if not shouldFarmContinue(runId) then
						break
					end

					lastWorldPriority = prio
					if not refreshWorldFarmList(world, "Refreshing list...", runId, "full") then
						break
					end
				end
			end
		end
		if shouldFarmContinue(runId) then
			runPostCycleBonusFarm(runId)
		end
	end
end

local function startWorldFarm()
	if isAnyFarmRunning() then
		return false
	end
	if not anyWorldPetsConfigured() then
		setFarmStatus("Configure pets on Worlds tab first")
		return false
	end
	farmRunId = farmRunId + 1
	local myRunId = farmRunId
	autoFarmRunning = true
	worldHuntRunning = true
	UI.farmStartBtn.BackgroundColor3 = Color3.fromRGB(60, 140, 70)
	UI.worldHuntStartBtn.BackgroundColor3 = Color3.fromRGB(60, 130, 140)
	setFarmStatus("World farm starting...")
	if autoFarmThread then
		pcall(task.cancel, autoFarmThread)
	end
	if worldHuntThread then
		pcall(task.cancel, worldHuntThread)
	end
	autoFarmThread = task.spawn(function()
		local ok, err = pcall(function()
			runWorldFarmLoop(myRunId)
		end)
		if not ok and not tostring(err):find("cancelled", 1, true) then
			warn("[BloxMonster] World farm error:", err)
		end
		if farmRunId == myRunId then
			autoFarmRunning = false
			worldHuntRunning = false
		end
	end)
	worldHuntThread = autoFarmThread
	return true
end

local function startWorldHunt()
	startWorldFarm()
end

local function stopAutoFarm()
	stopAllFarm()
end

local function startAutoFarm()
	if isAnyFarmRunning() then
		return
	end
	if #nameFilters == 0 then
		if anyWorldPetsConfigured() then
			startWorldFarm()
		else
			UI.farmStatusLabel.Text = "Add pets on Pets tab or Worlds tab"
		end
		return
	end
	farmRunId = farmRunId + 1
	local myRunId = farmRunId
	autoFarmRunning = true
	UI.farmStartBtn.BackgroundColor3 = Color3.fromRGB(60, 140, 70)
	UI.farmStatusLabel.Text = "Farm starting..."
	if autoFarmThread then
		pcall(task.cancel, autoFarmThread)
	end
	autoFarmThread = task.spawn(function()
		local lastFarmPriority = 0
		local ok, err = pcall(function()
			while shouldFarmContinue(myRunId) do
				local pets = getCachedWorldPets("auto")
				if not shouldFarmContinue(myRunId) then
					break
				end
				populateList(applyNameFilters(pets), #pets)

				local targets = applyNameFilters(pets)
				local target, targetP = pickNextFarmTarget(targets, lastFarmPriority)
				if not target then
					lastFarmPriority = 0
					UI.farmStatusLabel.Text = "Waiting for pets..."
					if not farmWait(FARM_NO_TARGET_WAIT_SEC, myRunId) then
						break
					end
				else
					local model = target.model
					local prio = targetP or getPetFilterPriority(target.name)
					UI.farmStatusLabel.Text = ("TP P%s: %s"):format(tostring(prio), target.name)
					teleportToPet(model)
					tickFarmLists(myRunId, nil, nil, "auto")

					if not farmWaitWithListRefresh(getFarmWaitSec(), myRunId, function(sec)
						UI.farmStatusLabel.Text = ("P%s: %s – %ds"):format(tostring(prio), target.name, sec)
					end, nil, nameFilters) then
						break
					end

					if not shouldFarmContinue(myRunId) then
						break
					end

					lastFarmPriority = prio
					UI.farmStatusLabel.Text = "Refreshing list..."
					pets = getCachedWorldPets("full")
					populateList(applyNameFilters(pets), #pets)
				end
			end
		end)
		if not ok and not tostring(err):find("cancelled", 1, true) then
			warn("[BloxMonster] Farm error:", err)
		end
		if farmRunId == myRunId then
			autoFarmRunning = false
		end
	end)
end

local function stopAutoRefresh()
	autoRefreshRunning = false
	UI.autoRefreshBtn.Text = "Auto refresh: OFF"
	UI.autoRefreshBtn.BackgroundColor3 = Color3.fromRGB(40, 70, 50)
end

local function connectAllUIHandlers()
	UI.refreshBtn.MouseButton1Click:Connect(function()
		if activeTab == "worlds" then
			refreshWorldList(true)
		else
			refreshList(true)
		end
	end)

	UI.filterAddBtn.MouseButton1Click:Connect(function()
		task.defer(addFilterFromInput)
	end)

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode ~= Enum.KeyCode.Return and input.KeyCode ~= Enum.KeyCode.KeypadEnter then
			return
		end
		local focused = UserInputService:GetFocusedTextBox()
		if focused == UI.filterInput then
			addFilterFromInput()
		elseif focused == UI.worldFilterInput then
			addWorldFilterFromInput()
		elseif focused == UI.farmWaitInput then
			applyFarmWaitFromInput()
		end
	end)

	UI.filterClearBtn.MouseButton1Click:Connect(function()
		table.clear(nameFilters)
		UI.filterInput.Text = ""
		rebuildFilterChips()
		refreshList(false)
	end)

	UI.filtersBtn.MouseButton1Click:Connect(function()
		setFilterBarVisible(not filterBarVisible)
	end)

	UI.tabPetsBtn.MouseButton1Click:Connect(function()
		setActiveTab("pets")
	end)

	UI.tabWorldsBtn.MouseButton1Click:Connect(function()
		setActiveTab("worlds")
	end)

	UI.tabLocationsBtn.MouseButton1Click:Connect(function()
		setActiveTab("locations")
	end)

	UI.tabConfigBtn.MouseButton1Click:Connect(function()
		setActiveTab("config")
	end)

	UI.farmWaitApplyBtn.MouseButton1Click:Connect(function()
		applyFarmWaitFromInput()
	end)

	UI.worldFilterAddBtn.MouseButton1Click:Connect(function()
		task.defer(addWorldFilterFromInput)
	end)

	UI.worldFilterClearBtn.MouseButton1Click:Connect(function()
		table.clear(getSelectedWorldFilters())
		UI.worldFilterInput.Text = ""
		rebuildWorldFilterChips()
		refreshWorldList(false)
	end)

	UI.worldHuntStartBtn.MouseButton1Click:Connect(startWorldHunt)
	UI.worldHuntStopBtn.MouseButton1Click:Connect(function()
		stopWorldHunt()
	end)

	UI.farmStartBtn.MouseButton1Click:Connect(startAutoFarm)
	UI.farmStopBtn.MouseButton1Click:Connect(stopAutoFarm)

	UI.closeBtn.MouseButton1Click:Connect(function()
		stopAutoRefresh()
		stopAllFarm()
		UI.screen:Destroy()
	end)

	UI.autoRefreshBtn.MouseButton1Click:Connect(function()
		if autoRefreshRunning then
			stopAutoRefresh()
			return
		end
		autoRefreshRunning = true
		UI.autoRefreshBtn.Text = "Auto refresh: ON"
		UI.autoRefreshBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 70)
		if autoRefreshThread then
			task.cancel(autoRefreshThread)
		end
		autoRefreshThread = task.spawn(function()
			while autoRefreshRunning do
				if not autoFarmRunning and not worldHuntRunning then
					if activeTab == "worlds" then
						refreshWorldList(false)
					else
						refreshList(false)
					end
				end
				task.wait(AUTO_REFRESH_SEC)
			end
		end)
	end)
end

