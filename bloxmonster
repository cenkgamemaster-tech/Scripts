		chip.Text = chipText .. "  ×"
		chip.TextColor3 = Color3.fromRGB(200, 255, 200)
		chip.TextSize = 11
		chip.Font = Enum.Font.Gotham
		chip.AutoButtonColor = true
		chip.Parent = UI.worldFilterChipScroll

		local chipCorner = Instance.new("UICorner")
		chipCorner.CornerRadius = UDim.new(0, 4)
		chipCorner.Parent = chip

		local capturedName = filterName
		chip.MouseButton1Click:Connect(function()
			local idx = findWorldFilterIndexByName(capturedName)
			if idx then
				table.remove(getSelectedWorldFilters(), idx)
			end
