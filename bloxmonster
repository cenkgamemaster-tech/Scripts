	return { name = tostring(petOrName or "") }
end

local function exactNameEquals(text, fname, fcompact)
	local lower = tostring(text or ""):lower()
	local comp = compactName(text)
	return lower == fname or comp == fcompact
end

local function pathEndsWithExactName(path, fname, fcompact)
	local last = tostring(path or ""):match("([^%.]+)$")
	if not last then
		return false
	end
	return exactNameEquals(last, fname, fcompact)
end

local function nameMatchesFilter(filterName, pet)
	local fname = tostring(filterName or ""):lower()
	local fcompact = compactName(filterName)
	if fname == "" or fcompact == "" then
		return false
	end
	if exactNameEquals(pet.name, fname, fcompact) then
		return true
	end
	if pet.model and exactNameEquals(pet.model.Name, fname, fcompact) then
		return true
	end
	if pathEndsWithExactName(pet.path, fname, fcompact) then
		return true
	end
	return false
end

local function getPetFilterPriority(petOrName, filters)
	filters = filters or nameFilters
	if #filters == 0 then
		return 999
	end
	local pet = resolvePetIdentity(petOrName)
	local best = math.huge
	for _, entry in ipairs(filters) do
		local fname = getFilterName(entry)
		if nameMatchesFilter(fname, pet) then
			local p = getFilterPriority(entry)
			if p < best then
				best = p
			end
		end
	end
	return best
end

local function petMatchesFilters(petOrName, filters)
	filters = filters or nameFilters
	if #filters == 0 then
		return true
	end
	return getPetFilterPriority(petOrName, filters) < math.huge
end

local function applyNameFilters(pets, filters)
	filters = filters or nameFilters
	if #filters == 0 then
		return pets
	end
	local out = {}
	for _, pet in ipairs(pets) do
		if petMatchesFilters(pet, filters) then
			table.insert(out, pet)
		end
	end
	table.sort(out, function(a, b)
		local pa, pb = getPetFilterPriority(a, filters), getPetFilterPriority(b, filters)
		if pa ~= pb then
			return pa < pb
		end
		if a.sortKey ~= b.sortKey then
			return a.sortKey < b.sortKey
		end
		return (a.distance or math.huge) < (b.distance or math.huge)
	end)
	return out
end

local function pickNextFarmTarget(pets, skipBelowPriority, filters)
	local function isValid(pet)
		return pet.model and pet.model.Parent
	end

	local best, bestP = nil, math.huge
	for _, pet in ipairs(pets) do
		if isValid(pet) then
			local p = getPetFilterPriority(pet, filters)
			if p > (skipBelowPriority or 0) and p < bestP then
				bestP = p
				best = pet
			end
		end
	end
	if best then
		return best, bestP
	end

	bestP = math.huge
	for _, pet in ipairs(pets) do
		if isValid(pet) then
			local p = getPetFilterPriority(pet, filters)
			if p < bestP then
				bestP = p
				best = pet
			end
		end
	end
	return best, bestP
end

local function instanceWorldScore(inst, worldConfig)
	if not inst or not worldConfig then
		return 0
	end
	local nameLower = inst.Name:lower()
	local nameCompact = compactName(inst.Name)
	local fullLower = ""
	local fullCompact = ""
	pcall(function()
		fullLower = inst:GetFullName():lower()
		fullCompact = compactName(fullLower)
	end)

	local worldCompact = compactName(worldConfig.name)
	local worldIdCompact = compactName(worldConfig.id)
	local score = 0

	for _, kw in ipairs(worldConfig.keywords) do
		local k = kw:lower()
		local kCompact = compactName(k)
		if nameLower == k or nameCompact == kCompact then
			score = score + 3
		elseif nameLower:find(k, 1, true) or fullLower:find(k, 1, true)
			or nameCompact:find(kCompact, 1, true) or fullCompact:find(kCompact, 1, true) then
			score = score + 1
		end
	end
	if worldCompact ~= "" then
		if nameCompact == worldCompact or fullCompact:find("." .. worldCompact, 1, true) then
			score = score + 4
		elseif nameCompact:find(worldCompact, 1, true) or fullCompact:find(worldCompact, 1, true) then
			score = score + 2
		end
	end
	if worldIdCompact ~= "" and (nameCompact:find(worldIdCompact, 1, true) or fullCompact:find(worldIdCompact, 1, true)) then
		score = score + 1
	end
	return score
end

local function pathMatchesWorld(path, worldConfig)
	local lower = tostring(path or ""):lower()
	local compact = compactName(path)
	for _, kw in ipairs(worldConfig.keywords) do
		local k = kw:lower()
		local kCompact = compactName(k)
		if lower:find(k, 1, true) or compact:find(kCompact, 1, true) then
			return true
		end
	end
	local worldCompact = compactName(worldConfig.name)
	if worldCompact ~= "" and compact:find(worldCompact, 1, true) then
		return true
	end
	return false
end

local function getPetsInWorld(worldConfig, allPets)
	if not allPets then
		allPets = getCachedWorldPets("auto")
	end
	local out = {}
	for _, pet in ipairs(allPets) do
		if pathMatchesWorld(pet.path, worldConfig) then
			table.insert(out, pet)
		end
	end
	return out
end

-- Pets for a world: path match first, then filter-matched pets from full scan (spawn paths often omit zone names).
local function getWorldVisiblePets(worldConfig, filters, allPets)
	if not allPets or #allPets == 0 then
		allPets = getCachedWorldPets("auto")
	end

	local byPath = getPetsInWorld(worldConfig, allPets)
	if #byPath > 0 then
		return byPath, allPets
	end

	if filters and #filters > 0 then
		local byFilter = {}
		for _, pet in ipairs(allPets) do
			if petMatchesFilters(pet, filters) then
				table.insert(byFilter, pet)
			end
		end
		if #byFilter > 0 then
			return byFilter, allPets
		end
	end

	return {}, allPets
end

local function getWorldHuntTargets(worldConfig, filters)
	local allPets = getCachedWorldPets("auto")
	local visible = getWorldVisiblePets(worldConfig, filters, allPets)
	return applyNameFilters(visible, filters)
end

local function getInstancePosition(inst)
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	end
	if inst:IsA("Model") then
		local ok, pivot = pcall(function() return inst:GetPivot() end)
		if ok and pivot then
			return pivot.Position
		end
		if inst.PrimaryPart then
			return inst.PrimaryPart.Position
		end
	end
	return nil
end

local WORLD_REMOTE_KEYWORDS = {
	"teleport", "travel", "zone", "world", "warp", "portal", "area", "map", "adventure", "visit", "enter",
}
local cachedWorldRemotes = nil

local function getWorldRemotes()
	if cachedWorldRemotes then
		return cachedWorldRemotes
	end
	cachedWorldRemotes = {}
	for _, inst in ipairs(ReplicatedStorage:GetDescendants()) do
		if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") then
			local n = inst.Name:lower()
			for _, kw in ipairs(WORLD_REMOTE_KEYWORDS) do
				if n:find(kw, 1, true) then
					table.insert(cachedWorldRemotes, inst)
					break
				end
			end
		end
	end
	if #cachedWorldRemotes > 0 then
		print(("[BloxMonster] Found %d world-related remote(s)"):format(#cachedWorldRemotes))
		for _, remote in ipairs(cachedWorldRemotes) do
			print("  ", remote:GetFullName())
		end
	end
	return cachedWorldRemotes
end

local function fireRemote(remote, ...)
	local args = { ... }
	if remote:IsA("RemoteEvent") then
		remote:FireServer(table.unpack(args))
	else
		remote:InvokeServer(table.unpack(args))
	end
end

local function tryFireWorldRemotes(worldConfig)
	local remotes = getWorldRemotes()
	if #remotes == 0 then
		return false
	end
	local argSets = {
		{ worldConfig.name },
		{ worldConfig.id },
		{ compactName(worldConfig.name) },
		{ worldConfig.name, true },
		{ worldConfig.id, true },
	}
	for _, remote in ipairs(remotes) do
		for _, args in ipairs(argSets) do
			local ok = pcall(function()
				fireRemote(remote, table.unpack(args))
			end)
			if ok then
				print(("[BloxMonster] World remote %s(%s)"):format(remote.Name, table.concat(args, ", ")))
				return true
			end
		end
	end
	return false
end

local function tryWorldProximityPrompts(worldConfig)
	for _, prompt in ipairs(Workspace:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") then
			local current = prompt
			for _ = 1, 10 do
				if not current then
					break
				end
				if instanceWorldScore(current, worldConfig) >= 2 then
					local ok = pcall(function()
						if typeof(fireproximityprompt) == "function" then
							fireproximityprompt(prompt, prompt.HoldDuration or 0)
						else
							prompt:InputHoldBegin()
							task.wait(prompt.HoldDuration > 0 and prompt.HoldDuration or 0.5)
							prompt:InputHoldEnd()
						end
					end)
					if ok then
						print(("[BloxMonster] Fired portal prompt at %s"):format(prompt:GetFullName()))
						return true
					end
				end
				current = current.Parent
			end
		end
	end
	return false
end

local function findWorldZoneFolder(worldConfig)
	local bestFolder, bestScore = nil, 0
	local zoneRoots = {}

	local map = Workspace:FindFirstChild("Map")
	if map then
		table.insert(zoneRoots, map)
		for _, name in ipairs({ "Zones", "Worlds", "Areas", "Locations", "Adventures", "Regions" }) do
			local node = map:FindFirstChild(name)
			if node then
				table.insert(zoneRoots, node)
			end
		end
	end
	for _, name in ipairs({ "Zones", "Worlds", "Areas", "Locations" }) do
		local node = Workspace:FindFirstChild(name)
		if node then
			table.insert(zoneRoots, node)
		end
	end

	local seen = {}
	for _, root in ipairs(zoneRoots) do
		if root and not seen[root] then
			seen[root] = true
			for _, child in ipairs(root:GetChildren()) do
				local score = instanceWorldScore(child, worldConfig)
				if score > bestScore then
					bestScore = score
					bestFolder = child
				end
			end
		end
	end

	if bestScore >= 2 then
		return bestFolder
	end

	for _, inst in ipairs(Workspace:GetDescendants()) do
		if inst:IsA("Folder") or inst:IsA("Model") then
			local score = instanceWorldScore(inst, worldConfig)
			if score >= 4 and score > bestScore then
				bestScore = score
				bestFolder = inst
			end
		end
	end
	return bestFolder
end

local function getFolderCenterPosition(folder)
	if not folder then
		return nil
	end

	for _, desc in ipairs(folder:GetDescendants()) do
		if desc:IsA("SpawnLocation") then
			return desc.Position
		end
		local n = desc.Name:lower()
		if (n:find("spawn", 1, true) or n:find("center", 1, true) or n == "origin") and desc:IsA("BasePart") then
			return desc.Position
		end
	end

	local sum = Vector3.zero
	local count = 0
	for _, desc in ipairs(folder:GetDescendants()) do
		if desc:IsA("BasePart") then
			sum = sum + desc.Position
			count = count + 1
		end
	end
	if count > 0 then
		return sum / count
	end
	return getInstancePosition(folder)
end

local function findWorldTeleportPosition(worldConfig)
	local bestPos, bestScore = nil, 0
	local roots = { Workspace }
	pcall(function()
		local map = Workspace:FindFirstChild("Map") or Workspace:FindFirstChild("World") or Workspace:FindFirstChild("Zones")
		if map then
			table.insert(roots, map)
		end
	end)

	local seen = {}
	local function consider(inst)
		if seen[inst] then
			return
		end
		seen[inst] = true

		local score = instanceWorldScore(inst, worldConfig)
		if score > 0 then
			local nameLower = inst.Name:lower()
			if inst:IsA("SpawnLocation") then
				score = score + 4
			elseif nameLower:find("spawn", 1, true) or nameLower:find("teleport", 1, true) or nameLower:find("portal", 1, true) then
				score = score + 3
			elseif nameLower:find("zone", 1, true) or nameLower:find("area", 1, true) or nameLower:find("region", 1, true) then
				score = score + 2
			elseif inst:IsA("BasePart") then
				score = score + 2
			elseif inst:IsA("Model") then
				score = score + 1
			end
			local pos = getInstancePosition(inst)
			if pos and score > bestScore then
				bestScore = score
				bestPos = pos
			end
		end
	end

	for _, root in ipairs(roots) do
		if root:IsA("Instance") then
			consider(root)
			for _, inst in ipairs(root:GetDescendants()) do
				consider(inst)
			end
		end
	end
	return bestPos, bestScore
end

