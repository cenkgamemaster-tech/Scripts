		end)
		if ok and val ~= nil and val ~= "" then
			return val
		end
	end
	return nil
end

local function looksLikeUidKey(key)
	if type(key) ~= "string" or key == "" then
		return false
	end
	if key:find("-", 1, true) then
		return true
	end
	if #key >= 12 and key:match("^[%w%-_]+$") then
		return true
	end
	return false
end

local function isKnitPetRecord(value, uidOverride)
	if type(value) ~= "table" or isKnitNonPetValue(value) then
		return false
	end
	local uid = uidOverride or readPetField(value, "uid", "UID", "Uuid", "uuid")
	local id = readPetField(value, "id", "Id", "petId", "PetId", "speciesId")
	if uid ~= nil and uid ~= "" then
		uid = tostring(uid)
	else
		uid = nil
	end
	if type(uid) ~= "string" or uid == "" then
		return false
	end
	if id == nil or id == "" then
		return false
	end
	return true
end

local knitPetCache = {}
local petListenersConnected = false

local function petRecordRichness(data)
	if type(data) ~= "table" then
		return 0
	end
	local score = 0
	if readPetField(data, "rank", "Rank") then
		score = score + 4
	end
	if readPetField(data, "ascend", "Ascend") then
		score = score + 2
	end
	if readPetField(data, "mutation", "Mutation") then
		score = score + 1
	end
	if readPetField(data, "traits", "Traits") then
		score = score + 1
	end
	if readPetField(data, "level", "Level") then
		score = score + 1
	end
	return score
end

local function ingestPetRecord(data, uidOverride)
	if type(data) ~= "table" or isKnitNonPetValue(data) then
		return
	end
	local uid = uidOverride or readPetField(data, "uid", "UID", "Uuid", "uuid")
	local id = readPetField(data, "id", "Id", "petId", "PetId", "speciesId")
	if not uid or id == nil or id == "" then
		return
	end
	uid = tostring(uid)
	if not isKnitPetRecord(data, uid) then
		return
	end
	local existing = knitPetCache[uid]
	if existing and petRecordRichness(existing) > petRecordRichness(data) then
		return
	end
	knitPetCache[uid] = data
end

local function ingestPetPayload(...)
	local function walk(value, depth, keyHint)
		depth = depth or 0
		if depth > 12 or type(value) ~= "table" then
			return
		end
		if isKnitPetRecord(value, type(keyHint) == "string" and keyHint or nil) then
			ingestPetRecord(value, type(keyHint) == "string" and keyHint or nil)
			return
		end
		for k, v in pairs(value) do
			if type(v) == "table" then
				local uidHint = looksLikeUidKey(k) and k or nil
				if isKnitPetRecord(v, uidHint) then
					ingestPetRecord(v, uidHint)
				elseif uidHint and readPetField(v, "id", "Id", "petId") then
					ingestPetRecord(v, uidHint)
				else
					walk(v, depth + 1, uidHint or k)
				end
			end
		end
	end
	for _, arg in ipairs({ ... }) do
		walk(arg, 0, nil)
	end
end

local function ensurePetListeners()
	if petListenersConnected then
		return
	end
	local petService = findPetServiceFolder()
	if not petService then
		return
	end
	local re = petService:FindFirstChild("RE")
	if not re then
		return
	end
	local function hook(name)
		local remote = re:FindFirstChild(name)
		if remote and remote:IsA("RemoteEvent") then
			remote.OnClientEvent:Connect(function(...)
				ingestPetPayload(...)
			end)
		end
	end
	hook("AddPet")
	hook("UpdatePetData")
	hook("LoadClient")
	hook("ReloadPlayer")
	petListenersConnected = true
end

local function findKnitPetTable(value, depth)
	depth = depth or 0
	if depth > 5 or type(value) ~= "table" then
		return nil
	end
	local hasPet = false
	for _, v in pairs(value) do
		if not isKnitNonPetValue(v) and isKnitPetRecord(v, nil) then
			hasPet = true
			break
		end
	end
	if hasPet then
		return value
	end
	for _, key in ipairs(KNIT_PET_TABLE_KEYS) do
		local sub = value[key]
		if type(sub) == "table" then
			local found = findKnitPetTable(sub, depth + 1)
			if found then
				return found
			end
		end
	end
	for _, sub in pairs(value) do
		if type(sub) == "table" and not isKnitNonPetValue(sub) then
			local found = findKnitPetTable(sub, depth + 1)
			if found then
				return found
			end
		end
	end
	return nil
end

local function getKnitModule()
	local packages = ReplicatedStorage:FindFirstChild("Packages")
	local knitModule = packages and packages:FindFirstChild("Knit")
	if knitModule then
		local ok, knit = pcall(require, knitModule)
		if ok then
			return knit
		end
	end
	return nil
end

local function collectKnitPetsDeep(value, out, depth, seen)
	depth = depth or 0
	seen = seen or {}
	if depth > 12 or type(value) ~= "table" or seen[value] then
		return
	end
	seen[value] = true
	if isKnitPetRecord(value, nil) then
		local uid = readPetField(value, "uid", "UID", "Uuid", "uuid")
		if uid then
			out[tostring(uid)] = value
		end
		return
	end
	for key, sub in pairs(value) do
		if type(sub) == "table" and not isKnitNonPetValue(sub) then
			local uidHint = looksLikeUidKey(key) and key or nil
			if isKnitPetRecord(sub, uidHint) then
				local uid = readPetField(sub, "uid", "UID", "Uuid", "uuid") or uidHint
				if uid then
					out[tostring(uid)] = sub
				end
			elseif uidHint and readPetField(sub, "id", "Id", "petId") then
				out[tostring(uidHint)] = sub
			else
				collectKnitPetsDeep(sub, out, depth + 1, seen)
			end
		end
	end
end

local KNIT_PET_FETCH_METHODS = {
	"GetPets", "GetPetList", "GetInventory", "GetAllPets", "FetchPets", "LoadPets",
	"GetOwnedPets", "GetPlayerPets", "GetPetData", "GetPetInventory",
}
local KNIT_PET_LOAD_METHODS = {
	"Load", "LoadPets", "LoadInventory", "Fetch", "Refresh", "RequestPets",
	"Open", "OpenInventory", "Toggle", "Show", "ShowInventory", "InitInventory",
}

local function scoreTableAsPetBag(tbl)
	if type(tbl) ~= "table" then
		return 0
	end
	local n = 0
	if #tbl > 0 then
		for _, v in ipairs(tbl) do
			if type(v) == "table" and (isKnitPetRecord(v, nil) or readPetField(v, "id", "Id", "petId")) then
				n = n + 1
			end
		end
		if n > 0 then
			return n
		end
	end
	for k, v in pairs(tbl) do
		if type(v) == "table" then
			local uidHint = looksLikeUidKey(k) and k or nil
			if isKnitPetRecord(v, uidHint) then
				n = n + 1
			elseif uidHint and readPetField(v, "id", "Id", "petId") then
				n = n + 1
			end
		end
	end
	return n
end

local function findLargestPetBag(value, path, depth, seen, best)
	if type(value) ~= "table" or seen[value] or depth > 12 then
		return best
	end
	seen[value] = true
	local score = scoreTableAsPetBag(value)
	if score > best.count then
		best.count = score
		best.bag = value
		best.path = path
	end
	for k, sub in pairs(value) do
		if type(sub) == "table" and not isKnitNonPetValue(sub) then
			local subPath = path .. "." .. tostring(k)
			findLargestPetBag(sub, subPath, depth + 1, seen, best)
		end
	end
	return best
end

local function foreachKnitController(fn)
	local Knit = getKnitModule()
	if not Knit then
		return
	end
	local seen = {}
	local function visit(name, ctrl)
		if seen[name] or type(ctrl) ~= "table" then
			return
		end
		seen[name] = true
		fn(name, ctrl)
	end
	if type(Knit.GetControllers) == "function" then
		local ok, ctrls = pcall(function()
			return Knit.GetControllers()
		end)
		if ok and type(ctrls) == "table" then
			for name, ctrl in pairs(ctrls) do
				visit(name, ctrl)
			end
		end
	end
	if type(Knit.Controllers) == "table" then
		for name, ctrl in pairs(Knit.Controllers) do
			visit(name, ctrl)
		end
	end
	for _, name in ipairs(KNIT_PET_CONTROLLER_NAMES) do
		if not seen[name] and type(Knit.GetController) == "function" then
			local ok, ctrl = pcall(function()
				return Knit.GetController(name)
			end)
			if ok then
				visit(name, ctrl)
			end
		end
	end
end

local function tryTriggerPetInventoryLoad(ctrl)
	if type(ctrl) ~= "table" then
		return
	end
	for _, method in ipairs(KNIT_PET_LOAD_METHODS) do
		local fn = ctrl[method]
		if type(fn) == "function" then
			pcall(function()
				fn(ctrl)
			end)
			pcall(function()
				fn(ctrl, false)
			end)
		end
	end
end

local function mergePetsIntoCache(pets)
	if type(pets) ~= "table" then
		return 0
	end
	local added = 0
	local before = 0
	for _ in pairs(knitPetCache) do
		before = before + 1
	end
	if #pets > 0 then
		for _, pet in ipairs(pets) do
			if isKnitPetRecord(pet, nil) then
				ingestPetRecord(pet)
			end
		end
	else
		for key, pet in pairs(pets) do
			if type(pet) == "table" then
				local uidHint = looksLikeUidKey(key) and key or nil
				if isKnitPetRecord(pet, uidHint) then
					ingestPetRecord(pet, uidHint)
				elseif uidHint and readPetField(pet, "id", "Id", "petId") then
					ingestPetRecord(pet, uidHint)
				end
			end
		end
	end
	local after = 0
	for _ in pairs(knitPetCache) do
		after = after + 1
	end
	return after - before
end

local knitPetSyncSource = nil
local knitPetFullSyncAttempted = false

local function fetchDataControllerPetPools()
	local Knit = getKnitModule()
	if not Knit or type(Knit.GetController) ~= "function" then
		return nil, nil, 0
	end
	local ok, ctrl = pcall(function()
		return Knit.GetController("DataController")
	end)
	if not ok or type(ctrl) ~= "table" then
		return nil, nil, 0
	end
	local cached = readPetField(ctrl, "CachedData", "cachedData", "Cache", "cache")
	if type(cached) ~= "table" then
		return nil, nil, 0
	end
	local playerData = cached.PlayerData or cached.playerData
	if type(playerData) ~= "table" then
		return nil, nil, 0
	end
	local userId = tostring(LocalPlayer.UserId)
	local myData = playerData[userId] or playerData[LocalPlayer.UserId]
	if type(myData) ~= "table" then
		for k, v in pairs(playerData) do
			if type(v) == "table" and tostring(k) == userId then
				myData = v
				break
			end
		end
	end
	if type(myData) ~= "table" then
		return nil, nil, 0
	end
	local petsRoot = myData.Pets or myData.pets
	if type(petsRoot) ~= "table" then
		return nil, nil, 0
	end

	local merged = {}
	local poolParts = {}
	local total = 0
	for poolName, pool in pairs(petsRoot) do
		if type(pool) == "table" then
			local score = scoreTableAsPetBag(pool)
			if score > 0 then
				total = total + score
				table.insert(poolParts, tostring(poolName) .. "=" .. score)
				for key, pet in pairs(pool) do
					if type(pet) == "table" then
						local uidHint = looksLikeUidKey(key) and key or nil
						if isKnitPetRecord(pet, uidHint) or (uidHint and readPetField(pet, "id", "Id", "petId")) then
							local petUid = uidHint or readPetField(pet, "uid", "UID", "Uuid")
							if petUid then
								merged[tostring(petUid)] = pet
							end
						end
					end
				end
			end
		end
	end
	if not next(merged) then
		return nil, nil, 0
	end
	table.sort(poolParts)
	local source = "DataController.PlayerData.Pets [" .. table.concat(poolParts, ", ") .. "]"
	return merged, source, total
end

local function syncKnitPetCacheFromKnit(opts)
	opts = opts or {}
	ensurePetListeners()
	local sources = {}

	local dcPets, dcSource, dcScore = fetchDataControllerPetPools()
	if dcPets then
		mergePetsIntoCache(dcPets)
		sources[dcSource or "DataController"] = dcScore
		knitPetSyncSource = dcSource
	end

	local cachedCount = 0
	for _ in pairs(knitPetCache) do
		cachedCount = cachedCount + 1
	end
	if cachedCount >= 50 then
		local sourceParts = {}
		for name, score in pairs(sources) do
			table.insert(sourceParts, type(score) == "number" and (name .. "(" .. score .. ")") or name)
		end
		table.sort(sourceParts)
		if #sourceParts > 0 then
			knitPetSyncSource = table.concat(sourceParts, ", ")
		end
		local n = 0
		for _ in pairs(knitPetCache) do
			n = n + 1
		end
		return n
	end

	local best = { count = 0, bag = nil, path = "" }
	local seenScan = {}

	local function scanRoot(root, path)
		if type(root) ~= "table" then
			return
		end
		findLargestPetBag(root, path, 0, seenScan, best)
	end

	foreachKnitController(function(name, ctrl)
		if not opts.skipTrigger and (name:find("PetInv", 1, true) or name:find("Pet", 1, true)) then
			tryTriggerPetInventoryLoad(ctrl)
		end
		for _, key in ipairs(KNIT_PET_TABLE_KEYS) do
			local bag = ctrl[key]
			if type(bag) == "table" then
				mergePetsIntoCache(bag)
				if scoreTableAsPetBag(bag) > 0 then
					sources[name .. "." .. key] = true
				end
			end
		end
		for _, method in ipairs(KNIT_PET_FETCH_METHODS) do
			local fn = ctrl[method]
			if type(fn) == "function" then
				local okCall, res = pcall(function()
					return fn(ctrl)
				end)
				if okCall then
					mergePetsIntoCache(res)
					sources[name .. "." .. method] = true
				end
			end
		end
		local found = {}
		collectKnitPetsDeep(ctrl, found, 0, {})
		for _, pet in pairs(found) do
			ingestPetRecord(pet)
		end
		if next(found) then
			sources[name] = true
		end
		scanRoot(ctrl, name)
	end)

	local Knit = getKnitModule()
	if Knit and type(Knit.GetService) == "function" then
		local okSvc, petInvSvc = pcall(function()
			return Knit.GetService("PetInvService")
		end)
		if okSvc and type(petInvSvc) == "table" then
			for _, method in ipairs({ "GetPets", "GetInventory", "GetAllPets", "GetEquippedPets" }) do
				local fn = petInvSvc[method]
				if type(fn) == "function" then
					local okCall, res = pcall(function()
						return fn(petInvSvc)
					end)
					if okCall then
						mergePetsIntoCache(res)
						sources["PetInvService." .. method] = true
					end
				end
			end
		end
	end
	local petInvFolder = ReplicatedStorage:FindFirstChild("Packages")
		and ReplicatedStorage.Packages:FindFirstChild("Knit")
		and ReplicatedStorage.Packages.Knit:FindFirstChild("Services")
		and ReplicatedStorage.Packages.Knit.Services:FindFirstChild("PetInvService")
	local rfFolder = petInvFolder and petInvFolder:FindFirstChild("RF")
	if rfFolder then
		for _, rf in ipairs(rfFolder:GetChildren()) do
			if rf:IsA("RemoteFunction") then
				local n = rf.Name:lower()
				if n:find("pet", 1, true) and (n:find("get", 1, true) or n:find("list", 1, true) or n:find("all", 1, true)) then
					local okCall, res = pcall(function()
						return rf:InvokeServer()
					end)
					if okCall then
						ingestPetPayload(res)
						sources["RF." .. rf.Name] = true
					end
				end
			end
		end
	end

	local playerScripts = LocalPlayer:FindFirstChild("PlayerScripts")
	if playerScripts then
		for _, desc in playerScripts:GetDescendants() do
			if desc:IsA("ModuleScript") then
				local n = desc.Name:lower()
				if n:find("pet", 1, true) or n:find("inv", 1, true) then
					local okReq, mod = pcall(require, desc)
					if okReq and type(mod) == "table" then
						scanRoot(mod, desc:GetFullName())
					end
				end
			end
		end
	end

	local sharedRoots = {
		ReplicatedStorage:FindFirstChild("Shared"),
		ReplicatedStorage:FindFirstChild("Modules"),
		ReplicatedStorage:FindFirstChild("Assets"),
	}
	for _, root in ipairs(sharedRoots) do
		if root then
			for _, desc in root:GetDescendants() do
				if desc:IsA("ModuleScript") then
					local n = desc.Name:lower()
					if n:find("pet", 1, true) or n:find("inv", 1, true) then
						local okReq, mod = pcall(require, desc)
						if okReq and type(mod) == "table" then
							scanRoot(mod, desc:GetFullName())
						end
					end
				end
			end
		end
	end
	if best.count >= 5 and best.bag then
		mergePetsIntoCache(best.bag)
		sources["largestBag:" .. best.path .. "(" .. best.count .. ")"] = true
	end

	local sourceParts = {}
	for name in pairs(sources) do
		table.insert(sourceParts, name)
	end
	table.sort(sourceParts)
	if #sourceParts > 0 then
		knitPetSyncSource = table.concat(sourceParts, ", ")
	elseif next(knitPetCache) then
		knitPetSyncSource = "PetService event cache"
	end
	local n = 0
	for _ in pairs(knitPetCache) do
		n = n + 1
	end
	return n
end

local FUSE_TARGET_RANKS = { "E", "D", "C", "B" }
local ASCEND_TO_RANK = { "E", "D", "C", "B", "A", "S", "SS", "SSS" }

local function getPetRank(pet)
	if not isKnitPetRecord(pet, nil) then
		return "?"
	end
	local rank = readPetField(pet, "rank", "Rank", "tier", "Tier", "grade", "Grade")
	if rank ~= nil and rank ~= "" then
		return tostring(rank):upper()
	end
	local ascend = tonumber(readPetField(pet, "ascend", "Ascend", "Ascension", "ascension"))
	if ascend ~= nil and ASCEND_TO_RANK[ascend + 1] then
		return ASCEND_TO_RANK[ascend + 1]
	end
	return "?"
end

local function isNoMutation(mut)
	if mut == nil or mut == false then
		return true
	end
	local s = tostring(mut):upper()
	return s == "" or s == "MU0" or s == "0" or s == "NONE" or s == "NIL" or s == "FALSE"
end

local function petHasTraits(pet)
	local traits = readPetField(pet, "traits", "Traits", "trait", "Trait")
	if traits == nil then
		return false
	end
	if type(traits) ~= "table" then
		return traits ~= "" and traits ~= false
	end
	for _, v in pairs(traits) do
		if v ~= nil and v ~= false and v ~= "" then
			return true
		end
	end
	return false
end

local function formatKnitPetLine(index, pet, nickname)
	local parts = {}
	if nickname and nickname ~= "" then
		table.insert(parts, "name=" .. tostring(nickname))
	end
	local rank = getPetRank(pet)
	table.insert(parts, "rank=" .. rank)
	for _, key in ipairs({ "uid", "id", "mutation", "ascend", "level", "traits" }) do
		local v = pet[key]
		if v ~= nil then
			table.insert(parts, key .. "=" .. valueToLogString(v))
		end
	end
	return ("%d. %s"):format(index, table.concat(parts, " "))
end

local function isPlainKnitPet(pet)
	if not isKnitPetRecord(pet, nil) then
		return false
	end
	if not isNoMutation(readPetField(pet, "mutation", "Mutation", "mut", "Mut")) then
		return false
	end
	if petHasTraits(pet) then
		return false
	end
	return true
end

local function canAutoFuseRank(rank)
	rank = tostring(rank or "?"):upper()
	for _, r in ipairs(FUSE_TARGET_RANKS) do
		if r == rank then
			return true
		end
	end
	return false
end

local function getPetFuseBlockReason(pet)
	if not isKnitPetRecord(pet, nil) then
		return "not a pet record"
	end
	local species = tostring(readPetField(pet, "id", "Id", "petId") or "?")
	local uid = tostring(readPetField(pet, "uid", "UID") or "?")
	local shortUid = #uid > 8 and uid:sub(1, 8) .. "…" or uid
	if not isNoMutation(readPetField(pet, "mutation", "Mutation", "mut", "Mut")) then
		return ("%s %s: has mutation %s"):format(
			species, shortUid, tostring(readPetField(pet, "mutation", "Mutation") or "?")
		)
	end
	if petHasTraits(pet) then
		return ("%s %s: has trait(s)"):format(species, shortUid)
	end
	local locked = readPetField(pet, "locked", "Locked", "isLocked")
	if locked == true or locked == 1 or tostring(locked or ""):lower() == "true" then
		return ("%s %s: locked"):format(species, shortUid)
	end
	local rank = getPetRank(pet)
	if not canAutoFuseRank(rank) then
		local ascend = readPetField(pet, "ascend", "Ascend")
		return ("%s %s: rank=%s ascend=%s (need E-D-C-B)"):format(
			species, shortUid, rank, tostring(ascend or "?")
		)
	end
	return nil
end

local function rankIndexFromRank(rank)
	for i, r in ipairs(ASCEND_TO_RANK) do
		if r == rank then
			return i
		end
	end
	return 99
end

local function summarizeFuseGroups(pets)
	local groups = {}
	local function addPet(pet)
		if not isKnitPetRecord(pet, nil) or not isPlainKnitPet(pet) then
			return
		end
		local rank = getPetRank(pet)
		if not canAutoFuseRank(rank) then
			return
		end
		local species = tostring(readPetField(pet, "id", "Id") or "?")
		local key = species .. " / rank " .. rank
		if not groups[key] then
			groups[key] = { count = 0, uids = {} }
		end
		groups[key].count = groups[key].count + 1
		if pet.uid and #groups[key].uids < 6 then
			local uid = readPetField(pet, "uid", "UID")
			if uid then
				table.insert(groups[key].uids, tostring(uid))
			end
		end
	end
	if #pets > 0 then
		for _, pet in ipairs(pets) do
			addPet(pet)
		end
	else
		for _, pet in pairs(pets) do
			addPet(pet)
		end
	end
	local keys = {}
	for key in pairs(groups) do
		table.insert(keys, key)
	end
	table.sort(keys)
	return groups, keys
end

local function knitPetCacheCount()
	local n = 0
	for _ in pairs(knitPetCache) do
		n = n + 1
	end
	return n
end

local function fetchKnitPets()
	ensurePetListeners()
	syncKnitPetCacheFromKnit()

	if not knitPetFullSyncAttempted and knitPetCacheCount() < 20 then
		knitPetFullSyncAttempted = true
		syncKnitPetCacheFromKnit({ skipTrigger = false })
		task.wait(0.4)
		syncKnitPetCacheFromKnit({ skipTrigger = true })
	end

	if next(knitPetCache) then
		return knitPetCache, knitPetSyncSource or "Knit client (no UI)"
	end

	local pets = nil
	local source = nil
	local Knit = getKnitModule()
	if Knit and type(Knit.GetController) == "function" then
		for _, ctrlName in ipairs(KNIT_PET_CONTROLLER_NAMES) do
			local okCtrl, ctrl = pcall(function()
				return Knit.GetController(ctrlName)
			end)
			if okCtrl and type(ctrl) == "table" then
				pets = findKnitPetTable(ctrl)
				if pets then
					source = "Knit.GetController(" .. ctrlName .. ")"
					break
				end
			end
		end
	end
	if not pets then
		for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
			if desc:IsA("ModuleScript") and desc.Name:find("PetInv", 1, true) then
				local okReq, mod = pcall(require, desc)
				if okReq and type(mod) == "table" then
					pets = findKnitPetTable(mod)
					if pets then
						source = desc:GetFullName()
						break
					end
				end
			end
		end
	end
	if pets then
		mergePetsIntoCache(pets)
		if next(knitPetCache) then
			knitPetSyncSource = source
			return knitPetCache, source
		end
	end
	return nil, nil
end

local function isFuseEligiblePet(pet)
	return getPetFuseBlockReason(pet) == nil
end

local function countPets(pets)
	if not pets then
		return 0
	end
	local n = 0
	for _, pet in pairs(pets) do
		if isKnitPetRecord(pet, nil) then
			n = n + 1
		end
	end
	return n
end

local function countEligibleFusePets(pets)
	if not pets then
		return 0
	end
	local n = 0
	for _, pet in pairs(pets) do
		if isFuseEligiblePet(pet) then
			n = n + 1
		end
	end
	return n
end

local function getRankUpRemote()
	local svc = ReplicatedStorage:FindFirstChild("Packages")
		and ReplicatedStorage.Packages:FindFirstChild("Knit")
		and ReplicatedStorage.Packages.Knit:FindFirstChild("Services")
		and ReplicatedStorage.Packages.Knit.Services:FindFirstChild("PetInvService")
	if not svc then
		return nil
	end
	local rfFolder = svc:FindFirstChild("RF")
	return rfFolder and rfFolder:FindFirstChild("RankUp")
end

local rankUpMethodId = nil

local function clearKnitPetCache()
	for uid in pairs(knitPetCache) do
		knitPetCache[uid] = nil
	end
end

local function refreshKnitPetCacheFromDataController()
	clearKnitPetCache()
	local dcPets, dcSource = fetchDataControllerPetPools()
	if dcPets then
		mergePetsIntoCache(dcPets)
		if dcSource then
			knitPetSyncSource = dcSource
		end
		return knitPetCacheCount()
	end
	syncKnitPetCacheFromKnit({ skipTrigger = true })
	return knitPetCacheCount()
end

local function invokeRankUp(uids, petRecords)
	local u1, u2, u3 = uids[1], uids[2], uids[3]
	if not u1 or not u2 or not u3 then
		return false, "need 3 uids"
	end

	local rf = getRankUpRemote()
	if not rf then
		return false, "PetInvService.RF.RankUp not found"
	end

	local Knit = getKnitModule()

	local function tryCall(methodId, fn)
		local ok, res = pcall(fn)
		if ok and res ~= false then
			rankUpMethodId = methodId
			return true, res
		end
		return false, res
	end

	local function callCached()
		if rankUpMethodId == "rf3" then
			return tryCall("rf3", function()
				return rf:InvokeServer(u1, u2, u3)
			end)
		elseif rankUpMethodId == "rfTable" then
			return tryCall("rfTable", function()
				return rf:InvokeServer({ u1, u2, u3 })
			end)
		elseif rankUpMethodId == "knit3" and Knit then
			return tryCall("knit3", function()
				return Knit.GetService("PetInvService"):RankUp(u1, u2, u3)
			end)
		elseif rankUpMethodId == "knitTable" and Knit then
			return tryCall("knitTable", function()
				return Knit.GetService("PetInvService"):RankUp({ u1, u2, u3 })
			end)
		end
		return false, "cached method unavailable"
	end

	if rankUpMethodId then
		local ok, res = callCached()
		if ok then
			return true, res
		end
		rankUpMethodId = nil
	end

	local attempts = {
		{ "rf3", function()
			return rf:InvokeServer(u1, u2, u3)
		end },
		{ "rfTable", function()
			return rf:InvokeServer({ u1, u2, u3 })
		end },
	}
	if Knit and type(Knit.GetService) == "function" then
		table.insert(attempts, { "knit3", function()
			return Knit.GetService("PetInvService"):RankUp(u1, u2, u3)
		end })
		table.insert(attempts, { "knitTable", function()
			return Knit.GetService("PetInvService"):RankUp({ u1, u2, u3 })
		end })
	end

	local lastErr = "RankUp failed"
	for _, entry in ipairs(attempts) do
		local ok, res = tryCall(entry[1], entry[2])
		if ok then
			return true, res
		end
		lastErr = tostring(res)
	end
	return false, lastErr
end

local function pickFuseTriple(pets, rank)
	local bySpecies = {}
	for _, pet in pairs(pets or {}) do
		if isKnitPetRecord(pet, nil) and isFuseEligiblePet(pet) and getPetRank(pet) == rank then
			local species = tostring(readPetField(pet, "id", "Id") or "?")
			local uid = readPetField(pet, "uid", "UID")
			if not bySpecies[species] then
				bySpecies[species] = {}
			end
			table.insert(bySpecies[species], { uid = tostring(uid), pet = pet })
		end
	end
	local speciesList = {}
	for species in pairs(bySpecies) do
		table.insert(speciesList, species)
	end
	table.sort(speciesList)
	for _, species in ipairs(speciesList) do
		local entries = bySpecies[species]
		if #entries >= 3 then
			return species, rank,
				{ entries[1].uid, entries[2].uid, entries[3].uid },
				{ entries[1].pet, entries[2].pet, entries[3].pet }
		end
	end
	return nil
end

local AUTO_FUSE_DELAY_SEC = 1
local autoFuseRunning = false
local autoFuseStatusCallback = nil

setAutoFuseStatusHandler = function(callback)
	autoFuseStatusCallback = callback
end

local function setAutoFuseStatus(msg)
	appendFuseDiscoveryLog("[AutoFuse] " .. msg)
	warn("[BloxMonster AutoFuse]", msg)
	if autoFuseStatusCallback then
		autoFuseStatusCallback(msg)
	end
end

startAutoFuse = function()
	if autoFuseRunning then
		setAutoFuseStatus("Already running – press Stop first")
		return
	end
	autoFuseRunning = true
	setAutoFuseStatus("Starting…")
	task.spawn(function()
		local ok, err = pcall(function()
			ensurePetListeners()
			local totalFused = 0
			setAutoFuseStatus("Started – plain pets E→D→C→B→A")
			while autoFuseRunning do
				local pets, source = fetchKnitPets()
				local total = countPets(pets)
				if total == 0 then
					for _ = 1, 5 do
						if not autoFuseRunning then
							break
						end
						setAutoFuseStatus("Waiting for pet data from game…")
						task.wait(1)
						pets, source = fetchKnitPets()
						total = countPets(pets)
						if total > 0 then
							break
						end
					end
				end
				if not pets or total == 0 then
					setAutoFuseStatus("No pets found – open inventory once, Dump Knit pets, then auto-fuse")
					break
				end
				local eligible = countEligibleFusePets(pets)
				if eligible < 3 then
					setAutoFuseStatus(("Only %d eligible plain E-D-C-B pets (from %d total)"):format(eligible, total))
					local shown = 0
					for _, pet in pairs(pets) do
						if isKnitPetRecord(pet, nil) and shown < 6 then
							local reason = getPetFuseBlockReason(pet)
							if reason then
								setAutoFuseStatus("Skip: " .. reason)
								shown = shown + 1
							end
						end
					end
					if total < 50 then
						setAutoFuseStatus(("Only %d pets cached (you have ~393?) – Dump Knit pets after opening inventory once"):format(total))
					else
						setAutoFuseStatus(("Source: %s"):format(source or "?"))
					end
					break
				end
				local fusedThisPass = false
				for _, rank in ipairs(FUSE_TARGET_RANKS) do
					if not autoFuseRunning then
						break
					end
					local species, _, uids, petRecords = pickFuseTriple(pets, rank)
					if uids then
						setAutoFuseStatus(("RankUp %s %s ×3 (%s)…"):format(species, rank, source or "?"))
						local fuseOk, res = invokeRankUp(uids, petRecords)
						if fuseOk then
							totalFused = totalFused + 1
							fusedThisPass = true
							local nextRank = ASCEND_TO_RANK[rankIndexFromRank(rank) + 1] or "?"
							setAutoFuseStatus(("Fused 3× %s %s → %s (%d total)"):format(
								species, rank, nextRank, totalFused
							))
							task.wait(AUTO_FUSE_DELAY_SEC)
							refreshKnitPetCacheFromDataController()
							break
						else
							setAutoFuseStatus("RankUp failed: " .. tostring(res))
							task.wait(0.5)
							refreshKnitPetCacheFromDataController()
							local retryOk, retryRes = invokeRankUp(uids, petRecords)
							if retryOk then
								totalFused = totalFused + 1
								fusedThisPass = true
								setAutoFuseStatus(("Fused on retry (%d total)"):format(totalFused))
								task.wait(AUTO_FUSE_DELAY_SEC)
								refreshKnitPetCacheFromDataController()
								break
							end
							setAutoFuseStatus("RankUp retry failed: " .. tostring(retryRes))
							task.wait(1)
						end
					end
				end
				if not fusedThisPass then
					if totalFused == 0 then
						setAutoFuseStatus(("Nothing to fuse (%d pets, %d eligible – need 3× same id+rank)"):format(
							total, eligible
						))
						break
					end
					setAutoFuseStatus(("Paused – %d fusion(s) done, nothing left this pass"):format(totalFused))
					break
				end
			end
		end)
		if not ok then
			setAutoFuseStatus("Error: " .. tostring(err))
		end
		autoFuseRunning = false
	end)
end

stopAutoFuse = function()
	autoFuseRunning = false
	setAutoFuseStatus("Stopped")
end

dumpKnitPetInventoryText = function()
	local lines = {
		"=== Knit pet inventory ===",
		"rank=E/D/C… | uid=fuse id | id=species | mutation MU0=none | traits{}=none",
		"RankUp remote: PetInvService.RF.RankUp",
		"",
	}
	local pets, source = fetchKnitPets()

	if not pets then
		table.insert(lines, "Knit pet list not found on client.")
		table.insert(lines, "Pets load on join via PetService – wait a few seconds after spawn, then dump again.")
		table.insert(lines, "(Opening inventory UI is not required.)")
		table.insert(lines, "")
		local uiText, rowCount = dumpPlayerInventoryText()
		return table.concat(lines, "\n") .. "\n" .. uiText, rowCount
	end

	table.insert(lines, "Source: " .. tostring(source))
	table.insert(lines, "")

	local count = 0
	local plainCount = 0
	local index = 0
	if #pets > 0 then
		for _, pet in ipairs(pets) do
			index = index + 1
			count = count + 1
			if isPlainKnitPet(pet) then
				plainCount = plainCount + 1
			end
			if index <= 150 then
				table.insert(lines, formatKnitPetLine(index, pet, nil))
			end
		end
	else
		for nickname, pet in pairs(pets) do
			if type(pet) == "table" then
				index = index + 1
				count = count + 1
				if isPlainKnitPet(pet) then
					plainCount = plainCount + 1
				end
				if index <= 150 then
					table.insert(lines, formatKnitPetLine(index, pet, nickname))
				end
			end
		end
	end

	if count > 150 then
		table.insert(lines, ("... +%d more pets"):format(count - 150))
	end
	table.insert(lines, "")
	local eligibleCount = countEligibleFusePets(pets)
	table.insert(lines, ("Total: %d pet(s), %d plain (MU0 + traits{}), %d eligible to fuse (E-D-C-B)"):format(
		count, plainCount, eligibleCount
	))

	local groups, groupKeys = summarizeFuseGroups(pets)
	table.insert(lines, "")
	table.insert(lines, "=== Plain fuse groups (E→D→C→B→A, need 3 same id+rank) ===")
	if #groupKeys == 0 then
		table.insert(lines, "  (none – need plain E/D/C/B pets with same species id)")
	else
		for _, key in ipairs(groupKeys) do
			local g = groups[key]
			local fuses = math.floor(g.count / 3)
			local uidPreview = #g.uids > 0 and (" uids=" .. table.concat(g.uids, ", ")) or ""
			table.insert(lines, ("  %s: %d pets → %d fuse(s)%s"):format(key, g.count, fuses, uidPreview))
		end
	end

	return table.concat(lines, "\n"), count
end

scanFuseRelatedRemotesText = function()
	local petText, petCount = scanPetServiceText()
	local remotes = collectFuseRelatedRemotes()
	local lines = {
		"",
		"=== Other fuse/inventory remotes ===",
		("Found %d remote(s)."):format(#remotes),
		"",
	}
	if #remotes == 0 then
		table.insert(lines, "  (none)")
	else
		for _, remote in ipairs(remotes) do
			table.insert(lines, ("  %s (%s)"):format(remote:GetFullName(), remote.ClassName))
		end
	end
	local text = petText .. table.concat(lines, "\n")
	return text, petCount + #remotes
end

local function listGameObjects(nameFilter)
	local filter = (type(nameFilter) == "string" and nameFilter ~= "") and nameFilter:lower() or nil
	local function matches(inst)
		if not filter then
			return true
		end
		local name = (inst.Name or ""):lower()
		local full = (inst:GetFullName() or ""):lower()
		return name:find(filter, 1, true) or full:find(filter, 1, true)
	end
	local list = {}
	local function scan(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if matches(child) then
				table.insert(list, child:GetFullName())
			end
			scan(child)
		end
	end
	for _, service in ipairs({ Workspace, PlayerGui, ReplicatedStorage }) do
		pcall(function()
			if matches(service) then
				table.insert(list, service:GetFullName())
			end
			scan(service)
		end)
	end
	table.sort(list)
	return list
end

local function readGuiLabels(parent, labelNames)
	local labels = {}
	for _, name in ipairs(labelNames) do
		local el = parent:FindFirstChild(name, true)
		if el and el:IsA("GuiObject") and el.Text and el.Text ~= "" then
			labels[name] = el.Text
		end
	end
	return labels
end

local function formatPetRow(labels, idLabels)
	local order = { "NpcName", "PetName", "Name", "MonsterName", "Rarity", "Rank", "Tier", "Mutation", "Trait", "Shiny", "Level" }
	local parts = {}
	for _, key in ipairs(order) do
		if labels[key] and labels[key] ~= "" then
			table.insert(parts, key .. "=" .. labels[key])
		end
	end
	for _, key in ipairs(idLabels or INVENTORY_ID_LABELS) do
		if labels[key] and labels[key] ~= "" then
			table.insert(parts, key .. "=" .. labels[key])
		end
	end
	return table.concat(parts, " | ")
end

local function readFuseFrameContent()
	local gui = LocalPlayer:FindFirstChild("PlayerGui")
	if not gui then
		return "PlayerGui not found."
	end
	local mainUI = gui:FindFirstChild("MainUI") or gui:FindFirstChild("Main")
	if not mainUI then
		return "MainUI not found. Open the game menu first."
	end
	local menus = mainUI:FindFirstChild("Menus") or mainUI
	local fuseFrame = menus:FindFirstChild("FuseFrame") or mainUI:FindFirstChild("FuseFrame", true)
	if not fuseFrame then
		return "FuseFrame not found. Open the Fuse menu in-game first."
	end
	local frame = fuseFrame:FindFirstChild("Frame") or fuseFrame
	local out = { "=== Fuse UI (" .. fuseFrame:GetFullName() .. ") ===", "" }

	local possibleFrame = frame:FindFirstChild("PossibleFrame")
	if possibleFrame then
		table.insert(out, "=== Possible (outcomes) ===")
		local count = 0
		for _, child in ipairs(possibleFrame:GetChildren()) do
			if child:FindFirstChild("NpcName", true) or child:FindFirstChild("PetName", true) then
				count = count + 1
				local labels = readGuiLabels(child, { "NpcName", "PetName", "Mutation", "Rarity", "Rank", "Trait", "Chance" })
				table.insert(out, ("  %d. %s"):format(count, formatPetRow(labels)))
			end
		end
		if count == 0 then
			table.insert(out, "  (no rows found)")
		end
		table.insert(out, "")
	end

	local bringFrame = frame:FindFirstChild("BringFrame") or frame:FindFirstChild("SelectedFrame")
	if bringFrame then
		table.insert(out, "=== Selected for fuse ===")
		local count = 0
		for _, child in ipairs(bringFrame:GetChildren()) do
			if child:FindFirstChild("NpcName", true) or child:FindFirstChild("PetName", true) then
				count = count + 1
				local labels = readGuiLabels(child, { "NpcName", "PetName", "Mutation", "Rarity", "Rank", "Trait" })
				table.insert(out, ("  %d. %s"):format(count, formatPetRow(labels)))
			end
		end
		if count == 0 then
			table.insert(out, "  (no rows found)")
		end
	end
	return table.concat(out, "\n")
end

local function tableToString(t, depth, maxDepth)
	depth = depth or 0
	maxDepth = maxDepth or 4
	if depth > maxDepth then
		return "(max depth)"
	end
	if type(t) ~= "table" then
		return tostring(t)
	end
	local lines = {}
	for k, v in pairs(t) do
		local keyStr = type(k) == "string" and k or ("[" .. tostring(k) .. "]")
		if type(v) == "table" then
			table.insert(lines, ("%s%s = { %s }"):format(string.rep("  ", depth), keyStr, tableToString(v, depth + 1, maxDepth)))
		else
			table.insert(lines, ("%s%s = %s"):format(string.rep("  ", depth), keyStr, tostring(v)))
		end
	end
	return table.concat(lines, "\n")
end

local function findFuseDataOnClient()
	local out = { "=== Client fuse data search ===", "" }
	table.insert(out, "=== ReplicatedStorage ModuleScripts (name contains fuse) ===")
	for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
		if desc:IsA("ModuleScript") and desc.Name:lower():find("fuse", 1, true) then
			local ok, result = pcall(function()
				return require(desc)
			end)
			if ok and type(result) == "table" then
				local keyCount = 0
				for _ in pairs(result) do
					keyCount = keyCount + 1
				end
				table.insert(out, ("[%s] table (%d keys):"):format(desc:GetFullName(), keyCount))
				local preview = tableToString(result, 0, 3)
				if #preview > 4000 then
					preview = preview:sub(1, 4000) .. "\n... (truncated)"
				end
				table.insert(out, preview)
			elseif ok then
				table.insert(out, ("[%s] => %s"):format(desc:GetFullName(), tostring(result)))
			else
				table.insert(out, ("[%s] require error: %s"):format(desc:GetFullName(), tostring(result)))
			end
		end
	end
	table.insert(out, "")
	table.insert(out, readFuseFrameContent())
	table.insert(out, "")
	table.insert(out, "--- End fuse data search ---")
	return table.concat(out, "\n")
end

local function isInventoryLikeGui(inst)
	if not inst:IsA("GuiObject") then
		return false
	end
	local lower = inst.Name:lower()
	for _, kw in ipairs(INVENTORY_UI_KEYWORDS) do
		if lower:find(kw, 1, true) then
			return true
		end
	end
	return false
end

local function looksLikePetRow(frame)
	if not frame:IsA("GuiObject") then
		return false
	end
	return frame:FindFirstChild("NpcName", true)
		or frame:FindFirstChild("PetName", true)
		or frame:FindFirstChild("MonsterName", true)
end

local function collectRowAttributes(frame)
	local attrs = {}
	for _, name in ipairs(frame:GetAttributeNames()) do
		attrs[name] = frame:GetAttribute(name)
	end
	return attrs
end

dumpPlayerInventoryText = function()
	local out = {
		"=== Inventory dump (UI scan) ===",
		"Open your pet inventory in-game first for best results.",
		"",
	}
	local gui = LocalPlayer:FindFirstChild("PlayerGui")
	if not gui then
		return "PlayerGui not found."
	end

	local uiPaths = {}
	for _, desc in ipairs(gui:GetDescendants()) do
		if isInventoryLikeGui(desc) then
			table.insert(uiPaths, desc:GetFullName())
		end
	end
	table.sort(uiPaths)
	table.insert(out, ("=== PlayerGui paths matching inventory keywords (%d) ==="):format(#uiPaths))
	if #uiPaths == 0 then
		table.insert(out, "  (none – open pet inventory, then dump again)")
	else
		for i, path in ipairs(uiPaths) do
			if i <= 40 then
				table.insert(out, "  " .. path)
			end
		end
		if #uiPaths > 40 then
			table.insert(out, ("  ... +%d more"):format(#uiPaths - 40))
		end
	end
	table.insert(out, "")

	local rows = {}
	local seenRows = {}
	for _, desc in ipairs(gui:GetDescendants()) do
		if looksLikePetRow(desc) then
			local key = desc:GetFullName()
			if not seenRows[key] then
				seenRows[key] = true
				local labels = readGuiLabels(desc, INVENTORY_ROW_LABELS)
				for _, idName in ipairs(INVENTORY_ID_LABELS) do
					local idEl = desc:FindFirstChild(idName, true)
					if idEl and idEl:IsA("GuiObject") and idEl.Text and idEl.Text ~= "" then
						labels[idName] = idEl.Text
					end
				end
				local attrs = collectRowAttributes(desc)
				for k, v in pairs(attrs) do
					if v ~= nil and tostring(v) ~= "" then
						labels["@" .. k] = tostring(v)
					end
				end
				if next(labels) then
					table.insert(rows, {
						path = key,
						text = formatPetRow(labels),
					})
				end
			end
		end
	end
	table.sort(rows, function(a, b)
		return a.text < b.text
	end)
	table.insert(out, ("=== Pet rows from UI (%d) ==="):format(#rows))
	if #rows == 0 then
		table.insert(out, "  (no NpcName/PetName rows found)")
	else
		for i, row in ipairs(rows) do
			if i <= 120 then
				table.insert(out, ("  %d. %s"):format(i, row.text))
				table.insert(out, ("      %s"):format(row.path))
			end
		end
		if #rows > 120 then
			table.insert(out, ("  ... +%d more rows"):format(#rows - 120))
		end
	end

	table.insert(out, "")
	table.insert(out, "=== ReplicatedStorage modules (pet/inventory) ===")
	local modCount = 0
	for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
		if desc:IsA("ModuleScript") then
			local n = desc.Name:lower()
			if n:find("pet", 1, true) or n:find("inventory", 1, true) then
				modCount = modCount + 1
				if modCount <= 25 then
					table.insert(out, "  " .. desc:GetFullName())
				end
			end
		end
	end
	if modCount == 0 then
		table.insert(out, "  (none found)")
	elseif modCount > 25 then
		table.insert(out, ("  ... +%d more modules"):format(modCount - 25))
	end

	local text = table.concat(out, "\n")
	return text, #rows
end

