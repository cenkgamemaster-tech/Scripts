local function formatPerkPayload(payload)
	if payload == nil then
		return "nil"
	end
	if type(payload) == "table" then
		local parts = {}
		for _, key in ipairs({
			"roomIndex", "RoomIndex", "DoorA", "DoorB", "doorA", "doorB",
		}) do
			if payload[key] ~= nil then
				table.insert(parts, key .. "=" .. tostring(payload[key]))
			end
		end
		if #parts > 0 then
			return "{" .. table.concat(parts, ", ") .. "}"
		end
	end
	local ok, text = pcall(formatRemoteResult, payload)
	return ok and text or tostring(payload)
end

local function isExactRarityLabelText(text)
	if text == nil or text == "" then
		return 0
	end
	local lower = tostring(text):lower():gsub("^%s+", ""):gsub("%s+$", "")
	for _, name in ipairs(CONTEST_PERK_RARITY_ORDERED) do
		if lower == name then
			return CONTEST_PERK_RARITY_RANK[name]
		end
		if lower:sub(1, #name + 1) == name .. " " or lower:sub(-#name - 1) == " " .. name then
			return CONTEST_PERK_RARITY_RANK[name]
		end
	end
	return 0
end

local function perkRarityRankFromString(text)
	if text == nil then
		return 0
	end
	if typeof(text) == "EnumItem" then
		return perkRarityRankFromString(text.Name)
	end
	if type(text) == "number" then
		if text >= 1 and text <= 5 then
			return math.floor(text)
		end
		return 0
	end
	local lower = tostring(text):lower()
	local asNum = tonumber(lower)
	if asNum and asNum >= 1 and asNum <= 5 then
		return math.floor(asNum)
	end
	local best = 0
	for _, name in ipairs(CONTEST_PERK_RARITY_ORDERED) do
		if lower:find(name, 1, true) then
			best = math.max(best, CONTEST_PERK_RARITY_RANK[name])
		end
	end
	return best
end

local function perkRarityFromOption(opt, depth)
	depth = depth or 0
	if depth > 4 then
		return 0
	end
	if type(opt) ~= "table" then
		return perkRarityRankFromString(opt)
	end
	local best = 0
	for _, field in ipairs(CONTEST_PERK_RARITY_FIELDS) do
		if opt[field] ~= nil then
			best = math.max(best, perkRarityRankFromString(opt[field]))
		end
	end
	if best > 0 then
		return best
	end
	for _, field in ipairs(CONTEST_PERK_NESTED_FIELDS) do
		local sub = opt[field]
		if type(sub) == "table" then
			best = math.max(best, perkRarityFromOption(sub, depth + 1))
		end
	end
	return best
end

local function findPerkEntryInTable(node, id, depth)
	depth = depth or 0
	if depth > 6 or type(node) ~= "table" then
		return nil
	end
	local direct = node[id]
	if type(direct) == "table" then
		return direct
	end
	local peNum = id:match("^PE(%d+)$")
	if peNum then
		local n = tonumber(peNum)
		if n and type(node[n]) == "table" then
			return node[n]
		end
	end
	for key, val in pairs(node) do
		if type(val) == "table" then
			if val.Id == id or val.id == id or val.PerkId == id or val.perkId == id
				or val.Key == id or val.key == id or val.Code == id or val.code == id
				or key == id or tostring(key) == id then
				return val
			end
			if peNum and (val.Index == tonumber(peNum) or val.index == tonumber(peNum)) then
				return val
			end
		end
	end
	for _, val in pairs(node) do
		if type(val) == "table" then
			local found = findPerkEntryInTable(val, id, depth + 1)
			if found then
				return found
			end
		end
	end
	return nil
end

local function loadSharedPerkData()
	if sharedPerkDataCache ~= nil then
		return sharedPerkDataCache or nil
	end
	sharedPerkDataCache = false
	local tryNames = {
		"Perks", "PerkConfig", "PerkConfigs", "PerkData", "DungeonPerks",
		"ContestPerks", "PerkDefinitions", "PerkTable",
	}
	for _, name in ipairs(tryNames) do
		local inst = ReplicatedStorage:FindFirstChild(name, true)
		if inst and inst:IsA("ModuleScript") then
			local ok, data = pcall(require, inst)
			if ok and type(data) == "table" then
				sharedPerkDataCache = data
				return data
			end
		end
	end
	for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
		if desc:IsA("ModuleScript") then
			local nameLower = desc.Name:lower()
			if nameLower:find("perk", 1, true)
				and not nameLower:find("service", 1, true)
				and not nameLower:find("door", 1, true) then
				local ok, data = pcall(require, desc)
				if ok and type(data) == "table" then
					for key in pairs(data) do
						if type(key) == "string" and key:match("^PE%d") then
							sharedPerkDataCache = data
							return data
						end
					end
				end
			end
		end
	end
	return nil
end

local function searchModulesForPerkId(id)
	if perkEntryCache[id] ~= nil then
		return perkEntryCache[id] or nil
	end
	local searchRoots = {}
	for _, name in ipairs({ "Assets", "Shared", "Config", "Modules", "Packages", "Data" }) do
		local root = ReplicatedStorage:FindFirstChild(name)
		if root then
			table.insert(searchRoots, root)
		end
	end
	if #searchRoots == 0 then
		table.insert(searchRoots, ReplicatedStorage)
	end
	for _, root in ipairs(searchRoots) do
		for _, desc in ipairs(root:GetDescendants()) do
			if desc:IsA("ModuleScript") then
				local ok, data = pcall(require, desc)
				if ok and type(data) == "table" then
					local entry = findPerkEntryInTable(data, id, 0)
					if entry then
						perkEntryCache[id] = entry
						return entry
					end
				end
			end
		end
	end
	perkEntryCache[id] = false
	return nil
end

local function rarityFromPayloadSlot(payload, slot)
	if type(payload) ~= "table" then
		return 0
	end
	local keySets = slot == "A"
		and { "DoorARarity", "doorARarity", "RarityA", "PerkA", "perkA", "A" }
		or { "DoorBRarity", "doorBRarity", "RarityB", "PerkB", "perkB", "B" }
	for _, key in ipairs(keySets) do
		local val = payload[key]
		if val ~= nil then
			local rank = perkRarityFromOption(type(val) == "table" and val or { Rarity = val, Tier = val })
			if rank > 0 then
				return rank
			end
		end
	end
	return 0
end

local function lookupPerkEntry(perkId)
	local id = tostring(perkId)
	if perkEntryCache[id] ~= nil then
		return perkEntryCache[id] or nil
	end
	local entry = nil
	for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
		if desc.Name == id then
			if desc:IsA("ModuleScript") then
				local ok, data = pcall(require, desc)
				if ok and type(data) == "table" then
					entry = data
					break
				end
			else
				entry = {
					Rarity = desc:GetAttribute("Rarity"),
					Tier = desc:GetAttribute("Tier"),
				}
				break
			end
		end
	end
	if not entry then
		local shared = loadSharedPerkData()
		if shared then
			entry = findPerkEntryInTable(shared, id, 0)
		end
	end
	if not entry then
		entry = searchModulesForPerkId(id)
	end
	perkEntryCache[id] = entry or false
	return entry
end

local function lookupPerkRarityFromId(perkId)
	if perkId == nil or perkId == "" then
		return 0
	end
	local id = tostring(perkId)
	if perkIdRarityCache[id] ~= nil then
		return perkIdRarityCache[id]
	end
	local rank = 0
	local entry = lookupPerkEntry(id)
	if entry then
		rank = perkRarityFromOption(entry)
	end
	if rank == 0 then
		for _, desc in ipairs(ReplicatedStorage:GetDescendants()) do
			if desc.Name == id then
				rank = math.max(rank, perkRarityRankFromString(desc:GetAttribute("Rarity")))
				rank = math.max(rank, perkRarityRankFromString(desc:GetAttribute("Tier")))
				rank = math.max(rank, perkRarityRankFromString(desc:GetAttribute("RarityTier")))
			end
		end
	end
	perkIdRarityCache[id] = rank
	return rank
end

local function describePerkIdLookup(perkId)
	local id = tostring(perkId or "")
	if id == "" then
		return "?"
	end
	local rank = lookupPerkRarityFromId(id)
	if rank > 0 then
		return ("%s=%s(%d)"):format(id, perkRankName(rank), rank)
	end
	return ("%s=config lookup failed"):format(id)
end

local function resolveDoorPerkRarity(perkId, payload, slot)
	local rank = 0
	if perkId then
		rank = lookupPerkRarityFromId(perkId)
	end
	if rank == 0 and payload and slot then
		rank = rarityFromPayloadSlot(payload, slot)
	end
	return rank
end

local function parsePerkDoorsReadyPayload(payload)
	if type(payload) ~= "table" then
		return nil
	end
	local specs = {
		{ idKey = "DoorA", partKey = "doorAPart", slot = "A" },
		{ idKey = "doorA", partKey = "doorAPart", slot = "A" },
		{ idKey = "DoorB", partKey = "doorBPart", slot = "B" },
		{ idKey = "doorB", partKey = "doorBPart", slot = "B" },
	}
	local seenSlot = {}
	local doors = {}
	for _, spec in ipairs(specs) do
		if not seenSlot[spec.slot] then
			local perkId = payload[spec.idKey]
			local part = payload[spec.partKey] or payload[spec.partKey:gsub("^d", "D")]
			if perkId ~= nil or part ~= nil then
				seenSlot[spec.slot] = true
				local rank = resolveDoorPerkRarity(perkId, payload, spec.slot)
				table.insert(doors, {
					slot = spec.slot,
					perkId = perkId and tostring(perkId) or nil,
					part = part,
					rarity = rank,
					text = perkId and tostring(perkId) or "",
					raritySource = rank > 0 and "config" or nil,
				})
			end
		end
	end
	if #doors < 2 then
		return nil
	end
	local function partPos(part)
		if not part then
			return nil
		end
		return getModelPosition(part) or (part:IsA("BasePart") and part.Position)
	end
	local pA, pB = partPos(doors[1].part), partPos(doors[2].part)
	if pA and pB then
		if pA.X <= pB.X then
			doors[1].door = 1
			doors[2].door = 2
		else
			doors[1].door = 2
			doors[2].door = 1
		end
	else
		doors[1].door = doors[1].slot == "A" and 1 or 2
		doors[2].door = doors[2].slot == "A" and 1 or 2
	end
	return doors
end

local function refreshParsedDoorRarities(doors, payload)
	if not doors then
		return
	end
	payload = payload or dungeonPerkPayload
	for _, d in ipairs(doors) do
		local rank = resolveDoorPerkRarity(d.perkId, payload, d.slot)
		d.rarity = rank
		d.raritySource = rank > 0 and "config" or "unknown"
	end
end

local function extractPerkOptions(payload)
	if type(payload) ~= "table" then
		return {}
	end
	local options = {}
	if type(payload[1]) == "table" and type(payload[2]) == "table" then
		options = { payload[1], payload[2] }
	elseif type(payload[1]) == "string" and type(payload[2]) == "string" then
		options = { { text = payload[1] }, { text = payload[2] } }
	elseif type(payload.doors) == "table" then
		options = payload.doors
	elseif type(payload.perks) == "table" then
		options = payload.perks
	elseif type(payload.options) == "table" then
		options = payload.options
	elseif type(payload.Choices) == "table" then
		options = payload.Choices
	elseif type(payload.choices) == "table" then
		options = payload.choices
	end
	if #options < 2 then
		for _, v in ipairs(payload) do
			if type(v) == "table" or type(v) == "string" then
				table.insert(options, type(v) == "string" and { text = v } or v)
			end
		end
	end
	if #options < 2 then
		for key, v in pairs(payload) do
			if type(v) == "table" and (v.Rarity or v.rarity or v.Name or v.name or v.Tier or v.tier) then
				table.insert(options, v)
			elseif type(key) == "string" and type(v) == "table" then
				local keyLower = key:lower()
				if keyLower:find("left", 1, true) or keyLower:find("door1", 1, true) or keyLower == "1" then
					v.door = 1
					table.insert(options, v)
				elseif keyLower:find("right", 1, true) or keyLower:find("door2", 1, true) or keyLower == "2" then
					v.door = 2
					table.insert(options, v)
				end
			end
		end
	end
	return options
end

local function findPerkOptionsDeep(node, out, depth, seen)
	depth = depth or 0
	if depth > 6 or type(node) ~= "table" then
		return
	end
	if seen[node] then
		return
	end
	seen[node] = true
	if type(node.Rarity) == "string" or type(node.rarity) == "string"
		or type(node.Tier) == "number" or type(node.tier) == "number"
		or type(node.Rarity) == "number" or type(node.rarity) == "number" then
		table.insert(out, node)
	end
	for _, v in pairs(node) do
		if type(v) == "table" then
			findPerkOptionsDeep(v, out, depth + 1, seen)
		end
	end
end

local function perkRarityRank(text)
	if text == nil then
		return 0
	end
	if type(text) == "table" then
		return perkRarityFromOption(text)
	end
	return perkRarityRankFromString(text)
end

local function getPerkOptionDoorIndex(opt, fallbackIndex)
	if type(opt) ~= "table" then
		return fallbackIndex
	end
	if type(opt.door) == "number" then
		if opt.door >= 1 and opt.door <= 2 then
			return opt.door
		end
		if opt.door >= 0 and opt.door <= 1 then
			return opt.door + 1
		end
	end
	for _, field in ipairs(CONTEST_PERK_DOOR_FIELDS) do
		local val = opt[field]
		if type(val) == "number" then
			if val >= 1 and val <= 2 then
				return val
			end
			if val >= 0 and val <= 1 then
				return val + 1
			end
		end
	end
	return fallbackIndex
end

local function perkRankName(rank)
	local names = {
		[0] = "?",
		[1] = "Uncommon",
		[2] = "Rare",
		[3] = "Epic",
		[4] = "Legendary",
		[5] = "Mythical",
	}
	return names[rank] or ("rank" .. tostring(rank))
end

local function getModelHumanoid(model)
	if not model then
		return nil
	end
	return model:FindFirstChildOfClass("Humanoid")
		or model:FindFirstChildWhichIsA("Humanoid", true)
end

local function getDungeonPetTargets()
	local ok, pets = pcall(getDungeonPets)
	if not ok or not pets then
		return {}
	end
	local out = {}
	for _, pet in ipairs(pets) do
		if pet.model and pet.model.Parent then
			local hum = getModelHumanoid(pet.model)
			if hum and hum.Health > 0 then
				table.insert(out, pet)
			end
		end
	end
	table.sort(out, function(a, b)
		return (a.distance or math.huge) < (b.distance or math.huge)
	end)
	return out
end

local function confirmDungeonFloorCleared(runId, timeoutSec)
	timeoutSec = timeoutSec or (DUNGEON_FLOOR_CLEAR_CONFIRM_SEC + 2)
	local deadline = wallClockSeconds() + timeoutSec
	local clearSince = nil
	while wallClockSeconds() < deadline do
		if not contestRunning or contestRunId ~= runId or dungeonRunEnded then
			return false
		end
		local count = #getDungeonPetTargets()
		if count == 0 then
			clearSince = clearSince or wallClockSeconds()
			if wallClockSeconds() - clearSince >= DUNGEON_FLOOR_CLEAR_CONFIRM_SEC then
				return true
			end
		else
			if clearSince then
				setContestStatus(("Floor not clear – %d pet(s) still alive"):format(count))
			end
			clearSince = nil
		end
		task.wait(DUNGEON_FLOOR_CLEAR_POLL_SEC)
	end
	return false
end

local function collectGuiTextBlob(guiObject)
	local parts = {}
	if guiObject:IsA("TextLabel") or guiObject:IsA("TextButton") then
		if guiObject.Text and guiObject.Text ~= "" then
			table.insert(parts, guiObject.Text)
		end
	end
	for _, child in ipairs(guiObject:GetDescendants()) do
		if child:IsA("TextLabel") or child:IsA("TextButton") then
			if child.Text and child.Text ~= "" then
				table.insert(parts, child.Text)
			end
		end
	end
	return table.concat(parts, " ")
end

local function scanPerkDoorCandidates(payload)
	payload = payload or dungeonPerkPayload
	local parsed = parsePerkDoorsReadyPayload(payload)
	if parsed then
		refreshParsedDoorRarities(parsed)
		return parsed
	end
	return {}
end

local function pickBestFromDoorList(doors, sourceTag)
	if not doors or #doors < 2 then
		return nil, nil, nil
	end
	local bySlot = {}
	for _, d in ipairs(doors) do
		if d.door == 1 or d.door == 2 then
			bySlot[d.door] = d
		end
	end
	local left, right = bySlot[1], bySlot[2]
	if not left or not right then
		left, right = doors[1], doors[2]
		left.door = 1
		right.door = 2
	end
	local detail = (" %s: door 1=%s(%d) id=%s [%s] vs door 2=%s(%d) id=%s [%s]"):format(
		sourceTag,
		perkRankName(left.rarity or 0), left.rarity or 0, left.perkId or "?", left.raritySource or "?",
		perkRankName(right.rarity or 0), right.rarity or 0, right.perkId or "?", right.raritySource or "?"
	)
	if (right.rarity or 0) > (left.rarity or 0) then
		return 2, right.rarity, detail .. " -> door 2"
	end
	if (left.rarity or 0) > (right.rarity or 0) then
		return 1, left.rarity, detail .. " -> door 1"
	end
	if (left.rarity or 0) > 0 then
		return 1, left.rarity, detail .. " -> same rarity, door 1"
	end
	return nil, 0, detail .. " -> rarity unknown"
end

local function pickBestPerkDoorFromPayload(payload)
	if type(payload) ~= "table" then
		return nil, nil, nil
	end
	local parsed = parsePerkDoorsReadyPayload(payload)
	if parsed then
		refreshParsedDoorRarities(parsed)
		return pickBestFromDoorList(parsed, "event")
	end
	return nil, nil, nil
end

local function pickBestPerkDoor()
	local payload = dungeonPerkPayload
	if dungeonPerkDoorsParsed then
		refreshParsedDoorRarities(dungeonPerkDoorsParsed)
		local door, rank, detail = pickBestFromDoorList(dungeonPerkDoorsParsed, "doors")
		if door and rank and rank > 0 then
			return door, rank, detail
		end
	end
	local door, rank, detail = pickBestPerkDoorFromPayload(payload)
	if door and rank and rank > 0 then
		return door, rank, detail
	end
	local doors = {}
	local scanOk, scanResult = pcall(scanPerkDoorCandidates, payload)
	if scanOk and type(scanResult) == "table" and #scanResult >= 2 then
		doors = scanResult
	end
	if #doors >= 2 then
		return pickBestFromDoorList(doors, "door parts")
	end
	local idA = dungeonPerkDoorsParsed and dungeonPerkDoorsParsed[1] and dungeonPerkDoorsParsed[1].perkId
	local idB = dungeonPerkDoorsParsed and dungeonPerkDoorsParsed[2] and dungeonPerkDoorsParsed[2].perkId
	return nil, 0, "perk rarity unknown – config lookup failed for " .. (idA or "?") .. " / " .. (idB or "?")
end

local function ensureDungeonEventHooks()
	if dungeonEventsHooked then
		return
	end
	dungeonEventsHooked = true
	local function onRoomChanged()
		dungeonRoomVersion = dungeonRoomVersion + 1
		contestInDungeon = true
		dungeonPerkReady = false
		setContestStatus("RoomChanged (next floor)")
	end
	local roomChanged = resolveDungeonRemote("RoomChanged", "RemoteEvent")
	if roomChanged then
		roomChanged.OnClientEvent:Connect(onRoomChanged)
		setContestStatus("Hooked RoomChanged: " .. roomChanged:GetFullName())
	else
		warn("[BloxMonster Contest] RoomChanged event not found under DungeonService")
	end
	local perkReady = resolveDungeonRemote("PerkDoorsReady", "RemoteEvent")
	if perkReady then
		perkReady.OnClientEvent:Connect(function(...)
			dungeonPerkVersion = dungeonPerkVersion + 1
			dungeonPerkReady = true
			dungeonPerkPayload = { ... }
			if select("#", ...) == 1 and type((...)) == "table" then
				dungeonPerkPayload = (...)
			end
			dungeonPerkDoorsParsed = parsePerkDoorsReadyPayload(dungeonPerkPayload)
			if dungeonPerkDoorsParsed then
				refreshParsedDoorRarities(dungeonPerkDoorsParsed)
			end
			setContestStatus(("PerkDoorsReady v%d: %s"):format(
				dungeonPerkVersion, formatPerkPayload(dungeonPerkPayload)
			))
			if dungeonPerkDoorsParsed then
				local _, _, detail = pickBestFromDoorList(dungeonPerkDoorsParsed, "ready")
				if detail then
					setContestStatus("PerkDoorsReady rarities:" .. detail)
				end
				local a = dungeonPerkDoorsParsed[1]
				local b = dungeonPerkDoorsParsed[2]
				if a and b then
					setContestStatus(("Perk config: %s vs %s (doors have no rarity text)"):format(
						describePerkIdLookup(a.perkId), describePerkIdLookup(b.perkId)
					))
				end
			end
		end)
		setContestStatus("Hooked PerkDoorsReady: " .. perkReady:GetFullName())
	else
		warn("[BloxMonster Contest] PerkDoorsReady event not found under DungeonService")
	end
	local dungeonResult = resolveDungeonEvent(DUNGEON_RE.DungeonResult)
	if dungeonResult then
		dungeonResult.OnClientEvent:Connect(function()
			dungeonRunEnded = true
			contestInDungeon = false
			setContestStatus("DungeonResult (run ended)")
		end)
	end
end

local function waitForContestSignal(checkFn, timeoutSec)
	local deadline = wallClockSeconds() + (timeoutSec or 20)
	while wallClockSeconds() < deadline do
		if not contestRunning then
			return false
		end
		if checkFn() then
			return true
		end
		task.wait(0.25)
	end
	return false
end

local function waitForDungeonEntry(roomBefore, timeoutSec)
	return waitForContestSignal(function()
		return dungeonRoomVersion > roomBefore or dungeonRunEnded
	end, timeoutSec or 18)
end

scanAllRemotesText = function()
	local lines = {
		"=== DungeonService remotes ===",
		"PerkDoorsReady | RoomChanged | ChoosePerk | StartDungeon | LeaveDungeon",
		"",
	}
	local dungeon = getDungeonServiceFolder()
	if not dungeon then
		table.insert(lines, "  (DungeonService not found under Knit.Services)")
		return table.concat(lines, "\n"), 0
	end
	local count = 0
	for _, remote in ipairs(dungeon:GetDescendants()) do
		if remote:IsA("RemoteEvent") or remote:IsA("RemoteFunction") then
			count = count + 1
			table.insert(lines, ("  %s (%s)"):format(remote:GetFullName(), remote.ClassName))
		end
	end
	return table.concat(lines, "\n"), count
end

scanContestRemotesText = scanAllRemotesText

local function buildContestStartArgSets(difficulty, useKey)
	local argSets = {
		{ difficulty.index },
		{ difficulty.index - 1 },
		{ difficulty.name },
		{ difficulty.id },
		{ tostring(difficulty.index) },
		{ difficulty.name:upper() },
	}
	if difficulty.needsKey and useKey then
		table.insert(argSets, { difficulty.index, true })
		table.insert(argSets, { difficulty.name, true })
		table.insert(argSets, { "Master", true })
		table.insert(argSets, { 4, true })
	else
		table.insert(argSets, { difficulty.index, false })
		table.insert(argSets, { difficulty.name, false })
	end
	return argSets
end

local function leaveDungeonKnit()
	contestInDungeon = false
	resetDungeonSignals()
	local leave = resolveDungeonRemote("LeaveDungeon", "RemoteFunction")
		or resolveContestRemotePath(DUNGEON_RF.Leave)
	if leave then
		pcall(function()
			invokeContestRemote(leave)
		end)
	end
end

local function startDungeonKnit(difficulty, useKey)
	ensureDungeonEventHooks()
	resetDungeonSignals()
	local startRemote = resolveDungeonRemote("StartDungeon", "RemoteFunction")
		or resolveContestRemotePath(DUNGEON_RF.Start)
	if not startRemote then
		setContestStatus("StartDungeon remote not found")
		return false, "no remote"
	end
	local argSets = buildContestStartArgSets(difficulty, useKey)
	local lastResult = nil
	for _, args in ipairs(argSets) do
		local roomBefore = dungeonRoomVersion
		local ok, result = invokeContestRemote(startRemote, table.unpack(args))
		lastResult = result
		local argText = formatInvokeArgs(args)
		local resultText = ok and formatRemoteResult(result) or ("ERR:" .. tostring(result))
		setContestStatus(("StartDungeon(%s) => %s"):format(argText, resultText))
		if ok then
			local accepted = isRemoteSuccess(result)
			if accepted ~= false then
				if waitForDungeonEntry(roomBefore, 8) then
					if dungeonRunEnded then
						setContestStatus("StartDungeon rejected (DungeonResult)")
						return false, result
					end
					contestInDungeon = true
					return true, result
				end
				if accepted == true then
					contestInDungeon = true
					setContestStatus("StartDungeon accepted (no RoomChanged yet)")
					return true, result
				end
			end
		end
	end
	setContestStatus("StartDungeon failed – open Capture Contest menu, pick difficulty, then Start")
	return false, lastResult
end

local function buildChoosePerkArgSets(doorIndex, payload)
	local argSets = {}
	local seen = {}
	local function addSet(...)
		local args = { ... }
		if #args == 0 then
			return
		end
		local key = formatInvokeArgs(args)
		if seen[key] then
			return
		end
		seen[key] = true
		table.insert(argSets, args)
	end
	payload = payload or dungeonPerkPayload
	if type(payload) == "table" then
		local doorA = payload.DoorA or payload.doorA
		local doorB = payload.DoorB or payload.doorB
		local perkId = doorIndex == 1 and doorA or doorB
		if perkId ~= nil then
			addSet(perkId)
			addSet(tostring(perkId))
		end
		if doorIndex == 1 then
			addSet("A")
			addSet("a")
			addSet(0)
		elseif doorIndex == 2 then
			addSet("B")
			addSet("b")
			addSet(1)
		end
	end
	addSet(doorIndex)
	addSet(doorIndex - 1)
	addSet(tostring(doorIndex))
	return argSets
end

local function getPerkDoorPartFromPayload(payload, doorIndex)
	if type(payload) ~= "table" then
		return nil
	end
	if doorIndex == 1 then
		return payload.doorAPart or payload.DoorAPart
	end
	return payload.doorBPart or payload.DoorBPart
end

local function findPerkDoorParts()
	local candidates = {}
	local playerPos = getPlayerPosition()
	if not playerPos then
		return candidates
	end
	for _, desc in ipairs(Workspace:GetDescendants()) do
		if desc:IsA("BasePart") or desc:IsA("Model") then
			local nameLower = desc.Name:lower()
			if nameLower:find("perk", 1, true) or nameLower:find("portal", 1, true)
				or nameLower:find("door", 1, true) or nameLower:find("gate", 1, true) then
				local pos = getModelPosition(desc) or (desc:IsA("BasePart") and desc.Position)
				if pos and (pos - playerPos).Magnitude < 300 then
					table.insert(candidates, { inst = desc, pos = pos })
				end
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.pos.X < b.pos.X
	end)
	return candidates
end

local function teleportToPerkDoor(doorIndex, payload)
	payload = payload or dungeonPerkPayload
	local part = getPerkDoorPartFromPayload(payload, doorIndex)
	local pos = part and (getModelPosition(part) or (part:IsA("BasePart") and part.Position))
	if not pos and dungeonPerkDoorsParsed then
		for _, d in ipairs(dungeonPerkDoorsParsed) do
			if d.door == doorIndex and d.part then
				pos = getModelPosition(d.part) or (d.part:IsA("BasePart") and d.part.Position)
				break
			end
		end
	end
	if not pos then
		local doors = findPerkDoorParts()
		if #doors == 0 then
			return false
		end
		local pick = doors[math.min(math.max(doorIndex, 1), #doors)]
		pos = pick.pos
	end
	if not pos then
		return false
	end
	local char = LocalPlayer.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		root.CFrame = CFrame.new(pos + Vector3.new(0, 3, 0))
		task.wait(0.35)
		return true
	end
	return false
end

local function tryActivatePerkDoor(doorIndex)
	local doors = findPerkDoorParts()
	if #doors == 0 then
		return false
	end
	local pick = doors[math.min(math.max(doorIndex, 1), #doors)]
	local inst = pick.inst
	if not teleportToPerkDoor(doorIndex) then
		return false
	end
	local searchRoot = inst:IsA("Model") and inst or inst.Parent
	if searchRoot then
		for _, prompt in ipairs(searchRoot:GetDescendants()) do
			if prompt:IsA("ProximityPrompt") then
				if fireContestPrompt(prompt) then
					return true
				end
			end
		end
	end
	return false
end

local function chooseDungeonPerk(pickMode, roomBefore)
	local remaining = getDungeonPetTargets()
	if #remaining > 0 then
		setContestStatus(("Skip perk door – %d pet(s) left (e.g. %s)"):format(
			#remaining, remaining[1].name or "?"
		))
		return false
	end
	if not confirmDungeonFloorCleared(contestRunId, DUNGEON_FLOOR_CLEAR_CONFIRM_SEC + 3) then
		setContestStatus("Skip perk door – floor not confirmed clear")
		return false
	end
	local remote = resolveDungeonRemote("ChoosePerk", "RemoteFunction")
		or resolveContestRemotePath(DUNGEON_RF.ChoosePerk)
	if not remote then
		setContestStatus("ChoosePerk remote not found under DungeonService")
		return false
	end
	roomBefore = roomBefore or dungeonRoomVersion
	local preferredDoor = 1
	local pickInfo = ""
	local doorsToTry = { 1, 2 }
	if pickMode == "best" or pickMode == nil then
		local perkRank
		preferredDoor, perkRank, pickInfo = pickBestPerkDoor()
		setContestStatus(("Perk pick: %s"):format(pickInfo or "unknown"))
		if perkRank and perkRank > 0 and preferredDoor then
			doorsToTry = { preferredDoor }
		else
			doorsToTry = { 1, 2 }
			pickInfo = pickInfo or "rarity unknown – try both doors"
		end
	elseif pickMode == "second" then
		preferredDoor = 2
		doorsToTry = { 2, 1 }
		pickInfo = "door 2"
	elseif pickMode == "random" then
		preferredDoor = math.random(1, 2)
		doorsToTry = { preferredDoor, preferredDoor == 1 and 2 or 1 }
		pickInfo = "random"
	else
		pickInfo = pickMode
	end
	preferredDoor = preferredDoor or doorsToTry[1] or 1
	task.wait(1)
	teleportToPerkDoor(preferredDoor, dungeonPerkPayload)
	task.wait(0.4)
	for _, tryDoor in ipairs(doorsToTry) do
		teleportToPerkDoor(tryDoor, dungeonPerkPayload)
		task.wait(0.35)
		for _, args in ipairs(buildChoosePerkArgSets(tryDoor, dungeonPerkPayload)) do
			local ok, result = invokeContestRemote(remote, table.unpack(args))
			setContestStatus(("ChoosePerk(%s) [%s] => %s"):format(
				formatInvokeArgs(args),
				pickInfo ~= "" and pickInfo or ("door " .. tryDoor),
				ok and formatRemoteResult(result) or tostring(result)
			))
			if ok and isRemoteSuccess(result) ~= false then
				dungeonPerkReady = false
				dungeonPerkPayload = nil
				dungeonPerkDoorsParsed = nil
				task.wait(0.5)
				return true
			end
		end
		if dungeonRoomVersion > roomBefore or dungeonRunEnded then
			dungeonPerkReady = false
			dungeonPerkPayload = nil
			dungeonPerkDoorsParsed = nil
			setContestStatus(("ChoosePerk – RoomChanged after door %d"):format(tryDoor))
			return true
		end
	end
	task.wait(0.5)
	if resumeDungeonCombatIfNeeded() then
		return false
	end
	return false
end

local function tryStartBattlePrompt(model)
	if not model then
		return false
	end
	for _, prompt in ipairs(model:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") then
			local action = (prompt.ActionText or ""):lower()
			local obj = (prompt.ObjectText or ""):lower()
			for _, kw in ipairs(CONTEST_BATTLE_KEYWORDS) do
				if action:find(kw, 1, true) or obj:find(kw, 1, true) then
					if fireContestPrompt(prompt) then
						return true
					end
				end
			end
		end
	end
	local anyPrompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
	if anyPrompt then
		return fireContestPrompt(anyPrompt)
	end
	return false
end

local function tryStartContest(difficulty, useKey)
	local started, result = startDungeonKnit(difficulty, useKey)
	if started then
		task.wait(WORLD_TELEPORT_SETTLE_SEC)
		return true, result
	end
	return false, result
end

local function engageContestEnemy(model)
	if not model then
		return false
	end
	-- Pets tab style: TP near mob, let equipped pets auto-fight with skills.
	-- Do NOT spam SetTarget / RequestPetAttack — that resets combat.
	teleportToPet(model)
	task.wait(0.5)
	tryStartBattlePrompt(model)
	return true
end

local function resumeDungeonCombatIfNeeded()
	local remaining = getDungeonPetTargets()
	if #remaining > 0 then
		setContestStatus(("Return to fight – %d pet(s) left"):format(#remaining))
		engageContestEnemy(remaining[1].model)
		return true
	end
	return false
end

local function waitForFloorBattle(durationSec, runId)
	local start = wallClockSeconds()
	local clearSince = nil
	while wallClockSeconds() - start < durationSec do
		if not contestRunning or contestRunId ~= runId or dungeonRunEnded then
			return false, "stopped"
		end
		local count = #getDungeonPetTargets()
		if count == 0 then
			clearSince = clearSince or wallClockSeconds()
			if wallClockSeconds() - clearSince >= DUNGEON_FLOOR_CLEAR_CONFIRM_SEC then
				return true, "cleared"
			end
		else
			clearSince = nil
		end
		task.wait(DUNGEON_FLOOR_CLEAR_POLL_SEC)
	end
	if confirmDungeonFloorCleared(runId, DUNGEON_FLOOR_CLEAR_CONFIRM_SEC + 1) then
		return true, "cleared"
	end
	return true, "waited"
end

local function selectPerkPortal(pickMode, roomBefore)
	return chooseDungeonPerk(pickMode, roomBefore)
end

local function transitionToNextFloor(runId, floorNum, roomWhenCleared)
	if dungeonRunEnded then
		return false
	end
	if not contestRunning or contestRunId ~= runId then
		return false
	end
	roomWhenCleared = roomWhenCleared or dungeonRoomVersion
	local nextFloor = floorNum + 1
	if dungeonRoomVersion > roomWhenCleared then
		setContestStatus(("Floor %d → %d: next room ready, check pets"):format(floorNum, nextFloor))
		task.wait(WORLD_TELEPORT_SETTLE_SEC)
		return true
	end
	setContestStatus(("Floor %d – pick perk (once)..."):format(floorNum))
	task.wait(1)
	local perkOk = selectPerkPortal(contestPerkPick, roomWhenCleared)
	if not perkOk then
		if resumeDungeonCombatIfNeeded() then
			return false
		end
	end
	if dungeonRoomVersion > roomWhenCleared then
		setContestStatus(("Floor %d → %d: next room ready, check pets"):format(floorNum, nextFloor))
		task.wait(WORLD_TELEPORT_SETTLE_SEC)
		return true
	end
	setContestStatus(("Floor %d – waiting next room..."):format(floorNum))
	if waitForDungeonEntry(roomWhenCleared, 25) or dungeonRoomVersion > roomWhenCleared then
		setContestStatus(("Floor %d → %d: next room ready, check pets"):format(floorNum, nextFloor))
		task.wait(WORLD_TELEPORT_SETTLE_SEC)
		return true
	end
	if dungeonRunEnded then
		return true
	end
	return nil
end

local function runContestFloorBattle(runId, difficulty, floorNum, _killsNeeded)
	local floorCombatStarted = false
	local idleSince = wallClockSeconds()
	if floorNum > 1 then
		task.wait(2)
	end
	while contestRunning and contestRunId == runId and not dungeonRunEnded do
		local targets = getDungeonPetTargets()
		if #targets == 0 then
			if not floorCombatStarted then
				if wallClockSeconds() - idleSince > 120 then
					setContestStatus(("Floor %d – no pets found (120s timeout)"):format(floorNum))
					return nil
				end
				setContestStatus(("Floor %d – waiting for pets..."):format(floorNum))
				task.wait(1.5)
			else
				if confirmDungeonFloorCleared(runId) then
					setContestStatus(("Floor %d – cleared (no pets)"):format(floorNum))
					return true
				end
				setContestStatus(("Floor %d – pets reappeared, keep fighting"):format(floorNum))
				task.wait(1)
			end
		else
			idleSince = wallClockSeconds()
			local target = targets[1]
			setContestStatus(("Floor %d – TP %s (%d pets)..."):format(
				floorNum, target.name or target.model.Name, #targets
			))
			engageContestEnemy(target.model)
			floorCombatStarted = true
			local ok, reason = waitForFloorBattle(DUNGEON_FLOOR_BATTLE_SEC, runId)
			if not ok then
				return false
			end
			if reason == "cleared" then
				return true
			end
			targets = getDungeonPetTargets()
			if #targets == 0 and confirmDungeonFloorCleared(runId) then
				return true
			end
		end
	end
	if dungeonRunEnded then
		return false
	end
	return nil
end

local function runContestDungeon(runId, difficulty)
	ensureDungeonEventHooks()
	local started, startResult = tryStartContest(difficulty, difficulty.needsKey and contestUseMasterKey)
	if not started then
		setContestStatus("Did not enter dungeon: " .. formatRemoteResult(startResult))
		return false
	end
	local floor = 1
	while floor <= difficulty.floors do
		if not contestRunning or contestRunId ~= runId or dungeonRunEnded then
			break
		end
		local battleOk = runContestFloorBattle(runId, difficulty, floor, difficulty.petsPerFloor)
		if battleOk ~= true then
			if dungeonRunEnded then
				break
			end
			setContestStatus("Floor " .. floor .. " – battle retry...")
			task.wait(3)
		else
			if floor >= difficulty.floors then
				break
			end
			local roomWhenCleared = dungeonRoomVersion
			local moved = false
			while not moved and contestRunning and contestRunId == runId and not dungeonRunEnded do
				if dungeonRoomVersion > roomWhenCleared then
					setContestStatus(("Floor %d → %d: room ready, check pets"):format(floor, floor + 1))
					task.wait(WORLD_TELEPORT_SETTLE_SEC)
					moved = true
				else
					local transitionOk = transitionToNextFloor(runId, floor, roomWhenCleared)
					if transitionOk == true or dungeonRoomVersion > roomWhenCleared then
						moved = true
					elseif transitionOk == false then
						setContestStatus("Floor " .. floor .. " – resume battle")
						break
					else
						setContestStatus("Floor " .. floor .. " – waiting for next room...")
						task.wait(3)
					end
				end
			end
			if moved or dungeonRoomVersion > roomWhenCleared then
				floor = floor + 1
			end
		end
	end
	if dungeonRunEnded then
		setContestStatus(difficulty.name .. " run finished (DungeonResult)")
	else
		setContestStatus(difficulty.name .. " run complete")
	end
	leaveDungeonKnit()
	return true
end

startContestDungeon = function()
	if contestRunning then
		setContestStatus("Already running")
		return
	end
	if worldHuntRunning or autoFarmRunning then
		setContestStatus("Stop pet/world farm first")
		return
	end
	local difficulty = getContestDifficultyById(selectedContestDifficultyId)
	if difficulty.needsKey and not contestUseMasterKey then
		setContestStatus("Master requires key – enable Use Master key")
		return
	end
	contestRunId = contestRunId + 1
	local runId = contestRunId
	contestRunning = true
	setContestStatus("Starting " .. difficulty.name .. "...")
	if contestThread then
		pcall(task.cancel, contestThread)
	end
	contestThread = task.spawn(function()
		while contestRunning and contestRunId == runId do
			local pcallOk, runResult = pcall(function()
				return runContestDungeon(runId, getContestDifficultyById(selectedContestDifficultyId))
			end)
			if not pcallOk and not tostring(runResult):find("cancelled", 1, true) then
				leaveDungeonKnit()
				setContestStatus("Error: " .. tostring(runResult))
				warn("[BloxMonster Contest]", runResult)
			end
			if contestRunning and contestRunId == runId then
				if pcallOk and runResult == true then
					setContestStatus(("Next run in %ds..."):format(DUNGEON_RUN_COOLDOWN_SEC))
					task.wait(DUNGEON_RUN_COOLDOWN_SEC)
				else
					leaveDungeonKnit()
					setContestStatus("Retry in 15s (open Capture Contest menu first)")
					task.wait(15)
				end
			end
		end
	end)
end

stopContestDungeon = function()
	contestRunId = contestRunId + 1
	contestRunning = false
	leaveDungeonKnit()
	if contestThread then
		pcall(task.cancel, contestThread)
		contestThread = nil
	end
	setContestStatus("Dungeon stopped")
end

