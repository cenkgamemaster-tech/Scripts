end

local function stopWorldHunt()
	worldHuntRunning = false
	worldHuntStatusLabel.Text = "World hunt idle"
	worldHuntStartBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 100)
end

local function startWorldHunt()
	if worldHuntRunning then
		return
	end
	worldHuntRunning = true
	worldHuntStartBtn.BackgroundColor3 = Color3.fromRGB(60, 130, 140)
	worldHuntStatusLabel.Text = "World hunt starting..."
	if worldHuntThread then
		task.cancel(worldHuntThread)
	end
	worldHuntThread = task.spawn(function()
		while worldHuntRunning do
			for _, world in ipairs(WORLD_ZONES) do
				if not worldHuntRunning then
					break
				end
				local filters = worldPetFilters[world.id]
				if filters and #filters > 0 then
					selectedWorldId = world.id
					highlightWorldButtons()
					rebuildWorldFilterChips()

					worldHuntStatusLabel.Text = "Going to " .. world.name .. "..."
					local tpOk = teleportToWorld(world)
					if not tpOk then
						worldHuntStatusLabel.Text = "No spawn for " .. world.name .. ", skipping..."
						task.wait(FARM_NO_TARGET_WAIT_SEC)
					else
						task.wait(WORLD_TELEPORT_SETTLE_SEC)
					end

					local lastWorldPriority = 0
					while worldHuntRunning do
						local pets = getPetsInWorld(world)
						refreshWorldList(false, world)

						local targets = applyNameFilters(pets, filters)
						local target, targetP = pickNextFarmTarget(targets, lastWorldPriority, filters)
						if not target then
							break
						end

						local prio = targetP or getPetFilterPriority(target.name, filters)
						worldHuntStatusLabel.Text = ("[%s] TP P%s: %s"):format(world.name, tostring(prio), target.name)
						teleportToPet(target.model)

						for sec = WORLD_HUNT_WAIT_SEC, 1, -1 do
							if not worldHuntRunning then
								break
							end
							worldHuntStatusLabel.Text = ("[%s] P%s: %s – %ds"):format(world.name, tostring(prio), target.name, sec)
							task.wait(1)
						end

						lastWorldPriority = prio
					end
				end
			end
			if worldHuntRunning then
				worldHuntStatusLabel.Text = "Cycle complete – restarting..."
				task.wait(FARM_NO_TARGET_WAIT_SEC)
			end
		end
	end)
end

local function stopAutoFarm()
	autoFarmRunning = false
	farmStatusLabel.Text = "Farm idle"
	farmStartBtn.BackgroundColor3 = Color3.fromRGB(40, 100, 55)
end

local function startAutoFarm()
	if autoFarmRunning then
		return
	end
	if #nameFilters == 0 then
		farmStatusLabel.Text = "Add pets first (e.g. Orbitfin@1)"
		return
	end
	autoFarmRunning = true
	farmStartBtn.BackgroundColor3 = Color3.fromRGB(60, 140, 70)
	farmStatusLabel.Text = "Farm starting..."
	if autoFarmThread then
		task.cancel(autoFarmThread)
	end
	autoFarmThread = task.spawn(function()
		local lastFarmPriority = 0
		while autoFarmRunning do
			local pets = scanWorldPets()
			populateList(applyNameFilters(pets), #pets)

			local targets = applyNameFilters(pets)
			local target, targetP = pickNextFarmTarget(targets, lastFarmPriority)
			if not target then
				lastFarmPriority = 0
				farmStatusLabel.Text = "Waiting for pets..."
				task.wait(FARM_NO_TARGET_WAIT_SEC)
			else
				local model = target.model
				local prio = targetP or getPetFilterPriority(target.name)
				farmStatusLabel.Text = ("TP P%s: %s"):format(tostring(prio), target.name)
				teleportToPet(model)

				for sec = FARM_WAIT_SEC, 1, -1 do
					if not autoFarmRunning then
						break
					end
					farmStatusLabel.Text = ("P%s: %s – %ds"):format(tostring(prio), target.name, sec)
					task.wait(1)
				end

				lastFarmPriority = prio
				farmStatusLabel.Text = "Refreshing list..."
				pets = scanWorldPets()
				populateList(applyNameFilters(pets), #pets)
			end
		end
	end)
end

