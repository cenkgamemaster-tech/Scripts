local function resolveWorldLocation(worldId)
	local session = worldSavedLocations[worldId]
	if session then
		return session
	end
	local baked = WORLD_SPAWN_LOCATIONS[worldId]
	if baked then
		return baked
	end
	return nil
end

local function getSavedWorldPosition(worldId)
	local loc = resolveWorldLocation(worldId)
	if not loc then
		return nil
	end
	return Vector3.new(loc.x, loc.y, loc.z)
end

local function formatHardcodeEntry(worldId, loc)
	return ('\t%s = { x = %.3f, y = %.3f, z = %.3f },'):format(worldId, loc.x, loc.y, loc.z)
end

local function formatHardcodeBlock()
	local lines = { "local WORLD_SPAWN_LOCATIONS = {" }
	for _, world in ipairs(WORLD_ZONES) do
		local loc = resolveWorldLocation(world.id)
		if loc then
			table.insert(lines, formatHardcodeEntry(world.id, loc))
		end
	end
	table.insert(lines, "}" )
	return table.concat(lines, "\n")
end

