		if desc:IsA("BillboardGui") then
			local lbl = desc:FindFirstChild(labelName, true)
			if lbl and (lbl:IsA("TextLabel") or lbl:IsA("TextButton")) and lbl.Text and lbl.Text ~= "" then
				return lbl.Text
			end
		end
	end
	return nil
end

local function getBillboardInfo(model)
	local info = {}
	for _, labelName in ipairs(BILLBOARD_LABELS) do
		local text = getBillboardLabel(model, labelName)
		if text then
