local function refreshCachedPetsLight()
	local out = {}
	for _, pet in ipairs(lastAllPets) do
		if pet.model and pet.model.Parent then
			pet.distance = getDistanceToPlayer(pet.model)
			table.insert(out, pet)
		end
	end
	lastAllPets = out
	return out
end

local function getCachedWorldPets(scanMode)
	scanMode = scanMode or "auto"
	if farmLocationStayActive then
		if #lastAllPets > 0 then
			return refreshCachedPetsLight()
		end
		return {}
	end
	if scanMode == "light" then
		if #lastAllPets == 0 then
			scanMode = "full"
		else
			return refreshCachedPetsLight()
		end
	end
	local farmActive = worldHuntRunning or autoFarmRunning
	local cacheSec = farmActive and math.max(SCAN_CACHE_SEC, FULL_SCAN_MIN_INTERVAL) or SCAN_CACHE_SEC
	local now = nowSeconds()
	if scanMode ~= "full" and #lastAllPets > 0 and (now - lastScanClock) < cacheSec then
		return refreshCachedPetsLight()
	end
	if scanMode == "full" and #lastAllPets > 0 and (now - lastFullScanClock) < FULL_SCAN_MIN_INTERVAL then
		return refreshCachedPetsLight()
	end
	lastScanClock = now
	if scanMode == "full" then
		lastFullScanClock = now
	end
	local ok, pets = pcall(getWorldPets)
	if ok and pets then
		lastAllPets = pets
		return pets
	end
	lastAllPets = {}
	return {}
end

