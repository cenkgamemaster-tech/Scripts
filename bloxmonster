local function populateList(pets, totalUnfiltered)
	for _, child in ipairs(scroll:GetChildren()) do
		if child ~= listLayout and not child:IsA("UICorner") then
			child:Destroy()
		end
	end

	local countText = tostring(#pets) .. " pet" .. (#pets == 1 and "" or "s")
	if #nameFilters > 0 and totalUnfiltered then
		countText = countText .. " / " .. tostring(totalUnfiltered)
	end
	countLabel.Text = countText

	if #pets == 0 then
		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, -8, 0, 40)
		empty.BackgroundTransparency = 1
		local emptyMsg = "No wild pets found. Walk around an adventure zone and tap Refresh."
		if #nameFilters > 0 and totalUnfiltered and totalUnfiltered > 0 then
			emptyMsg = "No pets match your filters. Try different names or tap Clear."
		elseif #nameFilters > 0 then
			emptyMsg = "No pets match your filters yet. Add e.g. Orbitfin@1, Phant@3, Pico@2"
		end
		empty.Text = emptyMsg
		empty.TextColor3 = Color3.fromRGB(180, 200, 180)
		empty.TextSize = 12
		empty.Font = Enum.Font.Gotham
		empty.TextWrapped = true
		empty.LayoutOrder = 1
		empty.Parent = scroll
		return
	end

	for i, pet in ipairs(pets) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 52)
		row.BackgroundColor3 = Color3.fromRGB(32, 50, 72)
		row.LayoutOrder = i
