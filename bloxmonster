local function refreshLocationRows()
	for _, world in ipairs(WORLD_ZONES) do
		local box = locationCoordBoxes[world.id]
		local hint = locationHardcodeLabels[world.id]
		if box then
			local loc = resolveWorldLocation(world.id)
			local isBaked = loc and WORLD_SPAWN_LOCATIONS[world.id] ~= nil and worldSavedLocations[world.id] == nil
			if loc then
				box.Text = ("x = %.3f,  y = %.3f,  z = %.3f"):format(loc.x, loc.y, loc.z)
				box.TextColor3 = Color3.fromRGB(255, 245, 160)
				if hint then
					hint.Text = isBaked
						and ("hardcoded: " .. formatHardcodeEntry(world.id, loc))
						or ("session: " .. formatHardcodeEntry(world.id, loc))
				end
			else
				box.Text = "x = ?,  y = ?,  z = ?  (not set)"
				box.TextColor3 = Color3.fromRGB(140, 170, 150)
				if hint then
					hint.Text = "Save in-game, then Copy -> paste into WORLD_SPAWN_LOCATIONS"
				end
			end
		end
	end
end

