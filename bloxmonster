local function normalizeFilterName(text)
	return tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local FULLWIDTH_DIGITS = {
	["０"] = "0", ["１"] = "1", ["２"] = "2", ["３"] = "3", ["４"] = "4",
	["５"] = "5", ["６"] = "6", ["７"] = "7", ["８"] = "8", ["９"] = "9",
}

local function normalizeFilterRaw(text)
	text = tostring(text or "")
	text = text:gsub("\r", ""):gsub("\n", ",")
	text = text:gsub("＠", "@"):gsub("，", ","):gsub("；", ";")
	for fw, digit in pairs(FULLWIDTH_DIGITS) do
		text = text:gsub(fw, digit)
	end
	return text
end

local function splitFilterParts(raw)
	raw = normalizeFilterRaw(raw)
	local parts = {}
	for part in string.gmatch(raw, "[^,;]+") do
		table.insert(parts, part)
	end
	return parts
end

local function getFilterName(entry)
	if type(entry) == "table" then
		return entry.name or ""
	end
	return tostring(entry or "")
end

local function getFilterPriority(entry)
	if type(entry) == "table" and entry.priority then
		return entry.priority
	end
	return 999
end

local function parseFilterEntry(chunk)
	chunk = normalizeFilterName(normalizeFilterRaw(chunk))
	if chunk == "" then
		return nil
	end
	local atPos = chunk:find("@", 1, true)
	if not atPos then
		return nil
	end
	local name = normalizeFilterName(chunk:sub(1, atPos - 1))
	local prioStr = normalizeFilterName(chunk:sub(atPos + 1))
	if name == "" or prioStr == "" then
		return nil
	end
	local prio = tonumber(prioStr)
	if not prio or prio < 1 then
		return nil
	end
	return name, math.floor(prio)
end

local function findFilterIndexByName(name)
	local lower = name:lower()
	for idx, entry in ipairs(nameFilters) do
		if getFilterName(entry):lower() == lower then
			return idx
		end
	end
	return nil
end

local function getPetFilterPriority(petName, filters)
	filters = filters or nameFilters
	if #filters == 0 then
		return 999
	end
	local best = math.huge
	local lowerName = tostring(petName or ""):lower()
	for _, entry in ipairs(filters) do
		local fname = getFilterName(entry)
		if lowerName:find(fname:lower(), 1, true) then
			local p = getFilterPriority(entry)
			if p < best then
				best = p
			end
		end
	end
	return best
end

local function petMatchesFilters(petName, filters)
	filters = filters or nameFilters
	if #filters == 0 then
		return true
	end
	return getPetFilterPriority(petName, filters) < math.huge
end

local function applyNameFilters(pets, filters)
	filters = filters or nameFilters
	if #filters == 0 then
		return pets
	end
	local out = {}
	for _, pet in ipairs(pets) do
		if petMatchesFilters(pet.name, filters) then
			table.insert(out, pet)
		end
	end
	table.sort(out, function(a, b)
		local pa, pb = getPetFilterPriority(a.name, filters), getPetFilterPriority(b.name, filters)
		if pa ~= pb then
			return pa < pb
		end
		if a.sortKey ~= b.sortKey then
			return a.sortKey < b.sortKey
		end
		return (a.distance or math.huge) < (b.distance or math.huge)
	end)
	return out
end

local function pickNextFarmTarget(pets, skipBelowPriority, filters)
	local function isValid(pet)
		return pet.model and pet.model.Parent
	end

	local best, bestP = nil, math.huge
	for _, pet in ipairs(pets) do
		if isValid(pet) then
			local p = getPetFilterPriority(pet.name, filters)
			if p > (skipBelowPriority or 0) and p < bestP then
				bestP = p
				best = pet
			end
		end
	end
	if best then
		return best, bestP
	end

	bestP = math.huge
	for _, pet in ipairs(pets) do
		if isValid(pet) then
			local p = getPetFilterPriority(pet.name, filters)
			if p < bestP then
				bestP = p
				best = pet
			end
		end
	end
	return best, bestP
end

local function pathMatchesWorld(path, worldConfig)
	local lower = tostring(path or ""):lower()
	for _, kw in ipairs(worldConfig.keywords) do
		if lower:find(kw:lower(), 1, true) then
			return true
		end
	end
	return false
end

local function getPetsInWorld(worldConfig)
	local pets = getWorldPets()
	local out = {}
	for _, pet in ipairs(pets) do
		if pathMatchesWorld(pet.path, worldConfig) then
			table.insert(out, pet)
		end
	end
	return out
end

local function getInstancePosition(inst)
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	end
	if inst:IsA("Model") then
		local ok, pivot = pcall(function() return inst:GetPivot() end)
		if ok and pivot then
			return pivot.Position
		end
		if inst.PrimaryPart then
			return inst.PrimaryPart.Position
		end
	end
	return nil
end

local function findWorldTeleportPosition(worldConfig)
	local bestPos, bestScore = nil, 0
	for _, inst in ipairs(Workspace:GetDescendants()) do
		local nameLower = inst.Name:lower()
		local fullLower = ""
		pcall(function() fullLower = inst:GetFullName():lower() end)

		local score = 0
		for _, kw in ipairs(worldConfig.keywords) do
			local k = kw:lower()
			if nameLower:find(k, 1, true) or fullLower:find(k, 1, true) then
				score = score + 1
			end
		end
		if score > 0 then
			if inst:IsA("SpawnLocation") then
				score = score + 4
			elseif nameLower:find("spawn", 1, true) or nameLower:find("teleport", 1, true) or nameLower:find("portal", 1, true) then
				score = score + 3
			elseif inst:IsA("BasePart") then
				score = score + 2
			elseif inst:IsA("Model") then
				score = score + 1
			end
			local pos = getInstancePosition(inst)
			if pos and score > bestScore then
				bestScore = score
				bestPos = pos
			end
		end
	end
	return bestPos
end

local function teleportPlayerToPosition(pos)
	local char = LocalPlayer.Character
	if not char or not pos then
		return false
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	root.CFrame = CFrame.new(pos + Vector3.new(0, 4, 0))
	return true
end

local function teleportToWorld(worldConfig)
	local pos = findWorldTeleportPosition(worldConfig)
	if pos then
		return teleportPlayerToPosition(pos)
	end
	return false
end

