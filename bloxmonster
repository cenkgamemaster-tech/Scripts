local function rebuildFilterChips()
	for _, child in ipairs(filterChipScroll:GetChildren()) do
		if child ~= filterChipLayout then
			child:Destroy()
		end
	end
	table.sort(nameFilters, function(a, b)
		local pa, pb = getFilterPriority(a), getFilterPriority(b)
		if pa ~= pb then
			return pa < pb
		end
		return getFilterName(a):lower() < getFilterName(b):lower()
	end)
	for i, entry in ipairs(nameFilters) do
		local filterName = getFilterName(entry)
		local priority = getFilterPriority(entry)
		local chipText = ("P%s %s"):format(tostring(priority), filterName)

		local chip = Instance.new("TextButton")
		chip.Size = UDim2.new(0, math.max(80, #chipText * 7 + 24), 0, 22)
		chip.BackgroundColor3 = Color3.fromRGB(45, 75, 55)
		chip.BorderSizePixel = 0
		chip.LayoutOrder = i
		chip.Text = chipText .. "  ×"
		chip.TextColor3 = Color3.fromRGB(200, 255, 200)
		chip.TextSize = 11
		chip.Font = Enum.Font.Gotham
		chip.AutoButtonColor = true
		chip.Parent = filterChipScroll

		local chipCorner = Instance.new("UICorner")
		chipCorner.CornerRadius = UDim.new(0, 4)
		chipCorner.Parent = chip

		local capturedName = filterName
		chip.MouseButton1Click:Connect(function()
			local idx = findFilterIndexByName(capturedName)
			if idx then
				table.remove(nameFilters, idx)
			end
			rebuildFilterChips()
			if refreshList then
				refreshList(false)
			end
		end)
	end
end

local function addFilterFromInput()
	local raw = filterInput.Text
	if raw == "" then
		filterHint.Text = "Type: Orbitfin@1, Phant@3, Pico@2"
		return
	end

	local added = 0
	for _, part in ipairs(splitFilterParts(raw)) do
		local name, prio = parseFilterEntry(part)
		if name ~= nil and prio ~= nil then
			local existingIdx = findFilterIndexByName(name)
			if existingIdx then
				nameFilters[existingIdx].priority = prio
			else
				table.insert(nameFilters, { name = name, priority = prio })
			end
			added = added + 1
		end
	end

	if added > 0 then
		filterInput.Text = ""
		filterHint.Text = ("Added %d filter(s). Empty list = show all."):format(added)
		rebuildFilterChips()
		if refreshList then
			refreshList(false)
		end
	else
		filterHint.Text = "Invalid format – use Name@priority (e.g. Orbitfin@1, Phant@3)"
		warn("[BloxMonster] Could not parse:", raw)
	end
end

refreshList = function(rescan)
	if rescan == false and #lastAllPets > 0 then
		local filtered = applyNameFilters(lastAllPets)
		populateList(filtered, #lastAllPets)
		return
	end
	local ok, pets = pcall(getWorldPets)
	if ok then
		lastAllPets = pets
		local filtered = applyNameFilters(pets)
		populateList(filtered, #pets)
	else
		lastAllPets = {}
		populateList({}, 0)
		warn("[BloxMonster] Scan error:", pets)
	end
end

refreshWorldList = function(rescan, worldConfig)
	worldConfig = worldConfig or getSelectedWorldConfig()
	if not worldConfig then
		populateWorldList({}, 0)
		return
	end

	local function showPets(allInWorld)
		local filters = getSelectedWorldFilters()
		local filtered = applyNameFilters(allInWorld, filters)
		populateWorldList(filtered, #allInWorld)
	end

	if rescan == false then
		local cached = {}
		for _, pet in ipairs(lastAllPets) do
			if pathMatchesWorld(pet.path, worldConfig) then
				table.insert(cached, pet)
			end
		end
		if #cached > 0 then
			showPets(cached)
			return
		end
	end

	local ok, pets = pcall(getWorldPets)
	if ok then
		lastAllPets = pets
		local inWorld = getPetsInWorld(worldConfig)
		showPets(inWorld)
	else
		populateWorldList({}, 0)
		warn("[BloxMonster] World scan error:", pets)
	end
end

local function selectWorld(worldId, teleport)
	selectedWorldId = worldId
	highlightWorldButtons()
	rebuildWorldFilterChips()
	if teleport then
		local world = getWorldConfigById(worldId)
		if world then
			worldHuntStatusLabel.Text = "Teleporting to " .. world.name .. "..."
			local ok = teleportToWorld(world)
			worldHuntStatusLabel.Text = ok and ("At " .. world.name) or ("Could not find " .. world.name .. " spawn")
			task.wait(WORLD_TELEPORT_SETTLE_SEC)
		end
	end
	refreshWorldList(true)
end

