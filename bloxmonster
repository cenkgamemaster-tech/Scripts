			if modelRef and modelRef.Parent then
				teleportToPet(modelRef)
			end
		end)
	end
end

local function refreshList()
	local ok, pets = pcall(getWorldPets)
	if ok then
		populateList(pets)
	else
		populateList({})
		warn("[BloxMonster] Scan error:", pets)
	end
end

local function stopAutoRefresh()
	autoRefreshRunning = false
	autoRefreshBtn.Text = "Auto refresh: OFF"
	autoRefreshBtn.BackgroundColor3 = Color3.fromRGB(40, 70, 50)
end

refreshBtn.MouseButton1Click:Connect(refreshList)

closeBtn.MouseButton1Click:Connect(function()
	stopAutoRefresh()
	screen:Destroy()
end)

autoRefreshBtn.MouseButton1Click:Connect(function()
	if autoRefreshRunning then
		stopAutoRefresh()
		return
	end
	autoRefreshRunning = true
	autoRefreshBtn.Text = "Auto refresh: ON"
	autoRefreshBtn.BackgroundColor3 = Color3.fromRGB(60, 120, 70)
	if autoRefreshThread then
		task.cancel(autoRefreshThread)
	end
	autoRefreshThread = task.spawn(function()
		while autoRefreshRunning do
			refreshList()
			task.wait(AUTO_REFRESH_SEC)
		end
	end)
end)

