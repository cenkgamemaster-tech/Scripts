	return set
end

local function isEquippedPetPath(fullName)
	if fullName:find("Players%.", 1, true) then
		return true
	end
	local lower = fullName:lower()
	if lower:find("equipped", 1, true) or lower:find("follower", 1, true) or lower:find("followpet", 1, true)
		or lower:find("playerpet", 1, true) or lower:find("mypet", 1, true) or lower:find("backpack", 1, true) then
		return true
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if lower:find(plr.Name:lower(), 1, true) and lower:find("pet", 1, true) then
			return true
		end
	end
	return false
end

local function isDummyOrTrainingMob(model)
	if not model then
		return true
	end
	local nameLower = model.Name:lower()
	if nameLower:find("dummy", 1, true) or nameLower:find("doll", 1, true)
		or nameLower:find("training", 1, true) or nameLower:find("train", 1, true) then
		return true
	end
	local ok, fullName = pcall(function() return model:GetFullName() end)
	if ok and fullName then
		local pathLower = fullName:lower()
		if pathLower:find("dummy", 1, true) or pathLower:find("doll", 1, true)
			or pathLower:find("training", 1, true) or pathLower:find("dojo", 1, true) then
			return true
		end
	end
	return false
end

local function modelLooksLikeWildPet(model)
	if model:FindFirstChildOfClass("Humanoid") then
		return true
	end
	if model:FindFirstChildWhichIsA("BillboardGui", true) then
		return true
	end
	if model:FindFirstChildWhichIsA("ProximityPrompt", true) then
		return true
	end
	for _, key in ipairs(PET_ATTR_KEYS) do
		if getAttr(model, key) ~= nil then
			return true
		end
	end
	return false
end

local function readBillboardFromGui(billboardGui, bb)
	if not billboardGui then
		return
	end
	for _, labelName in ipairs(BILLBOARD_LABELS) do
		if not bb[labelName] then
			local lbl = billboardGui:FindFirstChild(labelName, true)
			if lbl and (lbl:IsA("TextLabel") or lbl:IsA("TextButton")) and lbl.Text and lbl.Text ~= "" then
				bb[labelName] = lbl.Text
			end
		end
	end
end

local function tryBuildPetEntry(model, playerChars)
	if not model or model.ClassName ~= "Model" or playerChars[model] then
		return nil
	end
	if WORKSPACE_PREFIX and WORKSPACE_PREFIX ~= "" and not isUnderPath(model, WORKSPACE_PREFIX) then
		return nil
	end

	local okName, fullName = pcall(function() return model:GetFullName() end)
	if not okName or not fullName or isEquippedPetPath(fullName) then
		return nil
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local score = humanoid and 1 or 0
	local bb = {}

	for _, key in ipairs(PET_ATTR_KEYS) do
		if getAttr(model, key) ~= nil then
			score = score + 1
			break
		end
	end

	local billboard = model:FindFirstChildWhichIsA("BillboardGui", true)
	local hasBillboard = billboard ~= nil
	local hasCatchPrompt = false
	local prompt = model:FindFirstChildWhichIsA("ProximityPrompt", true)
	if prompt then
		local action = (prompt.ActionText or ""):lower()
		local obj = (prompt.ObjectText or ""):lower()
		if action:find("catch", 1, true) or action:find("battle", 1, true)
			or action:find("fight", 1, true) or obj:find("catch", 1, true) then
			hasCatchPrompt = true
		end
	end

	if hasBillboard then
		score = score + 2
		readBillboardFromGui(billboard, bb)
		if not next(bb) then
			for _, labelName in ipairs(BILLBOARD_LABELS) do
				local text = getBillboardLabel(model, labelName)
				if text then
					bb[labelName] = text
				end
			end
		end
	end
	if hasCatchPrompt then
		score = score + 2
	end
	if score < 2 then
		return nil
	end

	local petName = bb.PetName or bb.MonsterName or bb.Name or bb.NpcName or model.Name
	local rarity = bb.Rarity
	local tier = bb.Tier or getAttr(model, "Tier")
	local level = bb.Level or getAttr(model, "Level")
	local mutation = bb.Mutation or getAttr(model, "Mutation")
	local shiny = bb.Shiny or getAttr(model, "Shiny")
	local rarityKey = rarity and tostring(rarity):gsub("^%s+", ""):gsub("%s+$", "") or ""

	return {
		model = model,
		name = tostring(petName),
		rarity = rarity and tostring(rarity) or "—",
		tier = tier and tostring(tier) or "—",
		level = level and tostring(level) or "—",
		mutation = mutation and tostring(mutation) or "—",
		shiny = shiny and tostring(shiny) or "—",
		distance = getDistanceToPlayer(model),
		path = fullName,
		sortKey = RARITY_ORDER[rarityKey] or RARITY_ORDER[tostring(tier or "")] or 99,
	}
end

getWorldPets = function()
	local root = getScanRoot()
	local found = {}
	local seen = {}
	local playerChars = getPlayerCharacterSet()

	local function consider(model)
		if seen[model] then
			return
		end
		seen[model] = true
		local ok, entry = pcall(tryBuildPetEntry, model, playerChars)
		if ok and entry then
			table.insert(found, entry)
		end
	end

	if root then
		for _, desc in ipairs(root:GetDescendants()) do
			if desc.ClassName == "Model" and modelLooksLikeWildPet(desc) then
				consider(desc)
			end
		end
	end

	table.sort(found, function(a, b)
		if a.sortKey ~= b.sortKey then
			return a.sortKey < b.sortKey
		end
		local da, db = a.distance or math.huge, b.distance or math.huge
		if da ~= db then
			return da < db
		end
		return a.name < b.name
	end)

	return found
end

local LIVE_MOBS_PATH_SUFFIX = "live.mobs.client"

local function findChildInsensitive(parent, name)
	if not parent then
		return nil
	end
	local direct = parent:FindFirstChild(name)
	if direct then
		return direct
	end
	local lower = name:lower()
	for _, child in ipairs(parent:GetChildren()) do
		if child.Name:lower() == lower then
			return child
		end
	end
	return nil
end

local function getLiveMobsClientRoots()
	local roots = {}
	local live = findChildInsensitive(Workspace, "Live")
	if live then
		local mobs = findChildInsensitive(live, "Mobs")
		if mobs then
			local client = findChildInsensitive(mobs, "Client")
			if client then
				table.insert(roots, client)
			end
		end
	end
	return roots
end

local function isUnderLiveMobsClient(model)
	local ok, fullName = pcall(function()
		return model:GetFullName()
	end)
	if not ok or not fullName then
		return false
	end
	return fullName:lower():find(LIVE_MOBS_PATH_SUFFIX, 1, true) ~= nil
end

local function tryBuildDungeonPetEntry(model, playerChars)
	if not model or model.ClassName ~= "Model" or playerChars[model] then
		return nil
	end
	if not isUnderLiveMobsClient(model) then
		return nil
	end
	if isDummyOrTrainingMob(model) then
		return nil
	end

	local okName, fullName = pcall(function() return model:GetFullName() end)
	if not okName or not fullName or isEquippedPetPath(fullName) then
		return nil
	end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end

	local bb = {}
	local billboard = model:FindFirstChildWhichIsA("BillboardGui", true)
	if billboard then
		readBillboardFromGui(billboard, bb)
		if not next(bb) then
			for _, labelName in ipairs(BILLBOARD_LABELS) do
				local text = getBillboardLabel(model, labelName)
				if text then
					bb[labelName] = text
				end
			end
		end
	end

	local petName = bb.PetName or bb.MonsterName or bb.Name or bb.NpcName or model.Name
	local rarity = bb.Rarity
	local tier = bb.Tier or getAttr(model, "Tier")
	local level = bb.Level or getAttr(model, "Level")
	local mutation = bb.Mutation or getAttr(model, "Mutation")
	local shiny = bb.Shiny or getAttr(model, "Shiny")
	local rarityKey = rarity and tostring(rarity):gsub("^%s+", ""):gsub("%s+$", "") or ""

	return {
		model = model,
		name = tostring(petName),
		rarity = rarity and tostring(rarity) or "—",
		tier = tier and tostring(tier) or "—",
		level = level and tostring(level) or "—",
		mutation = mutation and tostring(mutation) or "—",
		shiny = shiny and tostring(shiny) or "—",
		distance = getDistanceToPlayer(model),
		path = fullName,
		sortKey = RARITY_ORDER[rarityKey] or RARITY_ORDER[tostring(tier or "")] or 99,
	}
end

getDungeonPets = function()
	local found = {}
	local seen = {}
	local playerChars = getPlayerCharacterSet()

	local function consider(model)
		if seen[model] then
			return
		end
		seen[model] = true
		local ok, entry = pcall(tryBuildDungeonPetEntry, model, playerChars)
		if ok and entry then
			table.insert(found, entry)
		end
	end

	for _, clientRoot in ipairs(getLiveMobsClientRoots()) do
		for _, child in ipairs(clientRoot:GetChildren()) do
			if child:IsA("Model") then
				consider(child)
			end
		end
	end

	table.sort(found, function(a, b)
		if a.sortKey ~= b.sortKey then
			return a.sortKey < b.sortKey
		end
		local da, db = a.distance or math.huge, b.distance or math.huge
		if da ~= db then
			return da < db
		end
		return a.name < b.name
	end)

	return found
end

