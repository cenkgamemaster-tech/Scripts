local function normalizeFilterName(text)
	return tostring(text or ""):gsub("^%s+", ""):gsub("%s+$", "")
end

local FULLWIDTH_DIGITS = {
	["０"] = "0", ["１"] = "1", ["２"] = "2", ["３"] = "3", ["４"] = "4",
	["５"] = "5", ["６"] = "6", ["７"] = "7", ["８"] = "8", ["９"] = "9",
}

local function normalizeFilterRaw(text)
	text = tostring(text or "")
	text = text:gsub("\r", ""):gsub("\n", ",")
	text = text:gsub("＠", "@"):gsub("，", ","):gsub("；", ";")
	for fw, digit in pairs(FULLWIDTH_DIGITS) do
		text = text:gsub(fw, digit)
	end
	return text
end

local function splitFilterParts(raw)
	raw = normalizeFilterRaw(raw)
	local parts = {}
	for part in string.gmatch(raw, "[^,;]+") do
		table.insert(parts, part)
	end
	return parts
end

local function getFilterName(entry)
	if type(entry) == "table" then
		return entry.name or ""
	end
	return tostring(entry or "")
end

local function getFilterPriority(entry)
	if type(entry) == "table" and entry.priority then
		return entry.priority
	end
	return 999
end

local function filtersBelowPriority(filters, maxPriority)
	local out = {}
	for _, entry in ipairs(filters or {}) do
		if getFilterPriority(entry) < maxPriority then
			table.insert(out, entry)
		end
	end
	return out
end

local function parseFilterEntry(chunk)
	chunk = normalizeFilterName(normalizeFilterRaw(chunk))
	if chunk == "" then
		return nil
	end
	local atPos = chunk:find("@", 1, true)
	if not atPos then
		return nil
	end
	local name = normalizeFilterName(chunk:sub(1, atPos - 1))
	local prioStr = normalizeFilterName(chunk:sub(atPos + 1))
	if name == "" or prioStr == "" then
		return nil
	end
	local prio = tonumber(prioStr)
	if not prio or prio < 1 then
		return nil
	end
	return name, math.floor(prio)
end

local function findFilterIndexByName(name)
	local lower = name:lower()
	for idx, entry in ipairs(nameFilters) do
		if getFilterName(entry):lower() == lower then
			return idx
		end
	end
	return nil
end

local function compactName(text)
	return tostring(text or ""):lower():gsub("[%s_%-]", "")
end

local function resolvePetIdentity(petOrName)
	if type(petOrName) == "table" then
		return petOrName
	end
	return { name = tostring(petOrName or "") }
end

local function exactNameEquals(text, fname, fcompact)
	local lower = tostring(text or ""):lower()
	local comp = compactName(text)
	return lower == fname or comp == fcompact
end

local function pathEndsWithExactName(path, fname, fcompact)
	local last = tostring(path or ""):match("([^%.]+)$")
	if not last then
		return false
	end
	return exactNameEquals(last, fname, fcompact)
end

local function nameMatchesFilter(filterName, pet)
	local fname = tostring(filterName or ""):lower()
	local fcompact = compactName(filterName)
	if fname == "" or fcompact == "" then
		return false
	end
	if exactNameEquals(pet.name, fname, fcompact) then
		return true
	end
	if pet.model and exactNameEquals(pet.model.Name, fname, fcompact) then
		return true
	end
	if pathEndsWithExactName(pet.path, fname, fcompact) then
		return true
	end
	return false
end

local function getPetFilterPriority(petOrName, filters)
	filters = filters or nameFilters
	if #filters == 0 then
		return 999
	end
	local pet = resolvePetIdentity(petOrName)
	local best = math.huge
	for _, entry in ipairs(filters) do
		local fname = getFilterName(entry)
		if nameMatchesFilter(fname, pet) then
			local p = getFilterPriority(entry)
			if p < best then
				best = p
			end
		end
	end
	return best
end

local function petMatchesFilters(petOrName, filters)
	filters = filters or nameFilters
	if #filters == 0 then
		return true
	end
	return getPetFilterPriority(petOrName, filters) < math.huge
end

local function applyNameFilters(pets, filters)
	filters = filters or nameFilters
	if #filters == 0 then
		return pets
	end
	local out = {}
	for _, pet in ipairs(pets) do
		if petMatchesFilters(pet, filters) then
			table.insert(out, pet)
		end
	end
	table.sort(out, function(a, b)
		local pa, pb = getPetFilterPriority(a, filters), getPetFilterPriority(b, filters)
		if pa ~= pb then
			return pa < pb
		end
		if a.sortKey ~= b.sortKey then
			return a.sortKey < b.sortKey
		end
		return (a.distance or math.huge) < (b.distance or math.huge)
	end)
	return out
end

local function pickNextFarmTarget(pets, skipBelowPriority, filters)
	local function isValid(pet)
		return pet.model and pet.model.Parent
	end

	local best, bestP = nil, math.huge
	for _, pet in ipairs(pets) do
		if isValid(pet) then
			local p = getPetFilterPriority(pet, filters)
			if p > (skipBelowPriority or 0) and p < bestP then
				bestP = p
				best = pet
			end
		end
	end
	if best then
		return best, bestP
	end

	bestP = math.huge
	for _, pet in ipairs(pets) do
		if isValid(pet) then
			local p = getPetFilterPriority(pet, filters)
			if p < bestP then
				bestP = p
				best = pet
			end
		end
	end
	return best, bestP
end

local function instanceWorldScore(inst, worldConfig)
	if not inst or not worldConfig then
		return 0
	end
	local nameLower = inst.Name:lower()
	local nameCompact = compactName(inst.Name)
	local fullLower = ""
	local fullCompact = ""
	pcall(function()
		fullLower = inst:GetFullName():lower()
		fullCompact = compactName(fullLower)
	end)

	local worldCompact = compactName(worldConfig.name)
	local worldIdCompact = compactName(worldConfig.id)
	local score = 0

	for _, kw in ipairs(worldConfig.keywords) do
		local k = kw:lower()
		local kCompact = compactName(k)
		if nameLower == k or nameCompact == kCompact then
			score = score + 3
		elseif nameLower:find(k, 1, true) or fullLower:find(k, 1, true)
			or nameCompact:find(kCompact, 1, true) or fullCompact:find(kCompact, 1, true) then
			score = score + 1
		end
	end
	if worldCompact ~= "" then
		if nameCompact == worldCompact or fullCompact:find("." .. worldCompact, 1, true) then
			score = score + 4
		elseif nameCompact:find(worldCompact, 1, true) or fullCompact:find(worldCompact, 1, true) then
			score = score + 2
		end
	end
	if worldIdCompact ~= "" and (nameCompact:find(worldIdCompact, 1, true) or fullCompact:find(worldIdCompact, 1, true)) then
		score = score + 1
	end
	return score
end

local function pathMatchesWorld(path, worldConfig)
	local lower = tostring(path or ""):lower()
	local compact = compactName(path)
	for _, kw in ipairs(worldConfig.keywords) do
		local k = kw:lower()
		local kCompact = compactName(k)
		if lower:find(k, 1, true) or compact:find(kCompact, 1, true) then
			return true
		end
	end
	local worldCompact = compactName(worldConfig.name)
	if worldCompact ~= "" and compact:find(worldCompact, 1, true) then
		return true
	end
	return false
end

local function getPetsInWorld(worldConfig, allPets)
	if not allPets then
		allPets = getCachedWorldPets("auto")
	end
	local out = {}
	for _, pet in ipairs(allPets) do
		if pathMatchesWorld(pet.path, worldConfig) then
			table.insert(out, pet)
		end
	end
	return out
end

-- Pets for a world: path match first, then filter-matched pets from full scan (spawn paths often omit zone names).
local function getWorldVisiblePets(worldConfig, filters, allPets)
	if not allPets or #allPets == 0 then
		allPets = getCachedWorldPets("auto")
	end

	local byPath = getPetsInWorld(worldConfig, allPets)
	if #byPath > 0 then
		return byPath, allPets
	end

	if filters and #filters > 0 then
		local byFilter = {}
		for _, pet in ipairs(allPets) do
			if petMatchesFilters(pet, filters) then
				table.insert(byFilter, pet)
			end
		end
		if #byFilter > 0 then
			return byFilter, allPets
		end
	end

	return {}, allPets
end

local function getWorldHuntTargets(worldConfig, filters)
	local allPets = getCachedWorldPets("auto")
	local visible = getWorldVisiblePets(worldConfig, filters, allPets)
	return applyNameFilters(visible, filters)
end

local function getInstancePosition(inst)
	if not inst then
		return nil
	end
	if inst:IsA("BasePart") then
		return inst.Position
	end
	if inst:IsA("Model") then
		local ok, pivot = pcall(function() return inst:GetPivot() end)
		if ok and pivot then
			return pivot.Position
		end
		if inst.PrimaryPart then
			return inst.PrimaryPart.Position
		end
	end
	return nil
end

