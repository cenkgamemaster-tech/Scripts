local function resolveRemotePath(pathString)
	local node = game
	for part in string.gmatch(pathString, "[^.]+") do
		node = node and node:FindFirstChild(part)
		if not node then
			return nil
		end
	end
	if node and (node:IsA("RemoteEvent") or node:IsA("RemoteFunction")) then
		return node
	end
	return nil
end

local function remoteNameMatchesFuse(name)
	local lower = string.lower(name or "")
	for _, kw in ipairs(FUSE_REMOTE_KEYWORDS) do
		if lower:find(kw, 1, true) then
			return true
		end
	end
	return false
end

local function valueToLogString(value, depth)
	depth = depth or 0
	if depth > 3 then
		return "(nested)"
	end
	local t = typeof(value)
	if t == "table" then
		local parts = {}
		for i, v in ipairs(value) do
			table.insert(parts, valueToLogString(v, depth + 1))
		end
		if #parts == 0 then
			for k, v in pairs(value) do
				table.insert(parts, tostring(k) .. "=" .. valueToLogString(v, depth + 1))
			end
		end
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	return tostring(value)
end

collectFuseRelatedRemotes = function()
	local seen = {}
	local list = {}
	local function add(remote)
		local key = remote:GetFullName()
		if seen[key] then
			return
		end
		seen[key] = true
		table.insert(list, remote)
	end
	for _, path in ipairs(FUSE_REMOTE_CANDIDATES) do
		local remote = resolveRemotePath(path)
		if remote then
			add(remote)
		end
	end
	for _, inst in ipairs(ReplicatedStorage:GetDescendants()) do
		if (inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction")) and remoteNameMatchesFuse(inst.Name) then
			add(inst)
		end
	end
	table.sort(list, function(a, b)
		return a:GetFullName() < b:GetFullName()
	end)
	return list
end

