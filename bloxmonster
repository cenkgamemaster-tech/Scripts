local function populatePetScroll(targetScroll, targetLayout, pets, totalUnfiltered, filters, countLbl)
	for _, child in ipairs(targetScroll:GetChildren()) do
		if child ~= targetLayout and not child:IsA("UICorner") then
			child:Destroy()
		end
	end

	if countLbl then
		local countText = tostring(#pets) .. " pet" .. (#pets == 1 and "" or "s")
		if #filters > 0 and totalUnfiltered then
			countText = countText .. " / " .. tostring(totalUnfiltered)
		end
		countLbl.Text = countText
	end

	if #pets == 0 then
		local empty = Instance.new("TextLabel")
		empty.Size = UDim2.new(1, -8, 0, 40)
		empty.BackgroundTransparency = 1
		local emptyMsg
		if targetScroll == worldScroll then
			emptyMsg = "No wild pets found in this zone. Teleport to the world and tap Refresh."
			if #filters > 0 and totalUnfiltered and totalUnfiltered > 0 then
				emptyMsg = "No pets match your world filters. Try different names or tap Clear."
			elseif #filters > 0 then
				emptyMsg = "No pets match your filters yet. Add e.g. Thornshade@1"
			end
		else
			emptyMsg = "No wild pets found. Walk around an adventure zone and tap Refresh."
			if #filters > 0 and totalUnfiltered and totalUnfiltered > 0 then
				emptyMsg = "No pets match your filters. Try different names or tap Clear."
			elseif #filters > 0 then
				emptyMsg = "No pets match your filters yet. Add e.g. Orbitfin@1, Phant@3, Pico@2"
			end
		end
		empty.Text = emptyMsg
		empty.TextColor3 = Color3.fromRGB(180, 200, 180)
		empty.TextSize = 12
		empty.Font = Enum.Font.Gotham
		empty.TextWrapped = true
		empty.LayoutOrder = 1
		empty.Parent = targetScroll
		return
	end

	for i, pet in ipairs(pets) do
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -8, 0, 52)
		row.BackgroundColor3 = Color3.fromRGB(32, 50, 72)
		row.LayoutOrder = i
		row.Parent = targetScroll

		local rowCorner = Instance.new("UICorner")
		rowCorner.CornerRadius = UDim.new(0, 4)
		rowCorner.Parent = row

		local nameLabel = Instance.new("TextLabel")
		nameLabel.Size = UDim2.new(1, -70, 0, 18)
		nameLabel.Position = UDim2.new(0, 8, 0, 4)
		nameLabel.BackgroundTransparency = 1
		nameLabel.Text = pet.name
		nameLabel.TextColor3 = Color3.fromRGB(200, 255, 200)
		nameLabel.TextSize = 13
		nameLabel.Font = Enum.Font.GothamBold
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.TextTruncate = Enum.TextTruncate.AtEnd
		nameLabel.Parent = row

		local distText = pet.distance and ("%.0f studs"):format(pet.distance) or "?"
		local prioText = ""
		if #filters > 0 then
			prioText = ("P%s | "):format(tostring(getPetFilterPriority(pet.name, filters)))
		end
		local infoLabel = Instance.new("TextLabel")
		infoLabel.Size = UDim2.new(1, -70, 0, 16)
		infoLabel.Position = UDim2.new(0, 8, 0, 22)
		infoLabel.BackgroundTransparency = 1
		infoLabel.Text = prioText .. ("Rarity: %s | Tier: %s | Lv: %s | Mut: %s | %s"):format(
			pet.rarity, pet.tier, pet.level, pet.mutation, distText
		)
		infoLabel.TextColor3 = Color3.fromRGB(160, 210, 170)
		infoLabel.TextSize = 11
		infoLabel.Font = Enum.Font.Gotham
		infoLabel.TextXAlignment = Enum.TextXAlignment.Left
		infoLabel.TextTruncate = Enum.TextTruncate.AtEnd
		infoLabel.Parent = row

		local pathLabel = Instance.new("TextLabel")
		pathLabel.Size = UDim2.new(1, -70, 0, 14)
		pathLabel.Position = UDim2.new(0, 8, 0, 36)
		pathLabel.BackgroundTransparency = 1
		pathLabel.Text = pet.path
		pathLabel.TextColor3 = Color3.fromRGB(120, 150, 130)
		pathLabel.TextSize = 9
		pathLabel.Font = Enum.Font.Code
		pathLabel.TextXAlignment = Enum.TextXAlignment.Left
		pathLabel.TextTruncate = Enum.TextTruncate.AtEnd
		pathLabel.Parent = row

		local tpBtn = Instance.new("TextButton")
		tpBtn.Size = UDim2.new(0, 56, 0, 24)
		tpBtn.Position = UDim2.new(1, -62, 0.5, -12)
		tpBtn.BackgroundColor3 = Color3.fromRGB(50, 90, 60)
		tpBtn.BorderSizePixel = 0
		tpBtn.Text = "Go"
		tpBtn.TextColor3 = Color3.fromRGB(220, 255, 220)
		tpBtn.TextSize = 11
		tpBtn.Font = Enum.Font.GothamBold
