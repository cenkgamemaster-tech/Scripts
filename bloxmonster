local function startWorldFarm()
	if worldHuntRunning then
		return false
	end
	if autoFarmRunning then
		setWorldFarmStatus("Stop pet farm first")
		return false
	end
	applyFarmSettingsFromUI()
	if getFarmStaySec() >= MIN_FARM_STAY_SEC then
		farmLocationEnabled = true
		updateFarmLocationEnableButton()
		refreshConfigStatusLabel()
	end
	if not anyWorldPetsConfigured() then
		setWorldFarmStatus("Configure pets on Worlds tab first")
		return false
	end
	worldFarmRunId = worldFarmRunId + 1
	local myRunId = worldFarmRunId
	worldHuntRunning = true
	UI.worldHuntStartBtn.BackgroundColor3 = Color3.fromRGB(60, 130, 140)
	setWorldFarmStatus("World hunt starting...")
	if worldHuntThread then
		pcall(task.cancel, worldHuntThread)
	end
	worldHuntThread = task.spawn(function()
		local ok, err = pcall(function()
			runWorldFarmLoop(myRunId)
		end)
		if not ok and not tostring(err):find("cancelled", 1, true) then
			warn("[BloxMonster] World hunt error:", err)
			if worldFarmRunId == myRunId then
				setWorldFarmStatus("World hunt error: " .. tostring(err))
			end
		end
		if worldFarmRunId == myRunId then
			worldHuntRunning = false
			farmLocationStayActive = false
			UI.worldHuntStartBtn.BackgroundColor3 = Color3.fromRGB(40, 90, 100)
			if ok or tostring(err):find("cancelled", 1, true) then
				UI.worldHuntStatusLabel.Text = "World hunt idle"
			end
		end
	end)
	maybeStartAutoFuseWithFarm()
	return true
end

local function startWorldHunt()
