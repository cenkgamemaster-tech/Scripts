local CONTEST_BATTLE_KEYWORDS = { "battle", "fight", "attack", "catch", "challenge", "engage" }
local CONTEST_PERK_RARITY_RANK = {
	uncommon = 1,
	rare = 2,
	epic = 3,
	legendary = 4,
	mythical = 5,
	mythic = 5,
}
-- Longest names first so "uncommon" is not mistaken for "common" etc.
local CONTEST_PERK_RARITY_ORDERED = {
	"mythical", "legendary", "uncommon", "mythic", "epic", "rare",
}
-- Rarity fields only – never use Name/Label (perk names like "Lucky" are not rarities).
local CONTEST_PERK_RARITY_FIELDS = {
	"Rarity", "rarity", "Tier", "tier", "Grade", "grade", "Quality", "quality",
	"PerkRarity", "perkRarity", "RarityTier", "rarityTier", "RarityName", "rarityName",
}
local CONTEST_PERK_NESTED_FIELDS = {
	"Data", "data", "Info", "info", "Perk", "perk", "Stats", "stats", "Config", "config",
}
local CONTEST_PERK_DOOR_FIELDS = {
	"Door", "door", "Index", "index", "Slot", "slot", "Choice", "choice",
}

local contestStatusCallback = nil

local function setContestStatus(msg)
	warn("[BloxMonster Contest]", msg)
	if contestStatusCallback then
		pcall(contestStatusCallback, msg)
	end
end

setContestStatusHandler = function(callback)
	contestStatusCallback = callback
end

local function getContestDifficultyById(id)
	for _, diff in ipairs(CONTEST_DIFFICULTIES) do
		if diff.id == id then
			return diff
		end
	end
	return CONTEST_DIFFICULTIES[3]
end

local function fireContestPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		return false
	end
	return pcall(function()
		if typeof(fireproximityprompt) == "function" then
			fireproximityprompt(prompt, prompt.HoldDuration or 0)
		else
			prompt:InputHoldBegin()
			task.wait(prompt.HoldDuration > 0 and prompt.HoldDuration or 0.5)
			prompt:InputHoldEnd()
		end
	end)
end

local function resolveContestRemotePath(pathString)
	local node = game
	for part in string.gmatch(pathString, "[^.]+") do
		node = node and node:FindFirstChild(part)
		if not node then
			return nil
		end
	end
	if node and (node:IsA("RemoteEvent") or node:IsA("RemoteFunction")) then
		return node
	end
	return nil
end

local function getKnitServicesFolder()
	local packages = ReplicatedStorage:FindFirstChild("Packages")
	local knit = packages and packages:FindFirstChild("Knit")
	return knit and knit:FindFirstChild("Services")
end

local function getDungeonServiceFolder()
	local services = getKnitServicesFolder()
	return services and services:FindFirstChild("DungeonService")
end

local function resolveDungeonRemote(name, className)
	local dungeon = getDungeonServiceFolder()
	if not dungeon then
		return nil
	end
	local direct = dungeon:FindFirstChild(name)
	if direct and (not className or direct:IsA(className)) then
		return direct
	end
	for _, folderName in ipairs({ "RF", "RE", "Client" }) do
		local folder = dungeon:FindFirstChild(folderName)
		local node = folder and folder:FindFirstChild(name)
		if node and (not className or node:IsA(className)) then
			return node
		end
	end
	for _, desc in ipairs(dungeon:GetDescendants()) do
		if desc.Name == name and (not className or desc:IsA(className)) then
			return desc
		end
	end
	return nil
end

local function resolveDungeonEvent(name)
	return resolveDungeonRemote(name, "RemoteEvent")
end

local function invokeContestRemote(remote, ...)
	local args = { ... }
	local ok, result = pcall(function()
		if remote:IsA("RemoteEvent") then
			remote:FireServer(table.unpack(args))
			return true
		end
		return remote:InvokeServer(table.unpack(args))
	end)
	return ok, result
end

local function formatRemoteResult(result)
	local t = typeof(result)
	if t == "nil" then
		return "nil"
	end
	if t == "boolean" or t == "number" or t == "string" then
		return tostring(result)
	end
	if t == "table" then
		local parts = {}
		for k, v in pairs(result) do
			table.insert(parts, tostring(k) .. "=" .. tostring(v))
			if #parts >= 4 then
				break
			end
		end
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	return tostring(result)
end

local function formatInvokeArgs(args)
	local parts = {}
	for _, v in ipairs(args) do
		table.insert(parts, tostring(v))
	end
	return table.concat(parts, ", ")
end

local function isRemoteSuccess(result)
	if result == false then
		return false
	end
	if result == nil then
		return nil
	end
	if type(result) == "string" then
		local lower = result:lower()
		if lower:find("fail", 1, true) or lower:find("error", 1, true)
			or lower:find("cannot", 1, true) or lower:find("invalid", 1, true)
			or lower:find("denied", 1, true) or lower:find("need", 1, true) then
			return false
		end
	end
	if type(result) == "table" and result.success == false then
		return false
	end
	return true
end

