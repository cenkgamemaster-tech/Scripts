local function rebuildFilterChips()
	for _, child in ipairs(filterChipScroll:GetChildren()) do
		if child ~= filterChipLayout then
			child:Destroy()
		end
	end
	table.sort(nameFilters, function(a, b)
		local pa, pb = getFilterPriority(a), getFilterPriority(b)
		if pa ~= pb then
			return pa < pb
		end
		return getFilterName(a):lower() < getFilterName(b):lower()
	end)
	for i, entry in ipairs(nameFilters) do
		local filterName = getFilterName(entry)
		local priority = getFilterPriority(entry)
		local chipText = ("P%s %s"):format(tostring(priority), filterName)

		local chip = Instance.new("TextButton")
		chip.Size = UDim2.new(0, math.max(80, #chipText * 7 + 24), 0, 22)
		chip.BackgroundColor3 = Color3.fromRGB(45, 75, 55)
		chip.BorderSizePixel = 0
		chip.LayoutOrder = i
		chip.Text = chipText .. "  ×"
		chip.TextColor3 = Color3.fromRGB(200, 255, 200)
		chip.TextSize = 11
		chip.Font = Enum.Font.Gotham
		chip.AutoButtonColor = true
		chip.Parent = filterChipScroll

		local chipCorner = Instance.new("UICorner")
		chipCorner.CornerRadius = UDim.new(0, 4)
		chipCorner.Parent = chip

		local capturedName = filterName
		chip.MouseButton1Click:Connect(function()
			local idx = findFilterIndexByName(capturedName)
			if idx then
				table.remove(nameFilters, idx)
			end
			rebuildFilterChips()
			if refreshList then
				refreshList(false)
			end
		end)
	end
end

local function addFilterFromInput()
	local raw = filterInput.Text
	if raw == "" then
		filterHint.Text = "Type: Orbitfin@1, Phant@3, Pico@2"
		return
	end

	local added = 0
	for _, part in ipairs(splitFilterParts(raw)) do
		local name, prio = parseFilterEntry(part)
		if name ~= nil and prio ~= nil then
			local existingIdx = findFilterIndexByName(name)
			if existingIdx then
				nameFilters[existingIdx].priority = prio
			else
				table.insert(nameFilters, { name = name, priority = prio })
			end
			added = added + 1
		end
	end

	if added > 0 then
		filterInput.Text = ""
		filterHint.Text = ("Added %d filter(s). Empty list = show all."):format(added)
		rebuildFilterChips()
		if refreshList then
			refreshList(false)
		end
	else
		filterHint.Text = "Invalid format – use Name@priority (e.g. Orbitfin@1, Phant@3)"
		warn("[BloxMonster] Could not parse:", raw)
	end
end

