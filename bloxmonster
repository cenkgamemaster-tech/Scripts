local function getWorldConfigById(worldId)
	for _, world in ipairs(WORLD_ZONES) do
		if world.id == worldId then
			return world
		end
	end
	return nil
end

local function getSelectedWorldConfig()
	return getWorldConfigById(selectedWorldId)
end

local function getSelectedWorldFilters()
	if not worldPetFilters[selectedWorldId] then
		worldPetFilters[selectedWorldId] = {}
	end
	return worldPetFilters[selectedWorldId]
end

local function findWorldFilterIndexByName(name)
	local filters = getSelectedWorldFilters()
	local lower = name:lower()
	for idx, entry in ipairs(filters) do
		if getFilterName(entry):lower() == lower then
			return idx
		end
	end
	return nil
end

local function updateWorldSelectedLabel()
	local world = getSelectedWorldConfig()
	local filters = getSelectedWorldFilters()
	local names = {}
	for _, entry in ipairs(filters) do
		table.insert(names, getFilterName(entry) .. "@" .. tostring(getFilterPriority(entry)))
	end
	local petText = #names > 0 and table.concat(names, ", ") or "no pets configured"
	UI.worldSelectedLabel.Text = ("Selected: %s | %s"):format(world and world.name or "?", petText)
end

local function highlightWorldButtons()
	for worldId, btn in pairs(UI.worldButtons) do
		if worldId == selectedWorldId then
			btn.BackgroundColor3 = Color3.fromRGB(50, 100, 70)
		else
			btn.BackgroundColor3 = Color3.fromRGB(35, 55, 75)
		end
	end
end

local function rebuildWorldFilterChips()
	for _, child in ipairs(UI.worldFilterChipScroll:GetChildren()) do
		if child ~= UI.worldFilterChipLayout then
			child:Destroy()
		end
	end
	local filters = getSelectedWorldFilters()
	table.sort(filters, function(a, b)
		local pa, pb = getFilterPriority(a), getFilterPriority(b)
		if pa ~= pb then
			return pa < pb
		end
		return getFilterName(a):lower() < getFilterName(b):lower()
	end)
	for i, entry in ipairs(filters) do
		local filterName = getFilterName(entry)
		local priority = getFilterPriority(entry)
		local chipText = ("P%s %s"):format(tostring(priority), filterName)

		local chip = Instance.new("TextButton")
		chip.Size = UDim2.new(0, math.max(80, #chipText * 7 + 24), 0, 22)
		chip.BackgroundColor3 = Color3.fromRGB(45, 75, 65)
		chip.BorderSizePixel = 0
		chip.LayoutOrder = i
		chip.Text = chipText .. "  ×"
		chip.TextColor3 = Color3.fromRGB(200, 255, 200)
		chip.TextSize = 11
		chip.Font = Enum.Font.Gotham
		chip.AutoButtonColor = true
		chip.Parent = UI.worldFilterChipScroll

		local chipCorner = Instance.new("UICorner")
		chipCorner.CornerRadius = UDim.new(0, 4)
		chipCorner.Parent = chip

		local capturedName = filterName
		chip.MouseButton1Click:Connect(function()
			local idx = findWorldFilterIndexByName(capturedName)
			if idx then
				table.remove(getSelectedWorldFilters(), idx)
			end
			rebuildWorldFilterChips()
			updateWorldSelectedLabel()
			if refreshWorldList then
				refreshWorldList(false)
			end
		end)
	end
	updateWorldSelectedLabel()
end

local function addWorldFilterFromInput()
	local raw = UI.worldFilterInput.Text
	if raw == "" then
		UI.worldFilterHint.Text = "Type: Thornshade@1"
		return
	end

	local filters = getSelectedWorldFilters()
	local added = 0
	for _, part in ipairs(splitFilterParts(raw)) do
		local name, prio = parseFilterEntry(part)
		if name ~= nil and prio ~= nil then
			local existingIdx = findWorldFilterIndexByName(name)
			if existingIdx then
				filters[existingIdx].priority = prio
			else
				table.insert(filters, { name = name, priority = prio })
			end
			added = added + 1
		end
	end

	if added > 0 then
		UI.worldFilterInput.Text = ""
		UI.worldFilterHint.Text = ("Added %d pet(s) for this world."):format(added)
		rebuildWorldFilterChips()
		if refreshWorldList then
			refreshWorldList(false)
		end
	else
		UI.worldFilterHint.Text = "Invalid format – use Name@priority (e.g. Thornshade@1)"
	end
end

