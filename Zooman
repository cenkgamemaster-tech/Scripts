-- Scan under this path (same as Escape Pets so both windows see the same objects)
local WORKSPACE_PREFIX = "Workspace.Tsunami"

-- Check if instance has any BillboardGui as descendant
local function hasBillboardGui(inst)
	if not inst or not inst.GetDescendants then return false end
	for _, desc in ipairs(inst:GetDescendants()) do
		if desc:IsA("BillboardGui") then
			return true
		end
	end
	return false
end

-- Get root to scan: e.g. Workspace.Tsunami.Gen; if Gen not found, fallback to Workspace.Tsunami
local function getScanRoot()
	if not WORKSPACE_PREFIX or WORKSPACE_PREFIX == "" then
		return Workspace
	end
	local parts = {}
	for part in string.gmatch(WORKSPACE_PREFIX, "[^.]+") do
		table.insert(parts, part)
	end
	if parts[1] ~= "Workspace" then
		return Workspace
	end
	local node = Workspace
	for i = 2, #parts do
		local nextNode = node and node:FindFirstChild(parts[i])
		if not nextNode then
			break
		end
		node = nextNode
	end
	return node or Workspace
end

-- Get all objects that have a BillboardGui (minimal container) under Workspace.Tsunami only
local function getObjectsWithBillboardGui()
	local root = getScanRoot()
	if not root then
		return {}
	end
	local withGui = {}
	local function scan(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if hasBillboardGui(child) then
				table.insert(withGui, child)
			end
			scan(child)
		end
	end
	pcall(function() scan(root) end)
	-- Keep only minimal containers: drop instance if any of its children is also in the list
	local inList = {}
	for _, inst in ipairs(withGui) do
		inList[inst] = true
	end
	local minimal = {}
	for _, inst in ipairs(withGui) do
		local childInList = false
		for _, c in ipairs(inst:GetChildren()) do
			if inList[c] then
				childInList = true
				break
			end
		end
		if not childInList then
			table.insert(minimal, inst)
		end
	end
	table.sort(minimal, function(a, b)
		return (a:GetFullName() or "") < (b:GetFullName() or "")
	end)
	return minimal
end

-- Get Rarity and Income: try attributes first (TsunamiPetGUI / Part), then same text as Escape Pets details (all BillboardGui text)
local function getRarityAndIncome(inst)
	if not inst or not inst.GetDescendants then return nil, nil end
	local function getAttr(obj, name)
		if not obj then return nil end
		local ok, val = pcall(function()
			return obj.GetAttribute and obj:GetAttribute(name) or nil
		end)
		return ok and val or nil
	end
	local function parseIncome(inc)
		if inc == nil then return nil end
		if type(inc) == "number" then return inc end
		local digits = tostring(inc):gsub("%D", "")
		return digits ~= "" and tonumber(digits) or nil
	end
	local function parseRarity(r)
		if r == nil then return nil end
		return tostring(r):gsub("^%s+", ""):gsub("%s+$", "")
	end
	local attrR, attrInc = nil, nil
	-- 1) Attributes on inst first (Escape Pets shows attributes of clicked instance = Part with TsunamiPetGUI)
	attrR = parseRarity(getAttr(inst, "Rarity"))
	attrInc = parseIncome(getAttr(inst, "Income"))
	-- 2) If missing, try any BillboardGui and its parents (Part.GUI.TsunamiPetGUI)
	if (not attrR or not attrInc) and inst.GetDescendants then
		for _, desc in ipairs(inst:GetDescendants()) do
			if desc:IsA("BillboardGui") then
				local r = getAttr(desc, "Rarity") or (desc.Parent and getAttr(desc.Parent, "Rarity")) or (desc.Parent and desc.Parent.Parent and getAttr(desc.Parent.Parent, "Rarity"))
				local inc = getAttr(desc, "Income") or (desc.Parent and getAttr(desc.Parent, "Income")) or (desc.Parent and desc.Parent.Parent and getAttr(desc.Parent.Parent, "Income"))
				if r then attrR = attrR or parseRarity(r) end
				if inc then attrInc = attrInc or parseIncome(inc) end
				if attrR and attrInc then break end
			end
		end
	end
	-- 2b) Value objects (e.g. StringValue "Rarity", NumberValue "Income") anywhere under inst
	if (not attrR or not attrInc) and inst.GetDescendants then
		for _, desc in ipairs(inst:GetDescendants()) do
			local name = (desc.Name or ""):lower()
			if (name == "rarity") and (desc:IsA("StringValue") or desc:IsA("BinaryStringValue")) and desc.Value then
				attrR = attrR or parseRarity(tostring(desc.Value))
			elseif (name == "income") and (desc:IsA("IntValue") or desc:IsA("NumberValue")) then
				attrInc = attrInc or parseIncome(desc.Value)
			elseif (name == "income") and (desc:IsA("StringValue") or desc:IsA("BinaryStringValue")) and desc.Value then
				attrInc = attrInc or parseIncome(desc.Value)
			end
			if attrR and attrInc then break end
		end
	end
	-- 2) Same source as Escape Pets details: all text from BillboardGuis, parse "Rarity: X" and "$N"
	local allText = {}
	for _, desc in ipairs(inst:GetDescendants()) do
		if desc:IsA("BillboardGui") then
			for _, guiChild in ipairs(desc:GetDescendants()) do
				if guiChild:IsA("TextLabel") or guiChild:IsA("TextButton") or guiChild:IsA("TextBox") then
					local t = guiChild.Text
					if type(t) == "string" and t ~= "" then
						table.insert(allText, t)
					end
				end
			end
		end
	end
	local combined = table.concat(allText, " ")
	local textR = combined:match("Rarity%s*:?%s*([%w]+)")
	if not textR then
		textR = combined:find("Divine", 1, true) and "Divine" or (combined:find("Prismatic", 1, true) and "Prismatic" or nil)
	end
	if textR then textR = textR:gsub("^%s+", ""):gsub("%s+$", "") end
	local textInc = nil
	-- Match $890,832 or 890,832/s or plain numbers
	for part in combined:gmatch("%$?[%d,]+/?%s*[%d]*") do
		local n = tonumber(part:gsub("%D", ""))
		if n and n > 100 and (not textInc or n > textInc) then textInc = n end
	end
	if not textInc then
		for w in combined:gsub("[%d,]+", function(s) return (s:gsub(",", "")) .. " " end):gmatch("%d+") do
			local n = tonumber(w)
			if n and n > 1000 and (not textInc or n > textInc) then textInc = n end
		end
	end
	return attrR or textR, attrInc or textInc
end

-- Play a short notification sound (Roblox asset; parent to Camera so local player hears it)
local NOTIFY_SOUND_ID = "rbxassetid://12222216"
local function playNotificationSound()
	local camera = workspace.CurrentCamera
	if not camera then return end
	local sound = Instance.new("Sound")
	sound.SoundId = NOTIFY_SOUND_ID
	sound.Volume = 1
	sound.RollOffMode = Enum.RollOffMode.Always
	sound.Parent = camera
	sound.Ended:Connect(function()
		sound:Destroy()
	end)
	sound:Play()
end

-- Check for Prismatic (income > 499,999) or Divine (income > 200,000) and notify with sound
local PRISMATIC_INCOME_MIN = 499999
local DIVINE_INCOME_MIN = 50000  -- lowered for testing (production: 200000)
local function checkRarityIncomeTargets()
	local list = getObjectsWithBillboardGui()
	local found = {}
	for _, inst in ipairs(list) do
		local rarity, income = getRarityAndIncome(inst)
		if rarity and income then
			local name = rarity:lower()
			if name:find("prismatic", 1, true) and income > PRISMATIC_INCOME_MIN then
				table.insert(found, { inst = inst, rarity = rarity:gsub("^%s+", ""):gsub("%s+$", ""), income = income })
			elseif name:find("divine", 1, true) and income > DIVINE_INCOME_MIN then
				table.insert(found, { inst = inst, rarity = rarity:gsub("^%s+", ""):gsub("%s+$", ""), income = income })
			end
		end
	end
	if #found > 0 then
		playNotificationSound()
		for _, f in ipairs(found) do
			print(("[Zooman] TARGET: %s | Rarity: %s | Income: %s"):format(f.inst:GetFullName() or "?", f.rarity, tostring(f.income)))
		end
	end
	return found
end

