-- Keywords to identify exclusive pets (Escape mode): name or attribute contains one of these (case-insensitive)
local EXCLUSIVE_KEYWORDS = { "Divine", "Prismatic" }

local function stringContainsAny(str, keywords)
	if type(str) ~= "string" or str == "" then return false end
	local lower = str:lower()
	for _, kw in ipairs(keywords) do
		if lower:find(kw:lower(), 1, true) then
			return true
		end
	end
	return false
end

-- Check if an instance has Divine or Prismatic in its Name or in any attribute value
local function instanceIsExclusivePet(inst)
	if not inst or not inst.GetFullName then return false end
	local name = inst.Name or ""
	if stringContainsAny(name, EXCLUSIVE_KEYWORDS) then
		return true
	end
	local ok, names = pcall(function() return inst:GetAttributeNames() end)
	if ok and names then
		for _, attrName in ipairs(names) do
			local val = inst:GetAttribute(attrName)
			if val ~= nil and stringContainsAny(tostring(val), EXCLUSIVE_KEYWORDS) then
				return true
			end
		end
	end
	return false
end

-- Get all objects (under given parent) that match exclusive pet criteria (Divine / Prismatic)
local function getEscapeExclusivePets()
	local collected = {}
	local function scan(parent)
		for _, child in ipairs(parent:GetChildren()) do
			if instanceIsExclusivePet(child) then
				table.insert(collected, child)
			end
			scan(child)
		end
	end
	-- Scan Workspace, ReplicatedStorage, PlayerGui (same scope as Test's listObjectsInGame)
	pcall(function() scan(Workspace) end)
	pcall(function() scan(ReplicatedStorage) end)
	pcall(function() scan(PlayerGui) end)
	-- Sort by FullName for stable list
	table.sort(collected, function(a, b)
		return (a:GetFullName() or "") < (b:GetFullName() or "")
	end)
	return collected
end

