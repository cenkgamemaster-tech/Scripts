	if notifyRunning then return end
	notifyRunning = true
	openMatchingPetsWindow({})
	notifyThread = task.spawn(function()
		while notifyRunning do
			local found = checkRarityIncomeTargets()
			openMatchingPetsWindow(found)
			for _ = 1, NOTIFY_INTERVAL_SEC do
				if not notifyRunning then break end
				task.wait(1)
			end
		end
	end)
end)

