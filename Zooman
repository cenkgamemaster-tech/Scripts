-- Max descendants to list in details (avoid huge text)
local MAX_DESCENDANTS_IN_DETAILS = 200

-- Get a short detail string for a child (e.g. StringValue -> Value, CS_TsunamiWildPet value)
local function getChildDetail(c)
	local name = c.Name or "?"
	local class = c.ClassName or "?"
	local val = nil
	if c:IsA("StringValue") or c:IsA("BinaryStringValue") then
		val = tostring(c.Value or "")
	elseif c:IsA("IntValue") or c:IsA("NumberValue") or c:IsA("DoubleConstrainedValue") or c:IsA("IntConstrainedValue") then
		val = tostring(c.Value)
	elseif c:IsA("BoolValue") then
		val = tostring(c.Value)
	elseif c:IsA("ObjectValue") then
		val = c.Value and c.Value:GetFullName() or "nil"
	elseif c:IsA("Vector3Value") then
		val = tostring(c.Value)
	elseif c:IsA("Color3Value") then
		val = tostring(c.Value)
	end
	if val ~= nil then
		return ("  %s (%s) = %s"):format(name, class, val)
	end
	return ("  %s (%s)"):format(name, class)
end

-- Build BillboardGui details: each BillboardGui and its text elements
local function getBillboardGuiDetails(inst)
	local lines = {}
	local count = 0
	for _, desc in ipairs(inst:GetDescendants()) do
		if desc:IsA("BillboardGui") then
			count = count + 1
			table.insert(lines, ("  [%d] %s"):format(count, desc:GetFullName() or desc.Name or "?"))
			for _, guiChild in ipairs(desc:GetDescendants()) do
				if guiChild:IsA("TextLabel") or guiChild:IsA("TextButton") or guiChild:IsA("TextBox") then
					local text = guiChild.Text
					local preview = type(text) == "string" and (#text > 60 and (text:sub(1, 57) .. "...") or text) or ""
					table.insert(lines, ("      %s: %s"):format(guiChild.Name or "?", preview))
				end
			end
		end
	end
	if count == 0 then
		return "  (none)"
	end
	return table.concat(lines, "\n")
end

-- Build detail string for an instance: FullName, ClassName, attributes, children (with details), BillboardGui details, descendants
local function getInstanceDetails(inst)
	if not inst or not inst.GetFullName then return "(invalid)" end
	local lines = {}
	table.insert(lines, "FullName: " .. (inst:GetFullName() or "?"))
	table.insert(lines, "ClassName: " .. (inst.ClassName or "?"))
	table.insert(lines, "Name: " .. (inst.Name or "?"))
	-- Attributes
	local ok, names = pcall(function() return inst:GetAttributeNames() end)
	if ok and names and #names > 0 then
		table.insert(lines, "")
		table.insert(lines, "Attributes:")
		for _, attrName in ipairs(names) do
			local val = inst:GetAttribute(attrName)
			table.insert(lines, "  " .. tostring(attrName) .. " = " .. tostring(val))
		end
	end
	-- Children (with details e.g. CS_TsunamiWildPet StringValue value)
	table.insert(lines, "")
	table.insert(lines, "Children:")
	local children = inst:GetChildren()
	if #children == 0 then
		table.insert(lines, "  (none)")
	else
		for _, c in ipairs(children) do
			table.insert(lines, getChildDetail(c))
		end
	end
	-- BillboardGui details
	table.insert(lines, "")
	table.insert(lines, "BillboardGui details:")
	table.insert(lines, getBillboardGuiDetails(inst))
	-- Descendants
	table.insert(lines, "")
	table.insert(lines, "Descendants:")
	local descOk, descList = pcall(function() return inst:GetDescendants() end)
	if not descOk or not descList then
		table.insert(lines, "  (error)")
	else
		table.insert(lines, "  Total: " .. #descList)
		local limit = math.min(#descList, MAX_DESCENDANTS_IN_DETAILS)
		for i = 1, limit do
			local d = descList[i]
			table.insert(lines, "  " .. (d:GetFullName() or d.Name or "?") .. " (" .. (d.ClassName or "?") .. ")")
		end
		if #descList > MAX_DESCENDANTS_IN_DETAILS then
			table.insert(lines, "  ... and " .. (#descList - MAX_DESCENDANTS_IN_DETAILS) .. " more")
		end
	end
	return table.concat(lines, "\n")
end

